<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function brebo_office_core_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface || !str_starts_with($node->bundle(), 'brebo_')) {
    return;
  }

  $labels = [
    'brebo_project' => 'Projectnaam',
    'brebo_cluster' => 'Clusternaam',
    'brebo_dwelling' => 'Woningnaam',
    'brebo_product_position' => 'Productpositie',
  ];
  if (isset($form['title']['widget'][0]['value'], $labels[$node->bundle()])) {
    $form['title']['widget'][0]['value']['#title'] = $labels[$node->bundle()];
  }

  if (isset($form['field_brebo_status']['widget'][0]['value'])) {
    $current = $form['field_brebo_status']['widget'][0]['value']['#default_value'] ?? 'Concept';
    $form['field_brebo_status']['widget'][0]['value'] = [
      '#type' => 'select',
      '#title' => $form['field_brebo_status']['widget']['#title'] ?? 'Status',
      '#default_value' => $current,
      '#options' => [
        'Concept' => 'Concept',
        'Intake' => 'Intake',
        'Voorbereiding' => 'Voorbereiding',
        'In uitvoering' => 'In uitvoering',
        'Oplevering' => 'Oplevering',
        'Afgerond' => 'Afgerond',
        'Vervallen' => 'Vervallen',
      ],
      '#required' => TRUE,
    ];
  }

  if (isset($form['field_brebo_na_reason']['widget'])) {
    $form['field_brebo_na_reason']['widget']['#states'] = [
      'visible' => [
        ':input[name="field_brebo_not_applicable[value]"]' => ['checked' => TRUE],
      ],
    ];
  }

  $form['#validate'][] = 'brebo_office_core_node_form_validate';

  foreach (['promote', 'sticky'] as $technical_field) {
    if (isset($form[$technical_field])) {
      $form[$technical_field]['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function brebo_office_core_preprocess_page(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'brebo_office_core.dashboard'
    || \Drupal::currentUser()->isAnonymous()) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $bundles = [
    'projects' => 'brebo_project',
    'clusters' => 'brebo_cluster',
    'dwellings' => 'brebo_dwelling',
    'positions' => 'brebo_product_position',
  ];

  foreach ($bundles as $key => $bundle) {
    $variables['brebo_counts'][$key] = (int) $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', $bundle)
      ->count()
      ->execute();
  }
}


/**
 * Validates BREBO hierarchy codes and N.V.T. registration.
 */
function brebo_office_core_node_form_validate(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface) {
    return;
  }

  $definitions = [
    'brebo_project' => [
      'code' => 'field_brebo_project_code',
      'parent' => NULL,
    ],
    'brebo_cluster' => [
      'code' => 'field_brebo_cluster_code',
      'parent' => 'field_brebo_project_ref',
    ],
    'brebo_dwelling' => [
      'code' => 'field_brebo_dwelling_code',
      'parent' => 'field_brebo_cluster_ref',
    ],
    'brebo_product_position' => [
      'code' => 'field_brebo_position_code',
      'parent' => 'field_brebo_dwelling_ref',
    ],
  ];
  $definition = $definitions[$node->bundle()] ?? NULL;
  if (!$definition) {
    return;
  }

  $code = trim((string) $form_state->getValue([$definition['code'], 0, 'value']));
  if ($code !== '') {
    $query = \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', $node->bundle())
      ->condition($definition['code'], $code);
    if ($definition['parent']) {
      $parent_id = $form_state->getValue([$definition['parent'], 0, 'target_id']);
      if ($parent_id) {
        $query->condition($definition['parent'] . '.target_id', $parent_id);
      }
    }
    if (!$node->isNew()) {
      $query->condition('nid', $node->id(), '<>');
    }
    if ($query->count()->execute() > 0) {
      $form_state->setErrorByName(
        $definition['code'],
        t('Deze code bestaat al binnen hetzelfde bovenliggende object.'),
      );
    }
  }

  if ($node->bundle() === 'brebo_product_position') {
    $not_applicable = (bool) $form_state->getValue([
      'field_brebo_not_applicable',
      'value',
    ]);
    $reason = trim((string) $form_state->getValue([
      'field_brebo_na_reason',
      0,
      'value',
    ]));
    if ($not_applicable && $reason === '') {
      $form_state->setErrorByName(
        'field_brebo_na_reason',
        t('Vul een reden in wanneer de productpositie niet van toepassing is.'),
      );
    }
  }
}
