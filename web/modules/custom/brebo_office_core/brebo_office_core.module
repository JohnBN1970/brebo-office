<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function brebo_office_core_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface || !str_starts_with($node->bundle(), 'brebo_')) {
    return;
  }

  $labels = [
    'brebo_project' => 'Projectnaam',
    'brebo_cluster' => 'Clusternaam',
    'brebo_dwelling' => 'Woningnaam',
    'brebo_product_position' => 'Productpositie',
    'brebo_verification' => 'Controle',
    'brebo_deviation' => 'Afwijking',
    'brebo_work_package' => 'Werkpakket',
    'brebo_release_gate' => 'Vrijgavepoort',
    'brebo_calculation' => 'Calculatie',
    'brebo_calc_element' => 'Calculatie-element',
    'brebo_calc_line' => 'Calculatieregel',
    'brebo_calc_adjustment' => 'Opslag of correctie',
    'brebo_provisional_sum' => 'Stelpost',
    'brebo_quantity_settlement' => 'Hoeveelheidsverrekening',
    'brebo_work_budget' => 'Werkbegroting',
    'brebo_work_budget_line' => 'Werkbegrotingsregel',
    'brebo_rfq' => 'Prijsaanvraag',
    'brebo_rfq_line' => 'Prijsaanvraagregel',
    'brebo_supplier_quote' => 'Leveranciersofferte',
    'brebo_quote_line' => 'Offerteprijsregel',
    'brebo_budget_change' => 'Budgetwijzigingsbesluit',
  ];
  if (isset($form['title']['widget'][0]['value'], $labels[$node->bundle()])) {
    $form['title']['widget'][0]['value']['#title'] = $labels[$node->bundle()];
  }





  foreach ([
    'field_brebo_project_kind' => [
      'Adviesproject', 'Inspectie/Onderzoek', 'MJOP', 'Projectmanagement',
      'Planmatig onderhoud', 'Renovatie', 'Verduurzaming', 'Uitvoeringsproject', 'Hybride project',
    ],
    'field_brebo_service_role' => ['Advies', 'Regie', 'Eigen uitvoering', 'Hybride'],
    'field_brebo_settlement_method' => ['Honorarium', 'Aanneemsom', 'Eenheidsprijzen', 'Regiewerk', 'Combinatie'],
    'field_brebo_procurement_position' => ['Door BREBO', 'Namens opdrachtgever', 'Door opdrachtgever', 'Per werkpakket'],
    'field_brebo_ceiling_type' => ['Geen plafond', 'Indicatief budget', 'Waarschuwingsgrens', 'Hard plafond'],
  ] as $field_name => $options) {
    if (isset($form[$field_name]['widget'][0]['value'])) {
      $current = $form[$field_name]['widget'][0]['value']['#default_value'] ?? '';
      $select_options = array_combine($options, $options);
      if ($node->bundle() === 'brebo_work_package') {
        $select_options = ['' => '- Projectinstelling overnemen -'] + $select_options;
      }
      $form[$field_name]['widget'][0]['value'] = [
        '#type' => 'select',
        '#title' => $form[$field_name]['widget']['#title'] ?? '',
        '#default_value' => $current,
        '#options' => $select_options,
        '#required' => $node->bundle() === 'brebo_project',
      ];
    }
  }

  if ($node->bundle() === 'brebo_project') {
    $form['brebo_operating_model_intro'] = [
      '#type' => 'container',
      '#weight' => 5,
      '#attributes' => ['class' => ['messages', 'messages--status']],
      'text' => [
        '#markup' => '<strong>Projectbesturing</strong><br>Leg de vier assen afzonderlijk vast. Projectsoort, BREBO-rol, verrekenwijze en inkooppositie worden nooit automatisch uit elkaar afgeleid.',
      ],
    ];

    $project_field_settings = [
      'field_brebo_project_kind' => [10, 'Bepaalt de aard van de opdracht en welke procesroute beschikbaar is.'],
      'field_brebo_service_role' => [11, 'De rol van BREBO: advies, regie, eigen uitvoering of een hybride combinatie.'],
      'field_brebo_settlement_method' => [12, 'De financiële afrekening van de opdracht; onafhankelijk van de BREBO-rol.'],
      'field_brebo_procurement_position' => [13, 'Bepaalt vanuit welke positie goederen en diensten worden ingekocht.'],
      'field_brebo_selector_party' => [20, 'Partij die de leverancier of dienstverlener selecteert.'],
      'field_brebo_contracting_party' => [21, 'Partij die juridisch de opdracht verstrekt.'],
      'field_brebo_cost_bearer' => [22, 'Partij voor wier rekening de inkoop komt.'],
      'field_brebo_invoice_recipient' => [23, 'Partij die de leveranciersfactuur ontvangt.'],
      'field_brebo_procurement_allowed' => [24, 'Ook bij advies en regie kan BREBO binnen het vastgestelde mandaat diensten inkopen.'],
      'field_brebo_mandate_limit' => [25, 'Maximaal bedrag waarbinnen BREBO zonder aanvullend besluit mag handelen.'],
      'field_brebo_ceiling_type' => [30, 'Kies geen plafond, een indicatief budget, een waarschuwingsgrens of een hard plafond.'],
      'field_brebo_ceiling_amount' => [31, 'Het bij het gekozen plafondtype behorende bedrag.'],
      'field_brebo_disciplines' => [40, 'Disciplines waarop deze projectafspraak betrekking heeft.'],
    ];
    foreach ($project_field_settings as $field_name => [$weight, $description]) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#weight'] = $weight;
        $form[$field_name]['#description'] = $description;
      }
    }

    if (isset($form['field_brebo_ceiling_amount']['widget'][0]['value'])) {
      $form['field_brebo_ceiling_amount']['widget'][0]['value']['#states'] = [
        'visible' => [
          ':input[name="field_brebo_ceiling_type[0][value]"]' => ['!value' => 'Geen plafond'],
        ],
        'required' => [
          ':input[name="field_brebo_ceiling_type[0][value]"]' => ['!value' => 'Geen plafond'],
        ],
      ];
    }
  }

  if ($node->bundle() === 'brebo_work_package') {
    $form['brebo_inheritance_intro'] = [
      '#type' => 'container',
      '#weight' => 5,
      '#attributes' => ['class' => ['messages', 'messages--warning']],
      'text' => [
        '#markup' => '<strong>Overerving vanuit project</strong><br>Laat een besturingsveld leeg om de projectinstelling over te nemen. Kies alleen een afwijkende waarde wanneer dit werkpakket aantoonbaar anders wordt bestuurd.',
      ],
    ];
    foreach ([
      'field_brebo_service_role',
      'field_brebo_settlement_method',
      'field_brebo_procurement_position',
      'field_brebo_selector_party',
      'field_brebo_contracting_party',
      'field_brebo_cost_bearer',
      'field_brebo_invoice_recipient',
      'field_brebo_procurement_allowed',
      'field_brebo_mandate_limit',
      'field_brebo_ceiling_type',
      'field_brebo_ceiling_amount',
    ] as $field_name) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#description'] = 'Leeg laten betekent: projectinstelling overnemen.';
      }
    }
  }

  if ($node->bundle() === 'brebo_budget_change' && isset($form['field_brebo_new_amount'])) {
    $form['field_brebo_new_amount']['#access'] = FALSE;
  }

  if ($node->bundle() === 'brebo_calculation') {
    if (isset($form['field_brebo_price_date']['widget'][0]['value'])) {
      $form['field_brebo_price_date']['widget'][0]['value']['#type'] = 'date';
    }
    if (isset($form['field_brebo_calc_status']['widget'][0]['value'])) {
      $current = $form['field_brebo_calc_status']['widget'][0]['value']['#default_value'] ?? 'Concept';
      $form['field_brebo_calc_status']['widget'][0]['value'] = [
        '#type' => 'select', '#title' => 'Calculatiestatus', '#default_value' => $current,
        '#options' => array_combine(
          ['Concept', 'Ter beoordeling', 'Vastgesteld', 'Definitief budget', 'Vervallen'],
          ['Concept', 'Ter beoordeling', 'Vastgesteld', 'Definitief budget', 'Vervallen'],
        ), '#required' => TRUE,
      ];
    }
  }

  if ($node->bundle() === 'brebo_calc_line') {
    foreach ([
      'field_brebo_line_post_type' => ['Vaste post', 'Stelpost', 'Verrekenpost', 'Optie', 'Alternatief', 'Meer-/minderwerk'],
      'field_brebo_cost_category' => ['Arbeid', 'Materiaal', 'Materieel', 'Onderaanneming', 'Overig'],
    ] as $field_name => $options) {
      if (isset($form[$field_name]['widget'][0]['value'])) {
        $current = $form[$field_name]['widget'][0]['value']['#default_value'] ?? reset($options);
        $form[$field_name]['widget'][0]['value'] = [
          '#type' => 'select', '#title' => $form[$field_name]['widget']['#title'] ?? '',
          '#default_value' => $current, '#options' => array_combine($options, $options), '#required' => TRUE,
        ];
      }
    }
    foreach (['field_brebo_direct_cost', 'field_brebo_budget_hours'] as $calculated_field) {
      if (isset($form[$calculated_field])) {
        $form[$calculated_field]['#access'] = FALSE;
      }
    }
  }

  if ($node->bundle() === 'brebo_quantity_settlement') {
    foreach (['field_brebo_quantity_delta', 'field_brebo_settlement_amount'] as $calculated_field) {
      if (isset($form[$calculated_field])) {
        $form[$calculated_field]['#access'] = FALSE;
      }
    }
  }

  if ($node->bundle() === 'brebo_provisional_sum' && isset($form['field_brebo_settle_difference'])) {
    $form['field_brebo_settle_difference']['#access'] = FALSE;
  }

  if ($node->bundle() === 'brebo_quote_line' && isset($form['field_brebo_quoted_total'])) {
    $form['field_brebo_quoted_total']['#access'] = FALSE;
  }

  if ($node->bundle() === 'brebo_work_budget_line') {
    foreach (['field_brebo_gross_quantity', 'field_brebo_package_count'] as $calculated_field) {
      if (isset($form[$calculated_field])) {
        $form[$calculated_field]['#access'] = FALSE;
      }
    }
  }

  if ($node->bundle() === 'brebo_calc_adjustment') {
    if ($node->isNew()) {
      $target_id = (int) \Drupal::request()->query->get('target', 0);
      $target = $target_id > 0
        ? \Drupal::entityTypeManager()->getStorage('node')->load($target_id)
        : NULL;
      if ($target instanceof NodeInterface
        && in_array($target->bundle(), ['brebo_calculation', 'brebo_calc_element', 'brebo_calc_line', 'brebo_work_package'], TRUE)
        && $target->access('view')
        && isset($form['field_brebo_adjust_target']['widget'][0]['target_id'])) {
        $form['field_brebo_adjust_target']['widget'][0]['target_id']['#default_value'] = $target;
      }
    }

    foreach ([
      'field_brebo_adjust_method' => ['Percentage', 'Vast bedrag'],
      'field_brebo_adjust_direction' => ['Opslag', 'Korting'],
      'field_brebo_adjust_base' => ['Alle directe kosten', 'Arbeid', 'Materiaal', 'Materieel', 'Onderaanneming', 'Overig'],
    ] as $field_name => $options) {
      if (isset($form[$field_name]['widget'][0]['value'])) {
        $current = $form[$field_name]['widget'][0]['value']['#default_value'] ?? reset($options);
        $form[$field_name]['widget'][0]['value'] = [
          '#type' => 'select', '#title' => $form[$field_name]['widget']['#title'] ?? '',
          '#default_value' => $current, '#options' => array_combine($options, $options), '#required' => TRUE,
        ];
      }
    }
  }

  if ($node->bundle() === 'brebo_work_package') {
    if (isset($form['field_brebo_package_status']['widget'][0]['value'])) {
      $current = $form['field_brebo_package_status']['widget'][0]['value']['#default_value'] ?? 'Concept';
      $form['field_brebo_package_status']['widget'][0]['value'] = [
        '#type' => 'select', '#title' => 'Werkpakketstatus', '#default_value' => $current,
        '#options' => [
          'Concept' => 'Concept',
          'Voorbereiding' => 'Voorbereiding',
          'Vrijgave geblokkeerd' => 'Vrijgave geblokkeerd',
          'Vrijgegeven' => 'Vrijgegeven',
          'In uitvoering' => 'In uitvoering',
          'Gereed' => 'Gereed',
          'Afgesloten' => 'Afgesloten',
        ], '#required' => TRUE,
      ];
    }
    foreach (['field_brebo_planned_start', 'field_brebo_planned_end'] as $date_field) {
      if (isset($form[$date_field]['widget'][0]['value'])) {
        $form[$date_field]['widget'][0]['value']['#type'] = 'date';
      }
    }
  }


  if ($node->bundle() === 'brebo_release_gate') {
    if ($node->isNew()) {
      $node->setTitle('Nieuwe vrijgavepoort');
    }
    if (isset($form['title'])) {
      $form['title']['#access'] = FALSE;
    }

    if ($node->isNew()) {
      $package_id = (int) \Drupal::request()->query->get('package', 0);
      $package = $package_id > 0
        ? \Drupal::entityTypeManager()->getStorage('node')->load($package_id)
        : NULL;
      if ($package instanceof NodeInterface
        && $package->bundle() === 'brebo_work_package'
        && $package->access('view')
        && isset($form['field_brebo_package_ref']['widget'][0]['target_id'])) {
        $form['field_brebo_package_ref']['widget'][0]['target_id']['#default_value'] = $package;
      }
    }

    if (isset($form['field_brebo_gate_type']['widget'][0]['value'])) {
      $current_type = $form['field_brebo_gate_type']['widget'][0]['value']['#default_value'] ?? 'Documenten';
      $form['field_brebo_gate_type']['widget'][0]['value'] = [
        '#type' => 'select', '#title' => 'Poorttype', '#default_value' => $current_type,
        '#options' => array_combine(
          ['Documenten', 'Calculatie', 'Financiën', 'Veiligheid', 'Kwaliteit', 'Planning', 'Inkoop'],
          ['Documenten', 'Calculatie', 'Financiën', 'Veiligheid', 'Kwaliteit', 'Planning', 'Inkoop'],
        ), '#required' => TRUE,
      ];
    }
    if (isset($form['field_brebo_gate_result']['widget'][0]['value'])) {
      $current_result = $form['field_brebo_gate_result']['widget'][0]['value']['#default_value'] ?? 'Niet beoordeeld';
      $form['field_brebo_gate_result']['widget'][0]['value'] = [
        '#type' => 'select', '#title' => 'Poortresultaat', '#default_value' => $current_result,
        '#options' => [
          'Niet beoordeeld' => 'Niet beoordeeld', 'Akkoord' => 'Akkoord',
          'Afwijking' => 'Afwijking', 'N.V.T.' => 'N.V.T.',
        ], '#required' => TRUE,
      ];
    }
    if (isset($form['field_brebo_gate_blocks'])) {
      $form['field_brebo_gate_blocks']['#access'] = FALSE;
    }
  }

  if ($node->bundle() === 'brebo_deviation') {
    if ($node->isNew()) {
      $node->setTitle('Nieuwe afwijking');
    }
    if (isset($form['title'])) {
      $form['title']['#access'] = FALSE;
    }

    $control_id = (int) \Drupal::request()->query->get('control', 0);
    $control = $control_id > 0
      ? \Drupal::entityTypeManager()->getStorage('node')->load($control_id)
      : NULL;
    if ($node->isNew()
      && $control instanceof NodeInterface
      && $control->bundle() === 'brebo_verification'
      && $control->access('view')
      && isset($form['field_brebo_control_ref']['widget'][0]['target_id'])) {
      $form['field_brebo_control_ref']['widget'][0]['target_id']['#default_value'] = $control;
    }

    if (isset($form['field_brebo_deviation_status']['widget'][0]['value'])) {
      $current_status = $form['field_brebo_deviation_status']['widget'][0]['value']['#default_value'] ?? 'Open';
      $form['field_brebo_deviation_status']['widget'][0]['value'] = [
        '#type' => 'select',
        '#title' => 'Afwijkingsstatus',
        '#default_value' => $current_status,
        '#options' => [
          'Open' => 'Open',
          'In behandeling' => 'In behandeling',
          'Gereed voor hercontrole' => 'Gereed voor hercontrole',
          'Gesloten' => 'Gesloten',
        ],
        '#required' => TRUE,
      ];
    }
    if (isset($form['field_brebo_due_date']['widget'][0]['value'])) {
      $form['field_brebo_due_date']['widget'][0]['value']['#type'] = 'date';
    }
    if (isset($form['field_brebo_recheck_ref']['widget'])) {
      $form['field_brebo_recheck_ref']['widget']['#states'] = [
        'visible' => [
          ':input[name="field_brebo_deviation_status[0][value]"]' => ['value' => 'Gesloten'],
        ],
      ];
    }
  }

  if ($node->bundle() === 'brebo_verification') {
    if ($node->isNew()) {
      $node->setTitle('Nieuwe controle');
    }
    if (isset($form['title'])) {
      $form['title']['#access'] = FALSE;
    }

    if ($node->isNew()) {
      $position_id = (int) \Drupal::request()->query->get('position', 0);
      $position = $position_id > 0
        ? \Drupal::entityTypeManager()->getStorage('node')->load($position_id)
        : NULL;
      if ($position instanceof NodeInterface
        && $position->bundle() === 'brebo_product_position'
        && $position->access('view')
        && isset($form['field_brebo_position_ref']['widget'][0]['target_id'])) {
        $form['field_brebo_position_ref']['widget'][0]['target_id']['#default_value'] = $position;
      }
    }

    if (isset($form['field_brebo_control_type']['widget'][0]['value'])) {
      $current_type = $form['field_brebo_control_type']['widget'][0]['value']['#default_value'] ?? 'Documentcontrole';
      $form['field_brebo_control_type']['widget'][0]['value'] = [
        '#type' => 'select',
        '#title' => 'Controletype',
        '#default_value' => $current_type,
        '#options' => [
          'Documentcontrole' => 'Documentcontrole',
          'Uitvoeringscontrole' => 'Uitvoeringscontrole',
          'Oplevercontrole' => 'Oplevercontrole',
        ],
        '#required' => TRUE,
      ];
    }

    if (isset($form['field_brebo_control_result']['widget'][0]['value'])) {
      $current_result = $form['field_brebo_control_result']['widget'][0]['value']['#default_value'] ?? 'Niet gecontroleerd';
      $form['field_brebo_control_result']['widget'][0]['value'] = [
        '#type' => 'select',
        '#title' => 'Controleresultaat',
        '#default_value' => $current_result,
        '#options' => [
          'Niet gecontroleerd' => 'Niet gecontroleerd',
          'Akkoord' => 'Akkoord',
          'Afwijking' => 'Afwijking',
          'N.V.T.' => 'N.V.T.',
        ],
        '#required' => TRUE,
      ];
    }

    if (isset($form['field_brebo_required_action']['widget'])) {
      $form['field_brebo_required_action']['widget']['#states'] = [
        'visible' => [
          ':input[name="field_brebo_control_result[0][value]"]' => ['value' => 'Afwijking'],
        ],
      ];
    }
    if (isset($form['field_brebo_blocks_release'])) {
      $form['field_brebo_blocks_release']['#access'] = FALSE;
    }
  }

  if (isset($form['field_brebo_status']['widget'][0]['value'])) {
    $current = $form['field_brebo_status']['widget'][0]['value']['#default_value'] ?? 'Concept';
    $form['field_brebo_status']['widget'][0]['value'] = [
      '#type' => 'select',
      '#title' => $form['field_brebo_status']['widget']['#title'] ?? 'Status',
      '#default_value' => $current,
      '#options' => [
        'Concept' => 'Concept',
        'Intake' => 'Intake',
        'Voorbereiding' => 'Voorbereiding',
        'In uitvoering' => 'In uitvoering',
        'Oplevering' => 'Oplevering',
        'Afgerond' => 'Afgerond',
        'Vervallen' => 'Vervallen',
      ],
      '#required' => TRUE,
    ];
  }

  if (isset($form['field_brebo_na_reason']['widget'])) {
    $form['field_brebo_na_reason']['widget']['#states'] = [
      'visible' => [
        ':input[name="field_brebo_not_applicable[value]"]' => ['checked' => TRUE],
      ],
    ];
  }

  $form['#validate'][] = 'brebo_office_core_node_form_validate';

  foreach (['promote', 'sticky'] as $technical_field) {
    if (isset($form[$technical_field])) {
      $form[$technical_field]['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function brebo_office_core_preprocess_page(array &$variables): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'brebo_office_core.dashboard'
    || \Drupal::currentUser()->isAnonymous()) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $bundles = [
    'projects' => 'brebo_project',
    'clusters' => 'brebo_cluster',
    'dwellings' => 'brebo_dwelling',
    'positions' => 'brebo_product_position',
  ];

  foreach ($bundles as $key => $bundle) {
    $variables['brebo_counts'][$key] = (int) $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', $bundle)
      ->count()
      ->execute();
  }
}


/**
 * Validates BREBO hierarchy codes and N.V.T. registration.
 */
function brebo_office_core_node_form_validate(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface) {
    return;
  }

  if ($node->bundle() === 'brebo_calc_line') {
    $quantity = (float) $form_state->getValue(['field_brebo_contract_quantity', 0, 'value']);
    $unit_price = (float) $form_state->getValue(['field_brebo_unit_price', 0, 'value']);
    if ($quantity < 0) {
      $form_state->setErrorByName('field_brebo_contract_quantity', t('De contracthoeveelheid mag niet negatief zijn.'));
    }
    if ($unit_price < 0) {
      $form_state->setErrorByName('field_brebo_unit_price', t('De eenheidsprijs mag niet negatief zijn.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_quantity_settlement') {
    $line_id = (int) $form_state->getValue(['field_brebo_calc_line_ref', 0, 'target_id']);
    $line = $line_id > 0 ? \Drupal::entityTypeManager()->getStorage('node')->load($line_id) : NULL;
    if (!$line instanceof NodeInterface || $line->bundle() !== 'brebo_calc_line'
      || (string) $line->get('field_brebo_line_post_type')->value !== 'Verrekenpost') {
      $form_state->setErrorByName('field_brebo_calc_line_ref', t('Selecteer een calculatieregel van het type Verrekenpost.'));
    }
    $status = (string) $form_state->getValue(['field_brebo_settlement_status', 0, 'value']);
    $approved = $form_state->getValue(['field_brebo_approved_quantity', 0, 'value']);
    if ($status === 'Akkoord' && ($approved === NULL || $approved === '')) {
      $form_state->setErrorByName('field_brebo_approved_quantity', t('Een akkoord bevonden verrekening vereist een goedgekeurde hoeveelheid.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_provisional_sum') {
    $status = (string) $form_state->getValue(['field_brebo_provisional_status', 0, 'value']);
    $final_sales = $form_state->getValue(['field_brebo_final_sales', 0, 'value']);
    if ($status === 'Afgerekend' && ($final_sales === NULL || $final_sales === '')) {
      $form_state->setErrorByName('field_brebo_final_sales', t('Vul de definitieve verkoopwaarde in voordat de stelpost wordt afgerekend.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_work_budget_line') {
    $net = (float) $form_state->getValue(['field_brebo_material_quantity', 0, 'value']);
    $waste = (float) $form_state->getValue(['field_brebo_waste_percent', 0, 'value']);
    $pack = (float) $form_state->getValue(['field_brebo_pack_quantity', 0, 'value']);
    if ($net < 0 || $waste < 0 || $pack < 0) {
      $form_state->setErrorByName('field_brebo_material_quantity', t('Materiaalhoeveelheid, verlies en verpakkingshoeveelheid mogen niet negatief zijn.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_quote_line') {
    $quantity = (float) $form_state->getValue(['field_brebo_quoted_quantity', 0, 'value']);
    $price = (float) $form_state->getValue(['field_brebo_quoted_unit_price', 0, 'value']);
    if ($quantity < 0 || $price < 0) {
      $form_state->setErrorByName('field_brebo_quoted_quantity', t('Geoffreerde hoeveelheid en eenheidsprijs mogen niet negatief zijn.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_supplier_quote') {
    $selected = (bool) $form_state->getValue(['field_brebo_quote_selected', 'value']);
    $reason = trim((string) $form_state->getValue(['field_brebo_choice_reason', 0, 'value']));
    if ($selected && $reason === '') {
      $form_state->setErrorByName('field_brebo_choice_reason', t('Een geselecteerde aanbieding vereist een gemotiveerd selectiebesluit.'));
    }
    return;
  }

  if (in_array($node->bundle(), ['brebo_project', 'brebo_work_package'], TRUE)) {
    $ceiling_type = (string) $form_state->getValue(['field_brebo_ceiling_type', 0, 'value']);
    $ceiling = $form_state->getValue(['field_brebo_ceiling_amount', 0, 'value']);
    $mandate = $form_state->getValue(['field_brebo_mandate_limit', 0, 'value']);
    if ($ceiling_type !== '' && $ceiling_type !== 'Geen plafond' && ($ceiling === NULL || $ceiling === '' || (float) $ceiling <= 0)) {
      $form_state->setErrorByName('field_brebo_ceiling_amount', t('Vul bij dit plafondtype een positief grensbedrag in.'));
    }
    if ($mandate !== NULL && $mandate !== '' && (float) $mandate < 0) {
      $form_state->setErrorByName('field_brebo_mandate_limit', t('Het mandaatbedrag mag niet negatief zijn.'));
    }
  }

  if ($node->bundle() === 'brebo_budget_change') {
    $change = (float) $form_state->getValue(['field_brebo_change_amount', 0, 'value']);
    if ($change == 0.0) {
      $form_state->setErrorByName('field_brebo_change_amount', t('Een budgetwijziging mag niet nul zijn.'));
    }
    return;
  }

  if ($node->bundle() === 'brebo_calc_adjustment') {
    $value = (float) $form_state->getValue(['field_brebo_adjust_value', 0, 'value']);
    if ($value < 0) {
      $form_state->setErrorByName('field_brebo_adjust_value', t('Gebruik Richting voor opslag of korting; de waarde zelf moet positief zijn.'));
    }
    return;
  }


  $definitions = [
    'brebo_project' => [
      'code' => 'field_brebo_project_code',
      'parent' => NULL,
    ],
    'brebo_cluster' => [
      'code' => 'field_brebo_cluster_code',
      'parent' => 'field_brebo_project_ref',
    ],
    'brebo_dwelling' => [
      'code' => 'field_brebo_dwelling_code',
      'parent' => 'field_brebo_cluster_ref',
    ],
    'brebo_product_position' => [
      'code' => 'field_brebo_position_code',
      'parent' => 'field_brebo_dwelling_ref',
    ],
  ];

  if ($node->bundle() === 'brebo_release_gate') {
    $applicable = (bool) $form_state->getValue(['field_brebo_gate_applicable', 'value']);
    $result = (string) $form_state->getValue(['field_brebo_gate_result', 0, 'value']);
    $assessment = trim((string) $form_state->getValue(['field_brebo_gate_assessment', 0, 'value']));
    if ((!$applicable || in_array($result, ['Afwijking', 'N.V.T.'], TRUE)) && $assessment === '') {
      $form_state->setErrorByName(
        'field_brebo_gate_assessment',
        t('Onderbouw een afwijking of N.V.T.-besluit aantoonbaar.'),
      );
    }
    return;
  }

  if ($node->bundle() === 'brebo_work_package') {
    $status = (string) $form_state->getValue(['field_brebo_package_status', 0, 'value']);
    if ($status === 'Vrijgegeven' && !$node->isNew()) {
      $blocking = \Drupal::entityQuery('node')
        ->accessCheck(FALSE)
        ->condition('type', 'brebo_release_gate')
        ->condition('field_brebo_package_ref.target_id', $node->id())
        ->condition('field_brebo_gate_blocks', 1)
        ->count()
        ->execute();
      $gate_count = \Drupal::entityQuery('node')
        ->accessCheck(FALSE)
        ->condition('type', 'brebo_release_gate')
        ->condition('field_brebo_package_ref.target_id', $node->id())
        ->count()
        ->execute();
      if ($gate_count === 0 || $blocking > 0) {
        $form_state->setErrorByName(
          'field_brebo_package_status',
          t('Vrijgave is pas mogelijk wanneer alle toepasselijke vrijgavepoorten akkoord of gemotiveerd N.V.T. zijn.'),
        );
      }
    }
    return;
  }

  if ($node->bundle() === 'brebo_deviation') {
    $status = (string) $form_state->getValue(['field_brebo_deviation_status', 0, 'value']);
    $recheck_id = (int) $form_state->getValue(['field_brebo_recheck_ref', 0, 'target_id']);
    if ($status === 'Gesloten') {
      $recheck = $recheck_id > 0
        ? \Drupal::entityTypeManager()->getStorage('node')->load($recheck_id)
        : NULL;
      if (!$recheck instanceof NodeInterface
        || $recheck->bundle() !== 'brebo_verification'
        || (string) $recheck->get('field_brebo_control_result')->value !== 'Akkoord') {
        $form_state->setErrorByName(
          'field_brebo_recheck_ref',
          t('Een afwijking kan alleen worden gesloten met een hercontrole waarvan het resultaat Akkoord is.'),
        );
      }
    }
    return;
  }

  if ($node->bundle() === 'brebo_verification') {
    $type = (string) $form_state->getValue(['field_brebo_control_type', 0, 'value']);
    $source = trim((string) $form_state->getValue(['field_brebo_control_source', 0, 'value']));
    $result = (string) $form_state->getValue(['field_brebo_control_result', 0, 'value']);
    $finding = trim((string) $form_state->getValue(['field_brebo_finding', 0, 'value']));
    $action = trim((string) $form_state->getValue(['field_brebo_required_action', 0, 'value']));

    if ($type === 'Documentcontrole' && $source === '') {
      $form_state->setErrorByName(
        'field_brebo_control_source',
        t('Vul bij een documentcontrole de gecontroleerde bron en versie in.'),
      );
    }
    if ($result === 'Afwijking' && $finding === '') {
      $form_state->setErrorByName(
        'field_brebo_finding',
        t('Beschrijf de geconstateerde afwijking.'),
      );
    }
    if ($result === 'Afwijking' && $action === '') {
      $form_state->setErrorByName(
        'field_brebo_required_action',
        t('Leg de vereiste vervolgactie vast voordat u de afwijking opslaat.'),
      );
    }
    return;
  }

  $definition = $definitions[$node->bundle()] ?? NULL;
  if (!$definition) {
    return;
  }

  $code = trim((string) $form_state->getValue([$definition['code'], 0, 'value']));
  if ($code !== '') {
    $query = \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', $node->bundle())
      ->condition($definition['code'], $code);
    if ($definition['parent']) {
      $parent_id = $form_state->getValue([$definition['parent'], 0, 'target_id']);
      if ($parent_id) {
        $query->condition($definition['parent'] . '.target_id', $parent_id);
      }
    }
    if (!$node->isNew()) {
      $query->condition('nid', $node->id(), '<>');
    }
    if ($query->count()->execute() > 0) {
      $form_state->setErrorByName(
        $definition['code'],
        t('Deze code bestaat al binnen hetzelfde bovenliggende object.'),
      );
    }
  }

  if ($node->bundle() === 'brebo_product_position') {
    $not_applicable = (bool) $form_state->getValue([
      'field_brebo_not_applicable',
      'value',
    ]);
    $reason = trim((string) $form_state->getValue([
      'field_brebo_na_reason',
      0,
      'value',
    ]));
    if ($not_applicable && $reason === '') {
      $form_state->setErrorByName(
        'field_brebo_na_reason',
        t('Vul een reden in wanneer de productpositie niet van toepassing is.'),
      );
    }
  }
}


/**
 * Implements hook_node_presave().
 */
function brebo_office_core_node_presave(NodeInterface $node): void {
  if ($node->bundle() === 'brebo_calc_line') {
    $quantity = (float) $node->get('field_brebo_contract_quantity')->value;
    $unit_price = (float) $node->get('field_brebo_unit_price')->value;
    $norm_hours = $node->hasField('field_brebo_norm_hours')
      ? (float) $node->get('field_brebo_norm_hours')->value
      : 0.0;
    $node->set('field_brebo_direct_cost', number_format($quantity * $unit_price, 4, '.', ''));
    if ($node->hasField('field_brebo_budget_hours')) {
      $node->set('field_brebo_budget_hours', number_format($quantity * $norm_hours, 4, '.', ''));
    }
    return;
  }

  if ($node->bundle() === 'brebo_quantity_settlement') {
    $line = $node->get('field_brebo_calc_line_ref')->entity;
    $contract_quantity = $line instanceof NodeInterface
      ? (float) $line->get('field_brebo_contract_quantity')->value
      : 0.0;
    $approved_value = $node->get('field_brebo_approved_quantity')->value;
    $quantity = ($approved_value !== NULL && $approved_value !== '')
      ? (float) $approved_value
      : (float) $node->get('field_brebo_measured_quantity')->value;
    $rate = (float) $node->get('field_brebo_settlement_rate')->value;
    $delta = $quantity - $contract_quantity;
    $node->set('field_brebo_quantity_delta', number_format($delta, 4, '.', ''));
    $node->set('field_brebo_settlement_amount', number_format($delta * $rate, 4, '.', ''));
    $node->setTitle('Verrekening — ' . ($line instanceof NodeInterface ? $line->label() : 'calculatieregel'));
    return;
  }

  if ($node->bundle() === 'brebo_provisional_sum') {
    $line = $node->get('field_brebo_calc_line_ref')->entity;
    $node->setTitle('Stelpost — ' . ($line instanceof NodeInterface ? $line->label() : 'calculatieregel'));
    if ($node->hasField('field_brebo_settle_difference')) {
      $budget = (float) $node->get('field_brebo_budget_amount')->value;
      $final = $node->get('field_brebo_final_sales')->value;
      $node->set('field_brebo_settle_difference', ($final === NULL || $final === '')
        ? NULL
        : number_format((float) $final - $budget, 4, '.', ''));
    }
    return;
  }

  if ($node->bundle() === 'brebo_work_budget_line') {
    $net = (float) $node->get('field_brebo_material_quantity')->value;
    $waste = (float) $node->get('field_brebo_waste_percent')->value;
    $pack = (float) $node->get('field_brebo_pack_quantity')->value;
    $gross = $net * (1 + ($waste / 100));
    $node->set('field_brebo_gross_quantity', number_format($gross, 4, '.', ''));
    $node->set('field_brebo_package_count', $pack > 0 ? (int) ceil($gross / $pack) : NULL);
    return;
  }

  if ($node->bundle() === 'brebo_quote_line') {
    $quantity = (float) $node->get('field_brebo_quoted_quantity')->value;
    $price = (float) $node->get('field_brebo_quoted_unit_price')->value;
    $node->set('field_brebo_quoted_total', number_format($quantity * $price, 4, '.', ''));
    $request_line = $node->get('field_brebo_rfq_line_ref')->entity;
    $node->setTitle('Prijsregel — ' . ($request_line instanceof NodeInterface ? $request_line->label() : 'aanvraagregel'));
    return;
  }

  if ($node->bundle() === 'brebo_supplier_quote') {
    $supplier = (string) $node->get('field_brebo_supplier_name')->value;
    $number = (string) $node->get('field_brebo_quote_number')->value;
    $node->setTitle(trim($supplier . ($number !== '' ? ' — ' . $number : '')));
    return;
  }

  if ($node->bundle() === 'brebo_rfq') {
    $code = (string) $node->get('field_brebo_rfq_code')->value;
    $node->setTitle('Prijsaanvraag ' . $code);
    return;
  }

  if ($node->bundle() === 'brebo_budget_change') {
    $original = (float) $node->get('field_brebo_original_amount')->value;
    $change = (float) $node->get('field_brebo_change_amount')->value;
    $node->set('field_brebo_new_amount', number_format($original + $change, 4, '.', ''));
    $project = $node->get('field_brebo_project_ref')->entity;
    $node->setTitle((string) $node->get('field_brebo_change_type')->value . ' — ' . ($project instanceof NodeInterface ? $project->label() : 'project'));
    return;
  }

  if ($node->bundle() === 'brebo_calc_adjustment') {
    $target = $node->get('field_brebo_adjust_target')->entity;
    $direction = (string) $node->get('field_brebo_adjust_direction')->value;
    $node->setTitle($direction . ' — ' . ($target instanceof NodeInterface ? $target->label() : 'calculatiedoel'));
    return;
  }

  if ($node->bundle() === 'brebo_release_gate') {
    $type = (string) $node->get('field_brebo_gate_type')->value;
    $package = $node->get('field_brebo_package_ref')->entity;
    $node->setTitle($type . ' — ' . ($package instanceof NodeInterface ? $package->label() : 'werkpakket'));
    $applicable = (bool) $node->get('field_brebo_gate_applicable')->value;
    $result = (string) $node->get('field_brebo_gate_result')->value;
    $blocks = $applicable && !in_array($result, ['Akkoord', 'N.V.T.'], TRUE);
    $node->set('field_brebo_gate_blocks', $blocks ? 1 : 0);
    return;
  }

  if ($node->bundle() === 'brebo_deviation') {
    $control = $node->get('field_brebo_control_ref')->entity;
    $control_label = $control instanceof NodeInterface ? $control->label() : 'controle';
    $node->setTitle('Afwijking — ' . $control_label);
    return;
  }

  if ($node->bundle() !== 'brebo_verification') {
    return;
  }

  $type = $node->get('field_brebo_control_type')->value ?: 'Controle';
  $position = $node->get('field_brebo_position_ref')->entity;
  $position_label = $position instanceof NodeInterface ? $position->label() : 'productpositie';
  $node->setTitle($type . ' — ' . $position_label);

  $result = (string) $node->get('field_brebo_control_result')->value;
  $blocks_release = $result === 'Afwijking';

  if ($blocks_release && !$node->isNew()) {
    $deviation_query = \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', 'brebo_deviation')
      ->condition('field_brebo_control_ref.target_id', $node->id());
    $deviation_count = (int) (clone $deviation_query)->count()->execute();
    if ($deviation_count > 0) {
      $open_count = (int) $deviation_query
        ->condition('field_brebo_deviation_status', 'Gesloten', '<>')
        ->count()
        ->execute();
      $blocks_release = $open_count > 0;
    }
  }

  $node->set('field_brebo_blocks_release', $blocks_release ? 1 : 0);
}


/**
 * Implements hook_node_insert().
 */
function brebo_office_core_node_insert(NodeInterface $node): void {
  _brebo_office_core_sync_deviation_block($node);
  _brebo_office_core_sync_quantity_settlement($node);
  _brebo_office_core_sync_material_source($node);
}

/**
 * Implements hook_node_update().
 */
function brebo_office_core_node_update(NodeInterface $node): void {
  _brebo_office_core_sync_deviation_block($node);
  _brebo_office_core_sync_quantity_settlement($node);
  _brebo_office_core_sync_material_source($node);
}

/**
 * Synchronizes release blocking after a deviation changes.
 */
function _brebo_office_core_sync_deviation_block(NodeInterface $node): void {
  if ($node->bundle() !== 'brebo_deviation') {
    return;
  }

  $control = $node->get('field_brebo_control_ref')->entity;
  if (!$control instanceof NodeInterface) {
    return;
  }

  $open = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_deviation')
    ->condition('field_brebo_control_ref.target_id', $control->id())
    ->condition('field_brebo_deviation_status', 'Gesloten', '<>')
    ->count()
    ->execute();

  $control->set('field_brebo_blocks_release', $open > 0 ? 1 : 0);
  $control->save();
}


/**
 * Synchronizes an approved quantity settlement to its calculation line.
 */
function _brebo_office_core_sync_quantity_settlement(NodeInterface $node): void {
  if ($node->bundle() !== 'brebo_quantity_settlement'
    || (string) $node->get('field_brebo_settlement_status')->value !== 'Akkoord') {
    return;
  }

  $line = $node->get('field_brebo_calc_line_ref')->entity;
  $approved = $node->get('field_brebo_approved_quantity')->value;
  if (!$line instanceof NodeInterface
    || $line->bundle() !== 'brebo_calc_line'
    || $approved === NULL
    || $approved === '') {
    return;
  }

  $line->set('field_brebo_actual_quantity', $approved);
  $line->setNewRevision(TRUE);
  $line->setRevisionLogMessage('Goedgekeurde hoeveelheid overgenomen uit verrekening ' . $node->id() . '.');
  $line->save();
}


/**
 * Synchronizes coded calculation materials to existing work-budget lines.
 */
function _brebo_office_core_sync_material_source(NodeInterface $node): void {
  if ($node->bundle() !== 'brebo_calc_line'
    || (string) $node->get('field_brebo_cost_category')->value !== 'Materiaal'
    || !$node->hasField('field_brebo_material_code')) {
    return;
  }

  $ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_work_budget_line')
    ->condition('field_brebo_calc_line_ref.target_id', $node->id())
    ->execute();

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($storage->loadMultiple($ids) as $work_line) {
    if (!$work_line instanceof NodeInterface) {
      continue;
    }
    $work_line->set('field_brebo_material_description', $node->get('field_brebo_line_description')->value);
    $work_line->set('field_brebo_material_quantity', $node->get('field_brebo_contract_quantity')->value);
    $work_line->set('field_brebo_material_unit', $node->get('field_brebo_unit')->value);
    foreach ([
      'field_brebo_material_code',
      'field_brebo_material_spec',
      'field_brebo_waste_percent',
      'field_brebo_pack_quantity',
      'field_brebo_preferred_supplier',
    ] as $field_name) {
      if ($work_line->hasField($field_name)) {
        $work_line->set($field_name, $node->get($field_name)->value);
      }
    }
    $work_line->setNewRevision(TRUE);
    $work_line->setRevisionLogMessage('Materiaalgegevens gesynchroniseerd uit calculatieregel ' . $node->id() . '.');
    $work_line->save();
  }
}
