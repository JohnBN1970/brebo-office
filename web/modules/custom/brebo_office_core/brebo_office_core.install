      'field_brebo_org_type' => [
        'label' => 'Relatietype', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Opdrachtgever, hoofdaannemer, leverancier, adviseur, onderaannemer of overige ketenpartij.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 1,
        'default_value' => [['value' => 'Opdrachtgever']],
      ],
