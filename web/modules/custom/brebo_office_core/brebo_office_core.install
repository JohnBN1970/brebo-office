/**
 * Creates a revision-enabled node bundle with configured fields and displays.
 */
function _brebo_office_core_create_node_bundle(
  string $bundle,
  string $name,
  string $description,
  array $fields,
): void {
  if (!NodeType::load($bundle)) {
    NodeType::create([
      'type' => $bundle,
      'name' => $name,
      'description' => $description,
      'new_revision' => TRUE,
      'preview_mode' => 0,
      'display_submitted' => FALSE,
    ])->save();
  }

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }

    if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
      $field = FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $definition['label'],
        'description' => $definition['description'],
        'required' => $definition['required'],
        'settings' => $definition['field_settings'] ?? [],
      ]);
      if (isset($definition['default_value'])) {
        $field->setDefaultValue($definition['default_value']);
      }
      $field->save();
    }
  }

  $form_display = EntityFormDisplay::load("node.$bundle.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
  ]);
  foreach ($fields as $field_name => $definition) {
    $form_display->setComponent($field_name, [
      'type' => $definition['widget'],
      'weight' => $definition['weight'],
    ]);
  }
  $form_display->save();

  $view_display = EntityViewDisplay::load("node.$bundle.default") ?: EntityViewDisplay::create([
    'targetEntityType' => 'node',
    'bundle' => $bundle,
    'mode' => 'default',
    'status' => TRUE,
  ]);
  foreach ($fields as $field_name => $definition) {
    $view_display->setComponent($field_name, [
      'type' => $definition['formatter'],
      'label' => 'above',
      'weight' => $definition['weight'],
    ]);
  }
  $view_display->save();
}


/**
 * Adds applicability and photographic evidence to product positions.
 */
function brebo_office_core_update_11003(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_product_position',
    'Productpositie',
    'Individueel te inspecteren, calculeren of uitvoeren bouwdeel.',
    [
      'field_brebo_not_applicable' => [
        'label' => 'Niet van toepassing',
        'type' => 'boolean',
        'required' => FALSE,
        'storage' => [],
        'description' => 'Markeer dit onderdeel wanneer het binnen deze woning niet van toepassing is.',
        'widget' => 'boolean_checkbox',
        'formatter' => 'boolean',
        'weight' => 7,
        'default_value' => [['value' => 0]],
      ],
      'field_brebo_na_reason' => [
        'label' => 'Reden niet van toepassing',
        'type' => 'string_long',
        'required' => FALSE,
        'storage' => [],
        'description' => 'Leg kort vast waarom dit onderdeel niet van toepassing is.',
        'widget' => 'string_textarea',
        'formatter' => 'basic_string',
        'weight' => 8,
      ],
      'field_brebo_photos' => [
        'label' => 'Fotorapportage',
        'type' => 'image',
        'required' => FALSE,
        'storage' => [
          'uri_scheme' => 'public',
          'default_image' => [
            'uuid' => NULL,
            'alt' => '',
            'title' => '',
            'width' => NULL,
            'height' => NULL,
          ],
        ],
        'field_settings' => [
          'file_directory' => 'brebo-office/photos',
          'file_extensions' => 'png gif jpg jpeg webp',
          'max_filesize' => '20 MB',
          'max_resolution' => '',
          'min_resolution' => '',
          'alt_field' => TRUE,
          'alt_field_required' => FALSE,
          'title_field' => TRUE,
          'title_field_required' => FALSE,
          'default_image' => [
            'uuid' => NULL,
            'alt' => '',
            'title' => '',
            'width' => NULL,
            'height' => NULL,
          ],
        ],
        'description' => 'Upload overzichts- en detailfoto’s als bewijs bij deze productpositie.',
        'widget' => 'image_image',
        'formatter' => 'image',
        'weight' => 9,
        'cardinality' => -1,
      ],
    ],
  );

  return 'N.V.T.-registratie en fotorapportage aan Productpositie toegevoegd.';
}


/**
 * Creates the initial BREBO Office operational roles.
 */
function brebo_office_core_update_11004(): string {
  $bundles = [
    'brebo_project',
    'brebo_cluster',
    'brebo_dwelling',
    'brebo_product_position',
  ];

  $projectleider = [
    'access content',
    'access content overview',
  ];
  $werkvoorbereider = [
    'access content',
    'access content overview',
  ];
  foreach ($bundles as $bundle) {
    $projectleider = array_merge($projectleider, [
      "create $bundle content",
      "edit own $bundle content",
      "edit any $bundle content",
      "delete own $bundle content",
      "delete any $bundle content",
      "view $bundle revisions",
      "revert $bundle revisions",
    ]);
    $werkvoorbereider = array_merge($werkvoorbereider, [
      "create $bundle content",
      "edit own $bundle content",
      "edit any $bundle content",
      "view $bundle revisions",
    ]);
  }

  $roles = [
    'brebo_projectleider' => [
      'label' => 'BREBO Projectleider',
      'permissions' => $projectleider,
    ],
    'brebo_werkvoorbereider' => [
      'label' => 'BREBO Werkvoorbereider',
      'permissions' => $werkvoorbereider,
    ],
    'brebo_kwaliteitsmanager' => [
      'label' => 'BREBO Kwaliteitsmanager',
      'permissions' => [
        'access content',
        'access content overview',
        'create brebo_product_position content',
        'edit own brebo_product_position content',
        'edit any brebo_product_position content',
        'view brebo_project revisions',
        'view brebo_cluster revisions',
        'view brebo_dwelling revisions',
        'view brebo_product_position revisions',
      ],
    ],
  ];

  foreach ($roles as $role_id => $definition) {
    $role = Role::load($role_id) ?: Role::create([
      'id' => $role_id,
      'label' => $definition['label'],
    ]);
    foreach (array_unique($definition['permissions']) as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }

  return 'BREBO Projectleider, Werkvoorbereider en Kwaliteitsmanager aangemaakt.';
}


/**
 * Normalizes empty default-image metadata created by update 11003.
 */
function brebo_office_core_update_11005(): string {
  $default_image = [
    'uuid' => NULL,
    'alt' => '',
    'title' => '',
    'width' => NULL,
    'height' => NULL,
  ];

  $storage = FieldStorageConfig::loadByName('node', 'field_brebo_photos');
  if ($storage) {
    $settings = $storage->getSettings();
    $settings['default_image'] = $default_image;
    $storage->setSettings($settings)->save();
  }

  $field = FieldConfig::loadByName(
    'node',
    'brebo_product_position',
    'field_brebo_photos',
  );
  if ($field) {
    $settings = $field->getSettings();
    $settings['default_image'] = $default_image;
    $field->setSettings($settings)->save();
  }

  return 'Metadata van het lege standaardbeeld voor fotorapportage genormaliseerd.';
}
