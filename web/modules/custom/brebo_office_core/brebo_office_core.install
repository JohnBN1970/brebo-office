      ],
    ]);

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach (['brebo_rfq', 'brebo_rfq_line', 'brebo_supplier_quote', 'brebo_quote_line'] as $bundle) {
        foreach (["create $bundle content", "edit own $bundle content", "edit any $bundle content", "view $bundle revisions"] as $permission) {
          $role->grantPermission($permission);
        }
      }
      $role->save();
    }
  }

  return 'Centrale prijsaanvragen, aanvraagregels, leveranciersoffertes en vergelijkbare prijsregels aangemaakt.';
}


