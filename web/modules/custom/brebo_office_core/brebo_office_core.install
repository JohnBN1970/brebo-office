        'storage' => [], 'description' => 'Aanleiding, consequenties en onderbouwing van het besluit.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 7,
      ],
      'field_brebo_decision_date' => [
        'label' => 'Besluitdatum', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 10], 'description' => 'Datum in de vorm JJJJ-MM-DD.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 8,
      ],
      'field_brebo_approved_by' => [
        'label' => 'Goedgekeurd door', 'type' => 'entity_reference', 'required' => TRUE,
        'storage' => ['target_type' => 'user'], 'field_settings' => ['handler' => 'default:user'],
