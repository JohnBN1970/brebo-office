        'storage' => ['max_length' => 32],
        'description' => 'Organisatieoverstijgend, projectgericht, scopegericht of intern.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 5,
        'default_value' => [['value' => 'Projectgericht']],
      ],
      'field_brebo_conversation_id' => [
        'label' => 'Gespreks- of thread-ID', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 255],
        'description' => 'Technische sleutel waarmee berichten, gesprekken en vergaderdelen bijeen blijven.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 8,
      ],
      'field_brebo_source_id' => [
        'label' => 'Extern bron-ID', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 255],
        'description' => 'Ongewijzigde unieke identificatie uit WhatsApp, Zadarma, e-mail of een ander bronsysteem.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 9,
      ],
