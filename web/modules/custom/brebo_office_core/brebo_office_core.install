        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_comm_channel' => 'brebo_comm_channel']],
        ],
        'description' => 'Beheerde bronlijn, mailbox, groep, vergadering of opnamevorm.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 4,
