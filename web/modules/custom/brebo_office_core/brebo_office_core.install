        'label' => 'Algemeen e-mailadres', 'type' => 'email', 'required' => FALSE,
        'storage' => [],
        'description' => 'Algemeen of administratief e-mailadres van de organisatie.',
        'widget' => 'email_default', 'formatter' => 'email_mailto', 'weight' => 3,
      ],
      'field_brebo_org_phone' => [
        'label' => 'Algemeen telefoonnummer', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 32],
        'description' => 'Centraal telefoonnummer van de organisatie.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 4,
      ],
      'field_brebo_org_address' => [
        'label' => 'Post- of bezoekadres', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 255],
        'description' => 'Volledig zakelijk adres.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 5,
      ],
      'field_brebo_org_status' => [
        'label' => 'Relatiestatus', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Prospect, actief, geblokkeerd of historisch.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 6,
        'default_value' => [['value' => 'Actief']],
      ],
      'field_brebo_description' => [
        'label' => 'Relatienotities', 'type' => 'text_long', 'required' => FALSE,
        'storage' => [],
        'description' => 'Zakelijke bijzonderheden, contractuele context en aandachtspunten.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 7,
      ],
    ],
  );

  _brebo_office_core_create_node_bundle(
    'brebo_contact',
    'Contactpersoon',
    'Persoonlijke relatiekaart gekoppeld aan een organisatie en relevante projecten.',
    [
      'field_brebo_org_ref' => [
        'label' => 'Organisatie', 'type' => 'entity_reference', 'required' => TRUE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_organization' => 'brebo_organization']],
        ],
        'description' => 'Organisatie waarvoor deze contactpersoon optreedt.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 1,
      ],
      'field_brebo_contact_role' => [
        'label' => 'Functie of projectrol', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 128],
        'description' => 'Bijvoorbeeld uitvoerder, projectleider, inkoper, beheerder of directie.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 2,
      ],
      'field_brebo_contact_email' => [
        'label' => 'E-mailadres', 'type' => 'email', 'required' => FALSE,
        'storage' => [],
        'description' => 'Zakelijk e-mailadres van de contactpersoon.',
        'widget' => 'email_default', 'formatter' => 'email_mailto', 'weight' => 3,
      ],
      'field_brebo_contact_phone' => [
        'label' => 'Telefoonnummer', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 32],
        'description' => 'Zakelijk of mobiel telefoonnummer.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 4,
      ],
      'field_brebo_contact_channel' => [
        'label' => 'Voorkeurskanaal', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 32],
        'description' => 'E-mail, telefoon, Teams, portaal of anders.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 5,
        'default_value' => [['value' => 'E-mail']],
      ],
      'field_brebo_contact_active' => [
        'label' => 'Actief contact', 'type' => 'boolean', 'required' => FALSE,
        'storage' => [],
        'description' => 'Contactpersoon is actueel en mag voor nieuwe communicatie worden geselecteerd.',
        'widget' => 'boolean_checkbox', 'formatter' => 'boolean', 'weight' => 6,
        'default_value' => [['value' => 1]],
      ],
      'field_brebo_description' => [
        'label' => 'Contactnotities', 'type' => 'text_long', 'required' => FALSE,
        'storage' => [],
        'description' => 'Mandaat, bereikbaarheid, voorkeuren en relevante zakelijke afspraken.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 7,
      ],
    ],
  );

  _brebo_office_core_create_node_bundle(
    'brebo_project',
    'Project',
    'Centraal projectobject binnen BREBO Office.',
    [
      'field_brebo_client_org_ref' => [
        'label' => 'Opdrachtgevende organisatie', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_organization' => 'brebo_organization']],
        ],
        'description' => 'Vaste relatiekaart van de opdrachtgever; de bestaande tekstnaam blijft beschikbaar voor historie.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 3,
      ],
    ],
  );

  _brebo_office_core_create_node_bundle(
    'brebo_communication',
    'Projectcommunicatie',
    'Auditeerbaar communicatie-, besluit- en opvolgdossier gekoppeld aan project en scope.',
    [
      'field_brebo_comm_org_ref' => [
        'label' => 'Organisatie', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_organization' => 'brebo_organization']],
        ],
        'description' => 'Vaste relatiekaart van de externe organisatie.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 8,
      ],
      'field_brebo_comm_contact_ref' => [
        'label' => 'Contactpersoon', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_contact' => 'brebo_contact']],
        ],
        'description' => 'Vaste contactkaart van de persoon met wie is gecommuniceerd.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 9,
      ],
    ],
  );

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider', 'brebo_kwaliteitsmanager'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach (['brebo_organization', 'brebo_contact'] as $bundle) {
        foreach ([
          "create $bundle content",
          "edit own $bundle content",
          "edit any $bundle content",
          "view $bundle revisions",
        ] as $permission) {
          $role->grantPermission($permission);
        }
      }
      $role->save();
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $organization_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_organization')
    ->execute();
  $organizations = [];
  foreach ($storage->loadMultiple($organization_ids) as $organization) {
    if ($organization instanceof \Drupal\node\NodeInterface) {
      $organizations[mb_strtolower(trim((string) $organization->label()))] = $organization;
    }
  }

  $project_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_project')
    ->execute();
  $created = 0;
  $linked = 0;
  foreach ($storage->loadMultiple($project_ids) as $project) {
    if (!$project instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $client = trim((string) $project->get('field_brebo_client')->value);
    if ($client === '') {
      continue;
    }
    $key = mb_strtolower($client);
    $organization = $organizations[$key] ?? NULL;
    if (!$organization instanceof \Drupal\node\NodeInterface) {
      $organization = \Drupal\node\Entity\Node::create([
        'type' => 'brebo_organization',
        'title' => $client,
        'field_brebo_org_type' => 'Opdrachtgever',
        'field_brebo_org_status' => 'Actief',
        'field_brebo_description' => 'Automatisch aangemaakt uit bestaande projectgegevens door update 11023.',
        'uid' => $project->getOwnerId(),
        'status' => 1,
      ]);
      $organization->save();
      $organizations[$key] = $organization;
      $created++;
    }
    $project->set('field_brebo_client_org_ref', ['target_id' => $organization->id()]);
    $project->setNewRevision(TRUE);
    $project->setRevisionLogMessage('Opdrachtgever aan centrale relatiekaart gekoppeld door update 11023.');
    $project->save();
    $linked++;
  }

  return sprintf(
    'Relatiekaart ingericht: %d organisatie(s) aangemaakt en %d project(en) gekoppeld.',
    $created,
    $linked,
  );
}


/**
 * Establishes the BREBO Lens as a measurable project steering model.
 */
function brebo_office_core_update_11024(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_project',
    'Project',
    'Centraal projectobject binnen BREBO Office.',
    [
      'field_brebo_lens_insight' => [
        'label' => 'Lens Inzicht van toepassing', 'type' => 'boolean', 'required' => FALSE,
        'storage' => [],
        'description' => 'Opname, analyse, gebouwinformatie, risico en advies behoren tot dit project.',
        'widget' => 'boolean_checkbox', 'formatter' => 'boolean', 'weight' => 20,
        'default_value' => [['value' => 1]],
      ],
      'field_brebo_lens_control' => [
        'label' => 'Lens Regie van toepassing', 'type' => 'boolean', 'required' => FALSE,
        'storage' => [],
        'description' => 'Besluiten, communicatie, planning, inkoop en financiële besturing behoren tot dit project.',
        'widget' => 'boolean_checkbox', 'formatter' => 'boolean', 'weight' => 21,
        'default_value' => [['value' => 1]],
      ],
      'field_brebo_lens_realization' => [
        'label' => 'Lens Realisatie van toepassing', 'type' => 'boolean', 'required' => FALSE,
        'storage' => [],
        'description' => 'Uitvoering, controle, bewijs, herstel en oplevering behoren tot dit project.',
        'widget' => 'boolean_checkbox', 'formatter' => 'boolean', 'weight' => 22,
        'default_value' => [['value' => 1]],
      ],
    ],
  );

  $lens_field = [
    'field_brebo_lens_domain' => [
      'label' => 'BREBO Lens-domein', 'type' => 'string', 'required' => TRUE,
      'storage' => ['max_length' => 16],
      'description' => 'Inzicht, Regie of Realisatie: het primaire BREBO Lens-domein van dit onderdeel.',
      'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 30,
      'default_value' => [['value' => 'Regie']],
    ],
  ];
  foreach ([
    'brebo_route_item' => ['Projectrouteonderdeel', 'Bestuurbare stap binnen de automatische projectroute.'],
    'brebo_scope_requirement' => ['Scopevereiste', 'Gewogen procesvereiste voor uitvoering, bewijs, controle, vrijgave of externe ketenafhankelijkheid.'],
    'brebo_communication' => ['Projectcommunicatie', 'Auditeerbaar communicatie-, besluit- en opvolgdossier gekoppeld aan project en scope.'],
    'brebo_work_package' => ['Werkpakket', 'Gebundelde uitvoeringsscope met domeinoverstijgende vrijgavepoorten.'],
  ] as $bundle => [$name, $description]) {
    _brebo_office_core_create_node_bundle($bundle, $name, $description, $lens_field);
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');

  $project_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_project')
    ->execute();
  foreach ($storage->loadMultiple($project_ids) as $project) {
    if (!$project instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $kind = trim((string) $project->get('field_brebo_project_kind')->value);
    $realization = !in_array($kind, ['Adviesproject', 'Inspectie/Onderzoek', 'MJOP', 'Projectmanagement'], TRUE);
    $project->set('field_brebo_lens_insight', 1);
    $project->set('field_brebo_lens_control', 1);
    $project->set('field_brebo_lens_realization', $realization ? 1 : 0);
    $project->setNewRevision(TRUE);
    $project->setRevisionLogMessage('BREBO Lens-toepasbaarheid vastgesteld door update 11024.');
    $project->save();
  }

  $route_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_route_item')
    ->execute();
  foreach ($storage->loadMultiple($route_ids) as $item) {
    if (!$item instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $sequence = (int) $item->get('field_brebo_route_sequence')->value;
    $domain = $sequence <= 40 ? 'Inzicht' : ($sequence <= 70 ? 'Regie' : 'Realisatie');
    $item->set('field_brebo_lens_domain', $domain);
    $item->setNewRevision(TRUE);
    $item->setRevisionLogMessage('Aan BREBO Lens-domein gekoppeld door update 11024.');
    $item->save();
  }

  $requirement_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_scope_requirement')
    ->execute();
  foreach ($storage->loadMultiple($requirement_ids) as $requirement) {
    if (!$requirement instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $type = trim((string) $requirement->get('field_brebo_requirement_type')->value);
    $domain = in_array($type, ['Werkzaamheid', 'Bewijs', 'Controle', 'Vrijgave'], TRUE)
      ? 'Realisatie'
      : 'Regie';
    $requirement->set('field_brebo_lens_domain', $domain);
    $requirement->setNewRevision(TRUE);
    $requirement->setRevisionLogMessage('Aan BREBO Lens-domein gekoppeld door update 11024.');
    $requirement->save();
  }

  foreach (['brebo_communication' => 'Regie', 'brebo_work_package' => 'Realisatie'] as $bundle => $domain) {
    $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', $bundle)->execute();
    foreach ($storage->loadMultiple($ids) as $item) {
      if ($item instanceof \Drupal\node\NodeInterface) {
        $item->set('field_brebo_lens_domain', $domain);
        $item->setNewRevision(TRUE);
        $item->setRevisionLogMessage('Aan BREBO Lens-domein gekoppeld door update 11024.');
        $item->save();
      }
    }
  }

  return 'BREBO Lens Inzicht-Regie-Realisatie als meetbare projectbesturing ingericht.';
}

