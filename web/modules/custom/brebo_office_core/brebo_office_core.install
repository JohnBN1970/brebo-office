      ],
      'field_brebo_control_result' => [
        'label' => 'Controleresultaat',
        'type' => 'string',
        'required' => TRUE,
        'storage' => ['max_length' => 64],
        'description' => 'Actuele uitkomst van deze controle.',
        'widget' => 'string_textfield',
        'formatter' => 'string',
        'weight' => 4,
        'default_value' => [['value' => 'Niet gecontroleerd']],
      ],
      'field_brebo_finding' => [
        'label' => 'Bevinding',
        'type' => 'text_long',
        'required' => FALSE,
        'storage' => [],
        'description' => 'Leg vast wat is gecontroleerd en welke bevinding is gedaan.',
        'widget' => 'text_textarea',
        'formatter' => 'text_default',
        'weight' => 5,
      ],
      'field_brebo_required_action' => [
        'label' => 'Vereiste vervolgactie',
        'type' => 'text_long',
        'required' => FALSE,
        'storage' => [],
        'description' => 'Verplichte herstel-, correctie- of verificatieactie bij een afwijking.',
        'widget' => 'text_textarea',
        'formatter' => 'text_default',
        'weight' => 6,
      ],
      'field_brebo_evidence' => [
        'label' => 'Bewijsfoto’s',
        'type' => 'image',
        'required' => FALSE,
        'storage' => [
          'uri_scheme' => 'public',
          'default_image' => $default_image,
        ],
        'field_settings' => [
          'file_directory' => 'brebo-office/verifications',
          'file_extensions' => 'png gif jpg jpeg webp',
          'max_filesize' => '20 MB',
          'max_resolution' => '',
          'min_resolution' => '',
          'alt_field' => TRUE,
          'alt_field_required' => FALSE,
          'title_field' => TRUE,
          'title_field_required' => FALSE,
          'default_image' => $default_image,
        ],
        'description' => 'Foto’s of afbeeldingen die de controle-uitkomst aantoonbaar onderbouwen.',
        'widget' => 'image_image',
        'formatter' => 'image',
        'weight' => 7,
        'cardinality' => -1,
      ],
      'field_brebo_blocks_release' => [
        'label' => 'Blokkeert vrijgave',
        'type' => 'boolean',
        'required' => FALSE,
        'storage' => [],
        'description' => 'Wordt automatisch geactiveerd zolang deze controle een afwijking bevat.',
        'widget' => 'boolean_checkbox',
        'formatter' => 'boolean',
        'weight' => 8,
        'default_value' => [['value' => 0]],
      ],
    ],
  );

  $role_permissions = [
    'brebo_projectleider' => [
      'create brebo_verification content',
      'edit own brebo_verification content',
      'edit any brebo_verification content',
      'view brebo_verification revisions',
      'revert brebo_verification revisions',
    ],
    'brebo_werkvoorbereider' => [
      'create brebo_verification content',
      'edit own brebo_verification content',
      'edit any brebo_verification content',
      'view brebo_verification revisions',
    ],
    'brebo_kwaliteitsmanager' => [
      'create brebo_verification content',
      'edit own brebo_verification content',
      'edit any brebo_verification content',
      'view brebo_verification revisions',
      'revert brebo_verification revisions',
    ],
  ];

  foreach ($role_permissions as $role_id => $permissions) {
    if ($role = Role::load($role_id)) {
      foreach ($permissions as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }

  return 'Controle- en verificatieobject met auditgegevens, bewijs en vrijgaveblokkering aangemaakt.';
}


/**
 * Creates managed deviations with corrective action and reinspection.
 */
function brebo_office_core_update_11008(): string {
  $default_image = [
    'uuid' => NULL,
    'alt' => '',
    'title' => '',
    'width' => NULL,
    'height' => NULL,
  ];

  _brebo_office_core_create_node_bundle(
    'brebo_deviation',
    'Afwijking',
    'Beheerde afwijking met verantwoordelijke, herstelactie, bewijs en hercontrole.',
    [
      'field_brebo_control_ref' => [
        'label' => 'Broncontrole',
        'type' => 'entity_reference',
        'required' => TRUE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_verification' => 'brebo_verification']],
        ],
