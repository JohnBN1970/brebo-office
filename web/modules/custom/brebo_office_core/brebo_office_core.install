        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 9,
      ],
      'field_brebo_change_status' => [
        'label' => 'Besluitstatus', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32], 'description' => 'Concept, Ter goedkeuring, Goedgekeurd of Afgewezen.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 10,
        'default_value' => [['value' => 'Concept']],
      ],
    ]);

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach (["create brebo_budget_change content", "edit own brebo_budget_change content", "edit any brebo_budget_change content", "view brebo_budget_change revisions"] as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }

  return 'Vier onafhankelijke projectassen, werkpakketverfijning, plafond- en mandaatbeheer vastgesteld.';
}


