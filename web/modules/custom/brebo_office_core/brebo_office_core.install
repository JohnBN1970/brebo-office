        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_contact' => 'brebo_contact']],
        ],
        'description' => 'Bekende contactpersonen die deelnamen aan gesprek, groep of vergadering.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label',
        'weight' => 10, 'cardinality' => -1,
      ],
      'field_brebo_call_duration' => [
        'label' => 'Gespreksduur in seconden', 'type' => 'integer', 'required' => FALSE,
        'storage' => [],
        'description' => 'Duur uit Zadarma of handmatige mobiele registratie.',
        'widget' => 'number', 'formatter' => 'number_integer', 'weight' => 11,
      ],
      'field_brebo_source_files' => [
