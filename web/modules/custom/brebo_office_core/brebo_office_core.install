        'storage' => ['target_type' => 'node'],
        'field_settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_organization' => 'brebo_organization']]],
        'description' => 'De organisatie waarop deze commerciële kans betrekking heeft.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 1,
      ],
      'field_brebo_opp_contact_ref' => [
        'label' => 'Contactpersoon', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_contact' => 'brebo_contact']]],
        'description' => 'De primaire contactpersoon voor deze kans.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 2,
      ],
      'field_brebo_opp_owner' => [
