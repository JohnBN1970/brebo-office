/**
 * Adds main calculation components and controlled labour-hour input.
 */
function brebo_office_core_update_11028(): string {
  $decimal = ['precision' => 18, 'scale' => 4];

  _brebo_office_core_create_node_bundle(
    'brebo_calc_component',
    'Calculatie-hoofdcomponent',
    'Hoofdstuk of hoofdcomponent boven calculatie-elementen.',
    [
      'field_brebo_calculation_ref' => [
        'label' => 'Calculatie', 'type' => 'entity_reference', 'required' => TRUE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_calculation' => 'brebo_calculation']],
        ],
        'description' => 'Calculatie waartoe dit hoofdcomponent behoort.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 1,
      ],
      'field_brebo_component_code' => [
        'label' => 'Hoofdcomponentcode', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Hoofdstukcode, bijvoorbeeld 41 voor buitenwandafwerkingen.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 2,
      ],
      'field_brebo_component_sequence' => [
        'label' => 'Volgorde', 'type' => 'integer', 'required' => TRUE,
        'storage' => [], 'description' => 'Sorteervolgorde binnen de calculatie.',
        'widget' => 'number', 'formatter' => 'number_integer', 'weight' => 3,
        'default_value' => [['value' => 10]],
      ],
      'field_brebo_description' => [
        'label' => 'Omschrijving en uitgangspunten', 'type' => 'text_long', 'required' => FALSE,
        'storage' => [], 'description' => 'Afbakening van het hoofdcomponent.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 4,
      ],
    ],
  );

  _brebo_office_core_create_node_bundle(
    'brebo_calc_element',
    'Calculatie-element',
    'Element binnen een hoofdcomponent van een calculatie.',
    [
      'field_brebo_calc_component_ref' => [
        'label' => 'Hoofdcomponent', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_calc_component' => 'brebo_calc_component']],
        ],
        'description' => 'Hoofdstuk waaronder dit element wordt getotaliseerd.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 1,
      ],
    ],
  );

  _brebo_office_core_create_node_bundle(
    'brebo_calc_line',
    'Calculatieregel',
    'Prijsregel met gecontroleerde norm- of totaalureninvoer.',
    [
      'field_brebo_hours_input_mode' => [
        'label' => 'Leidende ureninvoer', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 24],
        'description' => 'Kies of normuren per eenheid of totaaluren leidend zijn.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 12,
        'default_value' => [['value' => 'Normuren']],
      ],
    ],
  );

  if ($adjust_field = FieldConfig::loadByName('node', 'brebo_calc_adjustment', 'field_brebo_adjust_target')) {
    $settings = $adjust_field->getSetting('handler_settings') ?: [];
    $bundles = $settings['target_bundles'] ?? [];
    $bundles['brebo_calc_component'] = 'brebo_calc_component';
    $settings['target_bundles'] = $bundles;
    $adjust_field->setSetting('handler_settings', $settings)->save();
  }

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach ([
        'create brebo_calc_component content',
        'edit own brebo_calc_component content',
        'edit any brebo_calc_component content',
        'view brebo_calc_component revisions',
      ] as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $calculation_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_calculation')
    ->execute();

  foreach ($storage->loadMultiple($calculation_ids) as $calculation) {
    if (!$calculation instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $element_ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'brebo_calc_element')
      ->condition('field_brebo_calculation_ref.target_id', $calculation->id())
      ->execute();
    $components = [];
    foreach ($storage->loadMultiple($element_ids) as $element) {
      if (!$element instanceof \Drupal\node\NodeInterface || !$element->get('field_brebo_calc_component_ref')->isEmpty()) {
        continue;
      }
      $element_code = trim((string) $element->get('field_brebo_element_code')->value);
      preg_match('/^[0-9]{2}/', $element_code, $match);
      $component_code = $match[0] ?? 'ALG';
      if (!isset($components[$component_code])) {
        $component_ids = $storage->getQuery()
          ->accessCheck(FALSE)
          ->condition('type', 'brebo_calc_component')
          ->condition('field_brebo_calculation_ref.target_id', $calculation->id())
          ->condition('field_brebo_component_code', $component_code)
          ->execute();
        $component = $component_ids ? $storage->load(reset($component_ids)) : NULL;
        if (!$component instanceof \Drupal\node\NodeInterface) {
          $component = $storage->create([
            'type' => 'brebo_calc_component',
            'title' => $component_code === 'ALG' ? 'Algemene calculatie' : 'Hoofdcomponent ' . $component_code,
            'status' => 1,
            'uid' => $calculation->getOwnerId(),
            'field_brebo_calculation_ref' => ['target_id' => $calculation->id()],
            'field_brebo_component_code' => $component_code,
            'field_brebo_component_sequence' => $component_code === 'ALG' ? 999 : (int) $component_code,
          ]);
          $component->save();
        }
        $components[$component_code] = $component;
      }
      $element->set('field_brebo_calc_component_ref', ['target_id' => $components[$component_code]->id()]);
      $element->setNewRevision(TRUE);
      $element->setRevisionLogMessage('Aan hoofdcomponent gekoppeld door update 11028.');
      $element->save();
    }
  }

  return 'Hoofdcomponenten en tweerichtingssturing voor norm- en totaaluren aangemaakt.';
}


/**
 * Turns calculation elements into zone-bound recipe headers.
 */
function brebo_office_core_update_11029(): string {
  $decimal = ['precision' => 18, 'scale' => 4];

  _brebo_office_core_create_node_bundle(
    'brebo_calc_element',
    'Calculatierecept',
    'Recepthoofdregel die een resultaat op een technische gebouwzone bundelt.',
    [
      'field_brebo_technical_zone_ref' => [
        'label' => 'Technische zone', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'node'],
        'field_settings' => [
          'handler' => 'default:node',
          'handler_settings' => ['target_bundles' => ['brebo_building_zone' => 'brebo_building_zone']],
        ],
        'description' => 'Permanente technische gebouwzone waarop dit calculatierecept wordt uitgevoerd.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 2,
      ],
      'field_brebo_recipe_quantity' => [
        'label' => 'Recepthoeveelheid', 'type' => 'decimal', 'required' => FALSE,
        'storage' => $decimal,
        'description' => 'Hoeveelheid van het door dit recept opgeleverde resultaat.',
        'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 5,
        'default_value' => [['value' => '1.0000']],
      ],
      'field_brebo_recipe_unit' => [
        'label' => 'Recepteenheid', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 16],
        'description' => 'Eenheid van het receptresultaat, bijvoorbeeld m², m¹, st of post.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 6,
        'default_value' => [['value' => 'post']],
      ],
    ],
  );

  $storage = \Drupal::entityTypeManager()->getStorage('node');

  // Every building receives a stable root zone. More detailed façade, bay,
  // level or dwelling zones can be added below it without changing recipes.
  $building_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_building')
    ->execute();
  foreach ($storage->loadMultiple($building_ids) as $building) {
    if (!$building instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $root_zone_ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'brebo_building_zone')
      ->condition('field_brebo_building_ref.target_id', $building->id())
      ->condition('field_brebo_zone_code', 'GEBOUW')
      ->execute();
    if (!$root_zone_ids) {
      $root_zone = $storage->create([
        'type' => 'brebo_building_zone',
        'title' => $building->label() . ' — geheel gebouw',
        'status' => 1,
        'uid' => $building->getOwnerId(),
        'field_brebo_building_ref' => ['target_id' => $building->id()],
        'field_brebo_zone_code' => 'GEBOUW',
        'field_brebo_zone_type' => 'Gebouw',
        'field_brebo_status' => 'Ingericht',
        'field_brebo_description' => 'Vaste technische hoofdzone voor werkzaamheden die het gehele gebouw betreffen.',
      ]);
      $root_zone->save();
    }
  }

  $element_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_calc_element')
    ->execute();

  foreach ($storage->loadMultiple($element_ids) as $element) {
    if (!$element instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $changed = FALSE;
    if ($element->get('field_brebo_recipe_quantity')->isEmpty()) {
      $element->set('field_brebo_recipe_quantity', '1.0000');
      $changed = TRUE;
    }
    if ($element->get('field_brebo_recipe_unit')->isEmpty()) {
      $element->set('field_brebo_recipe_unit', 'post');
      $changed = TRUE;
    }
    if ($changed) {
      $element->setNewRevision(TRUE);
      $element->setRevisionLogMessage('Als recepthoofdregel ingericht door update 11029.');
      $element->save();
    }
  }

  return 'Calculatie-elementen als zonegebonden recepthoofdregels ingericht.';
}


/**
 * Adds an accessible traffic-light status to calculation ingredients.
 */
function brebo_office_core_update_11030(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_calc_line',
    'Calculatie-ingrediënt',
    'Werkregel of ingrediënt binnen een zonegebonden calculatierecept.',
    [
      'field_brebo_line_status' => [
        'label' => 'Stoplichtstatus', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Niet beoordeeld, groen/gereed, oranje/aandacht, rood/geblokkeerd of niet van toepassing.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 18,
        'default_value' => [['value' => 'Niet beoordeeld']],
      ],
    ],
  );

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $line_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_calc_line')
    ->execute();
  foreach ($storage->loadMultiple($line_ids) as $line) {
    if ($line instanceof \Drupal\node\NodeInterface && $line->get('field_brebo_line_status')->isEmpty()) {
      $line->set('field_brebo_line_status', 'Niet beoordeeld');
      $line->setNewRevision(TRUE);
      $line->setRevisionLogMessage('Stoplichtstatus geïnitialiseerd door update 11030.');
      $line->save();
    }
  }

  return 'Stoplichtstatus voor calculatie-ingrediënten ingericht.';
}


/**
 * Stores short-lived presence for collaborative calculation editing.
 */
function brebo_office_core_update_11031(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('brebo_calculation_presence')) {
    $schema->createTable('brebo_calculation_presence', [
      'description' => 'Tracks recently active users per calculation.',
      'fields' => [
        'calculation_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'last_seen' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['calculation_id', 'uid'],
      'indexes' => [
        'calculation_active' => ['calculation_id', 'last_seen'],
        'last_seen' => ['last_seen'],
      ],
    ]);
  }

  return 'Aanwezigheidsregistratie voor gelijktijdig calculeren aangemaakt.';
}


/**
 * Adds persistent chat messages to each calculation dossier.
 */
function brebo_office_core_update_11032(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('brebo_calculation_chat')) {
    $schema->createTable('brebo_calculation_chat', [
      'description' => 'Stores collaboration messages per calculation.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'calculation_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'message' => [
          'type' => 'text',
          'size' => 'big',
          'not null' => TRUE,
        ],
        'created' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'calculation_created' => ['calculation_id', 'created'],
        'uid' => ['uid'],
      ],
    ]);
  }

  return 'Calculatiechat per calculatiedossier aangemaakt.';
}



