/**
 * Creates the initial BREBO Office operational roles.
 */
function brebo_office_core_update_11004(): string {
  $bundles = [
    'brebo_project',
    'brebo_cluster',
    'brebo_dwelling',
    'brebo_product_position',
  ];

  $projectleider = [
    'access content',
    'access content overview',
  ];
  $werkvoorbereider = [
    'access content',
    'access content overview',
  ];
  foreach ($bundles as $bundle) {
    $projectleider = array_merge($projectleider, [
      "create $bundle content",
      "edit own $bundle content",
      "edit any $bundle content",
      "delete own $bundle content",
      "delete any $bundle content",
      "view $bundle revisions",
      "revert $bundle revisions",
    ]);
    $werkvoorbereider = array_merge($werkvoorbereider, [
      "create $bundle content",
      "edit own $bundle content",
      "edit any $bundle content",
      "view $bundle revisions",
    ]);
  }

  $roles = [
    'brebo_projectleider' => [
      'label' => 'BREBO Projectleider',
      'permissions' => $projectleider,
    ],
    'brebo_werkvoorbereider' => [
      'label' => 'BREBO Werkvoorbereider',
      'permissions' => $werkvoorbereider,
    ],
    'brebo_kwaliteitsmanager' => [
      'label' => 'BREBO Kwaliteitsmanager',
      'permissions' => [
        'access content',
        'access content overview',
        'create brebo_product_position content',
        'edit own brebo_product_position content',
        'edit any brebo_product_position content',
        'view brebo_project revisions',
        'view brebo_cluster revisions',
        'view brebo_dwelling revisions',
        'view brebo_product_position revisions',
      ],
    ],
  ];

  foreach ($roles as $role_id => $definition) {
    $role = Role::load($role_id) ?: Role::create([
      'id' => $role_id,
      'label' => $definition['label'],
    ]);
    foreach (array_unique($definition['permissions']) as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }

  return 'BREBO Projectleider, Werkvoorbereider en Kwaliteitsmanager aangemaakt.';
}


/**
 * Normalizes empty default-image metadata created by update 11003.
 */
function brebo_office_core_update_11005(): string {
  $default_image = [
    'uuid' => NULL,
    'alt' => '',
    'title' => '',
    'width' => NULL,
    'height' => NULL,
  ];

  $storage = FieldStorageConfig::loadByName('node', 'field_brebo_photos');
  if ($storage) {
    $settings = $storage->getSettings();
    $settings['default_image'] = $default_image;
    $storage->setSettings($settings)->save();
  }

  $field = FieldConfig::loadByName(
    'node',
    'brebo_product_position',
    'field_brebo_photos',
  );
  if ($field) {
    $settings = $field->getSettings();
    $settings['default_image'] = $default_image;
    $field->setSettings($settings)->save();
  }

  return 'Metadata van het lege standaardbeeld voor fotorapportage genormaliseerd.';
}


/**
 * Adds structured glass-order data to Productpositie.
 */
function brebo_office_core_update_11006(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_product_position',
    'Productpositie',
    'Individueel te inspecteren, calculeren of uitvoeren bouwdeel.',
    [
      'field_brebo_facade' => [
        'label' => 'Gevel / ruimte',
        'type' => 'string',
        'required' => TRUE,
        'storage' => ['max_length' => 128],
        'description' => 'Bronrubriek, bijvoorbeeld Achtergevel of Linkerslaapkamer.',
        'widget' => 'string_textfield',
        'formatter' => 'string',
        'weight' => 3,
      ],
      'field_brebo_quantity' => [
        'label' => 'Aantal',
        'type' => 'integer',
        'required' => TRUE,
        'storage' => [],
        'description' => 'Aantal gelijke exemplaren binnen deze productpositie.',
        'widget' => 'number',
        'formatter' => 'number_integer',
        'weight' => 6,
        'default_value' => [['value' => 1]],
      ],
      'field_brebo_width_mm' => [
        'label' => 'Breedte (mm)',
        'type' => 'integer',
        'required' => TRUE,
        'storage' => [],
        'description' => 'Breedtemaat volgens de leidende bestellijst.',
        'widget' => 'number',
        'formatter' => 'number_integer',
        'weight' => 7,
      ],
      'field_brebo_height_mm' => [
        'label' => 'Hoogte (mm)',
        'type' => 'integer',
        'required' => TRUE,
        'storage' => [],
        'description' => 'Hoogtemaat volgens de leidende bestellijst.',
        'widget' => 'number',
        'formatter' => 'number_integer',
        'weight' => 8,
      ],
      'field_brebo_glass_build' => [
        'label' => 'Glasopbouw',
        'type' => 'string',
        'required' => TRUE,
        'storage' => ['max_length' => 255],
        'description' => 'Exacte glasopbouw volgens de leidende bestellijst.',
        'widget' => 'string_textfield',
        'formatter' => 'string',
        'weight' => 9,
      ],
      'field_brebo_requirement' => [
        'label' => 'Eis',
        'type' => 'string',
        'required' => TRUE,
        'storage' => ['max_length' => 128],
        'description' => 'Prestatie-eis volgens de leidende bestellijst.',
        'widget' => 'string_textfield',
        'formatter' => 'string',
        'weight' => 10,
      ],
    ],
  );

  $weights = [
    'field_brebo_position_code' => 1,
    'field_brebo_dwelling_ref' => 2,
    'field_brebo_facade' => 3,
    'field_brebo_product_type' => 4,
    'field_brebo_position_location' => 5,
    'field_brebo_quantity' => 6,
    'field_brebo_width_mm' => 7,
    'field_brebo_height_mm' => 8,
    'field_brebo_glass_build' => 9,
    'field_brebo_requirement' => 10,
    'field_brebo_status' => 11,
    'field_brebo_description' => 12,
    'field_brebo_not_applicable' => 13,
    'field_brebo_na_reason' => 14,
    'field_brebo_photos' => 15,
  ];

  foreach ([
    EntityFormDisplay::load('node.brebo_product_position.default'),
    EntityViewDisplay::load('node.brebo_product_position.default'),
  ] as $display) {
    if (!$display) {
      continue;
    }
    foreach ($weights as $field_name => $weight) {
      $component = $display->getComponent($field_name);
      if ($component) {
        $component['weight'] = $weight;
        $display->setComponent($field_name, $component);
      }
    }
    $display->save();
  }

  return 'Gestructureerde glasgegevens aan Productpositie toegevoegd.';
}


