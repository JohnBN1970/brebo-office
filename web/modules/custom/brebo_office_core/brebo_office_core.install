      'storage' => $decimal, 'description' => 'Leverbare hoeveelheid per doos, bus, rol, pallet of andere verpakking.',
      'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 22,
    ],
    'field_brebo_preferred_supplier' => [
      'label' => 'Voorkeursleverancier', 'type' => 'string', 'required' => FALSE,
      'storage' => ['max_length' => 255], 'description' => 'Voorgestelde leverancier of contractpartner.',
      'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 23,
    ],
  ];

  _brebo_office_core_create_node_bundle(
    'brebo_calc_line',
    'Calculatieregel',
    'Prijsregel met posttype, kostensoort, hoeveelheid en prijsherkomst.',
    $material_source_fields,
  );

  _brebo_office_core_create_node_bundle(
    'brebo_work_budget_line',
    'Werkbegrotingsregel',
    'Uitvoerbare regel met uren-, materiaal- en voortgangsbudget zonder commerciële verkoopinformatie.',
    $material_source_fields + [
      'field_brebo_gross_quantity' => [
        'label' => 'Bruto bestelbehofte', 'type' => 'decimal', 'required' => FALSE,
        'storage' => $decimal, 'description' => 'Automatisch: nettohoeveelheid inclusief verlies.',
        'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 24,
      ],
      'field_brebo_package_count' => [
        'label' => 'Aantal verpakkingen', 'type' => 'integer', 'required' => FALSE,
        'storage' => [], 'description' => 'Automatisch naar boven afgerond op leverbare verpakkingen.',
        'widget' => 'number', 'formatter' => 'number_integer', 'weight' => 25,
      ],
      'field_brebo_order_status' => [
        'label' => 'Bestelstatus', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32], 'description' => 'Niet besteld tot volledig geleverd.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 26,
        'default_value' => [['value' => 'Niet besteld']],
      ],
      'field_brebo_delivery_location' => [
        'label' => 'Afleverlocatie', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 255], 'description' => 'Bouwplaats, magazijn, woning, cluster of andere afleverlocatie.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 27,
      ],
    ],
  );

  return 'Materiaalcodering, verlies, verpakkingen, leverancier en bestelbewaking toegevoegd.';
}
