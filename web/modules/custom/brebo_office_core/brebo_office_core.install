        'field_settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_work_package' => 'brebo_work_package']]],
        'description' => 'Optioneel specifiek werkpakket.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 2,
      ],
      'field_brebo_change_type' => [
        'label' => 'Wijzigingstype', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32], 'description' => 'Budgetverhoging, Plafondwijziging of Mandaatwijziging.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 3,
      ],
      'field_brebo_original_amount' => [
        'label' => 'Oorspronkelijk bedrag', 'type' => 'decimal', 'required' => FALSE,
        'storage' => $decimal, 'description' => 'Vastgelegde grens vóór dit besluit.',
        'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 4,
      ],
      'field_brebo_change_amount' => [
        'label' => 'Wijzigingsbedrag', 'type' => 'decimal', 'required' => TRUE,
        'storage' => $decimal, 'description' => 'Positieve of negatieve wijziging.',
        'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 5,
      ],
      'field_brebo_new_amount' => [
        'label' => 'Nieuwe grens', 'type' => 'decimal', 'required' => FALSE,
