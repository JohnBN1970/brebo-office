        $role->grantPermission($permission);
      }
      $role->save();
    }
  }

  return 'Controleerbaar communicatie-, besluit- en opvolgdossier voor opdrachtgever en ketenpartijen aangemaakt.';
}


/**
 * Creates organization and contact master data and links projects and communication.
 */
function brebo_office_core_update_11023(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_organization',
    'Organisatie',
    'Centrale relatiekaart voor opdrachtgever, hoofdaannemer, leverancier, adviseur en overige ketenpartij.',
