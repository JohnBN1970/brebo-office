        'storage' => ['uri_scheme' => 'private'],
        'field_settings' => [
          'file_directory' => 'brebo-office/communication/source/[date:custom:Y]-[date:custom:m]',
          'file_extensions' => 'pdf doc docx xls xlsx csv txt eml msg wav mp3 m4a ogg mp4 jpg jpeg png webp',
          'max_filesize' => '100 MB',
          'description_field' => TRUE,
        ],
        'description' => 'Originele opname, e-mail, document, afbeelding of ander bronbewijs; privé opgeslagen.',
        'widget' => 'file_generic', 'formatter' => 'file_default',
        'weight' => 12, 'cardinality' => -1,
      ],
      'field_brebo_transcript' => [
        'label' => 'Transcriptie', 'type' => 'text_long', 'required' => FALSE,
        'storage' => [],
        'description' => 'Volledige transcriptie van gesprek, vergadering of voice recording.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 13,
      ],
      'field_brebo_ai_status' => [
        'label' => 'AI-verwerkingsstatus', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Niet verwerkt, concept gemaakt, controle vereist, bevestigd of genegeerd.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 14,
        'default_value' => [['value' => 'Niet verwerkt']],
      ],
      'field_brebo_ai_confidence' => [
        'label' => 'AI-betrouwbaarheid', 'type' => 'decimal', 'required' => FALSE,
        'storage' => ['precision' => 5, 'scale' => 2],
        'description' => 'Technische zekerheid van 0 tot en met 100; nooit een vervanging voor bevoegd vaststellen.',
        'widget' => 'number', 'formatter' => 'number_decimal', 'weight' => 15,
      ],
      'field_brebo_recording_consent' => [
        'label' => 'Opnamegrondslag', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 32],
        'description' => 'Niet opgenomen, aangekondigd, toestemming vastgelegd of beoordeling vereist.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 16,
        'default_value' => [['value' => 'Niet opgenomen']],
      ],
      'field_brebo_formal_status' => [
        'label' => 'Formele status', 'type' => 'string', 'required' => TRUE,
        'storage' => ['max_length' => 32],
        'description' => 'Bron, AI-concept, gecontroleerd, vastgesteld of vervallen.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 17,
        'default_value' => [['value' => 'Bron']],
      ],
    ],
  );

  if ($project_field = FieldConfig::loadByName('node', 'brebo_communication', 'field_brebo_project_ref')) {
    $project_field
      ->setRequired(FALSE)
      ->setDescription('Optioneel project; organisatieoverstijgende en interne communicatie kan zonder project worden vastgelegd.')
      ->save();
  }

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider', 'brebo_kwaliteitsmanager'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach ([
        'create brebo_comm_channel content',
        'edit own brebo_comm_channel content',
        'edit any brebo_comm_channel content',
        'view brebo_comm_channel revisions',
      ] as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $communication_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_communication')
    ->execute();
  foreach ($storage->loadMultiple($communication_ids) as $communication) {
    if (!$communication instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $context = !$communication->get('field_brebo_comm_scope_target')->isEmpty()
      ? 'Scopegericht'
      : (!$communication->get('field_brebo_project_ref')->isEmpty() ? 'Projectgericht' : 'Organisatieoverstijgend');
    $communication->set('field_brebo_comm_context', $context);
    $communication->set('field_brebo_ai_status', 'Niet verwerkt');
    $communication->set('field_brebo_formal_status', 'Bron');
    $communication->setNewRevision(TRUE);
    $communication->setRevisionLogMessage('Kanaalonafhankelijke communicatiefundering toegepast door update 11025.');
    $communication->save();
  }

  return 'Communicatiekanalen, groepen, gesprekken, bronbestanden, transcripties en AI-mandaat als één controleerbaar model ingericht.';
}

/**
 * Adds the controlled communication review and establishment gate.
 */
function brebo_office_core_update_11026(): string {
  _brebo_office_core_create_node_bundle(
    'brebo_communication',
    'Projectcommunicatie',
    'Kanaalonafhankelijk, auditeerbaar communicatie-, besluit- en opvolgdossier.',
    [
      'field_brebo_source_hash' => [
        'label' => 'Bronintegriteit (SHA-256)', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 64],
        'description' => 'Controlewaarde waarmee aantoonbaar blijft dat het oorspronkelijke bronbestand niet ongemerkt is gewijzigd.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 35,
      ],
      'field_brebo_extract_version' => [
        'label' => 'Extractieversie', 'type' => 'string', 'required' => FALSE,
        'storage' => ['max_length' => 64],
        'description' => 'Versie van prompt, model of verwerkingsroute waarmee het AI-concept is gemaakt.',
        'widget' => 'string_textfield', 'formatter' => 'string', 'weight' => 36,
      ],
      'field_brebo_reviewed_by' => [
        'label' => 'Gecontroleerd door', 'type' => 'entity_reference', 'required' => FALSE,
        'storage' => ['target_type' => 'user'],
        'field_settings' => ['handler' => 'default:user', 'handler_settings' => []],
        'description' => 'Bevoegde gebruiker die transcriptie, koppelingen, besluiten en acties inhoudelijk heeft gecontroleerd.',
        'widget' => 'entity_reference_autocomplete', 'formatter' => 'entity_reference_label', 'weight' => 37,
      ],
      'field_brebo_reviewed_at' => [
        'label' => 'Gecontroleerd op', 'type' => 'datetime', 'required' => FALSE,
        'storage' => ['datetime_type' => 'datetime'],
        'description' => 'Datum en tijd van de menselijke inhoudelijke controle.',
        'widget' => 'datetime_default', 'formatter' => 'datetime_default', 'weight' => 38,
      ],
      'field_brebo_reviewer_note' => [
        'label' => 'Controleverklaring', 'type' => 'text_long', 'required' => FALSE,
        'storage' => [],
        'description' => 'Correcties, onzekerheden en motivering voor vaststelling of verwerping.',
        'widget' => 'text_textarea', 'formatter' => 'text_default', 'weight' => 39,
      ],
    ],
  );

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'brebo_communication')->execute();
  foreach ($storage->loadMultiple($ids) as $communication) {
    if (!$communication instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    if ($communication->get('field_brebo_formal_status')->isEmpty()) {
      $communication->set('field_brebo_formal_status', 'Bron');
    }
    if ($communication->get('field_brebo_ai_status')->isEmpty()) {
      $communication->set('field_brebo_ai_status', 'Niet verwerkt');
    }
    $communication->setNewRevision(TRUE);
    $communication->setRevisionLogMessage('Communicatieverwerkingspoort toegepast door update 11026.');
    $communication->save();
  }

  return 'Bronintegriteit, AI-herkomst, menselijke controle en formele vaststelling als verplichte verwerkingspoort gefundeerd.';
}



