  $project_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'brebo_project')
    ->execute();
  foreach ($storage->loadMultiple($project_ids) as $project) {
    if ($project instanceof \Drupal\node\NodeInterface) {
      brebo_office_core_sync_project_route($project);
    }
  }

  return 'Dynamische, auditeerbare projectroutes en vereiste producten per projectsoort aangemaakt.';
