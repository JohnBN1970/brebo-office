<?php

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_delete().
 */
function brebo_building_data_entity_delete(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'brebo_building') {
    return;
  }

  $buildingNid = (int) $entity->id();
  if ($buildingNid <= 0) {
    return;
  }

  $database = \Drupal::database();
  foreach (['brebo_building_address', 'brebo_building_bag_identity'] as $table) {
    if ($database->schema()->tableExists($table)) {
      $database->delete($table)
        ->condition('building_nid', $buildingNid)
        ->execute();
    }
  }
}

/**
 * Implements hook_link_alter().
 *
 * Generic edit links for BREBO buildings lead to the canonical building-truth
 * workbench. The explicit base-edit action on that workbench opts out through
 * the brebo_base_edit query flag.
 */
function brebo_building_data_link_alter(array &$variables): void {
  $url = $variables['url'] ?? NULL;
  if (!$url instanceof Url || !$url->isRouted() || $url->getRouteName() !== 'entity.node.edit_form') {
    return;
  }

  $options = $url->getOptions();
  if (!empty($options['query']['brebo_base_edit'])) {
    return;
  }

  $nodeId = (int) ($url->getRouteParameters()['node'] ?? 0);
  if ($nodeId <= 0) {
    return;
  }

  $node = \Drupal::entityTypeManager()->getStorage('node')->load($nodeId);
  if (!$node instanceof NodeInterface || $node->bundle() !== 'brebo_building') {
    return;
  }

  $variables['url'] = Url::fromRoute('brebo_building_data.truth_workbench', ['node' => $nodeId]);
}
