<?php

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function brebo_building_data_schema(): array {
  $schema = [];

  $schema['brebo_building_address'] = [
    'description' => 'High-volume address relations belonging to a functional BREBO building.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'building_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'normalized_key' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'street' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'house_number' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'house_letter' => ['type' => 'varchar', 'length' => 16, 'not null' => FALSE],
      'addition' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'postal_code' => ['type' => 'varchar', 'length' => 16, 'not null' => FALSE],
      'city' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'country' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => 'Nederland'],
      'latitude' => ['type' => 'numeric', 'precision' => 10, 'scale' => 7, 'not null' => FALSE],
      'longitude' => ['type' => 'numeric', 'precision' => 10, 'scale' => 7, 'not null' => FALSE],
      'is_primary' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'building_address_unique' => ['building_nid', 'normalized_key'],
    ],
    'indexes' => [
      'building_nid' => ['building_nid'],
      'normalized_key' => ['normalized_key'],
      'postal_house' => ['postal_code', 'house_number'],
      'primary_address' => ['building_nid', 'is_primary'],
    ],
  ];

  $schema['brebo_building_bag_identity'] = [
    'description' => 'BAG identities related to a functional BREBO building.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'building_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'bag_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'bag_id' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'is_primary' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'source' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'retrieved_at' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'building_bag_unique' => ['building_nid', 'bag_type', 'bag_id'],
    ],
    'indexes' => [
      'building_nid' => ['building_nid'],
      'bag_identity' => ['bag_type', 'bag_id'],
      'primary_bag' => ['building_nid', 'is_primary'],
    ],
  ];


  $schema['brebo_building_takeoff_set'] = [
    'description' => 'Versioned building-owned take-off datasets reusable by calculations, procurement and execution.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'building_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'version' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'draft'],
      'source_context' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'content_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'locked_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'locked_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['building_version' => ['building_nid', 'version']],
    'indexes' => ['building_status' => ['building_nid', 'status']],
  ];

  $schema['brebo_building_takeoff_position'] = [
    'description' => 'Physical positions in a building-owned take-off set.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'takeoff_set_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'position_ref' => ['type' => 'varchar', 'length' => 96, 'not null' => TRUE],
      'dwelling_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'building_zone_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'product_position_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'description' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'quantity' => ['type' => 'numeric', 'precision' => 19, 'scale' => 4, 'not null' => TRUE, 'default' => 1],
      'width_mm' => ['type' => 'numeric', 'precision' => 19, 'scale' => 2, 'not null' => FALSE],
      'height_mm' => ['type' => 'numeric', 'precision' => 19, 'scale' => 2, 'not null' => FALSE],
      'area_m2' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'perimeter_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'top_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'bottom_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'left_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'right_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'review_status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'proposed'],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['set_position' => ['takeoff_set_id', 'position_ref']],
    'indexes' => [
      'takeoff_set' => ['takeoff_set_id'],
      'dwelling' => ['dwelling_nid'],
      'building_zone' => ['building_zone_nid'],
      'product_position' => ['product_position_nid'],
      'review_status' => ['review_status'],
    ],
  ];

  $schema['brebo_building_takeoff_component'] = [
    'description' => 'Hierarchical physical components below a building take-off position.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'takeoff_position_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'component_ref' => ['type' => 'varchar', 'length' => 96, 'not null' => TRUE],
      'parent_component_ref' => ['type' => 'varchar', 'length' => 96, 'not null' => FALSE],
      'component_type' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'classification_ref' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'description' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'quantity' => ['type' => 'numeric', 'precision' => 19, 'scale' => 4, 'not null' => TRUE, 'default' => 1],
      'width_mm' => ['type' => 'numeric', 'precision' => 19, 'scale' => 2, 'not null' => FALSE],
      'height_mm' => ['type' => 'numeric', 'precision' => 19, 'scale' => 2, 'not null' => FALSE],
      'area_m2' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'perimeter_m' => ['type' => 'numeric', 'precision' => 19, 'scale' => 6, 'not null' => FALSE],
      'source_document_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'source_page' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'source_fragment' => ['type' => 'text', 'not null' => FALSE],
      'source_method' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'confidence' => ['type' => 'numeric', 'precision' => 5, 'scale' => 4, 'not null' => TRUE, 'default' => 0],
      'review_status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'proposed'],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['position_component' => ['takeoff_position_id', 'component_ref']],
    'indexes' => [
      'takeoff_position' => ['takeoff_position_id'],
      'parent_component_ref' => ['parent_component_ref'],
      'review_status' => ['review_status'],
      'source_document' => ['source_document_id'],
    ],
  ];

  return $schema;
}

/**
 * Adds persistent WGS84 coordinates for the buildings dashboard map.
 */
function brebo_building_data_update_11001(): string {
  $schema = \Drupal::database()->schema();
  $table = 'brebo_building_address';
  $fields = [
    'latitude' => ['type' => 'numeric', 'precision' => 10, 'scale' => 7, 'not null' => FALSE],
    'longitude' => ['type' => 'numeric', 'precision' => 10, 'scale' => 7, 'not null' => FALSE],
  ];
  foreach ($fields as $name => $definition) {
    if (!$schema->fieldExists($table, $name)) {
      $schema->addField($table, $name, $definition);
    }
  }
  return 'WGS84 latitude/longitude toegevoegd aan gebouwadressen voor het gebouwen-dashboard.';
}


/** Add permanent building-owned, versioned take-off storage. */
function brebo_building_data_update_11002(): string {
  $schema = \Drupal::database()->schema();
  $definitions = brebo_building_data_schema();
  foreach (['brebo_building_takeoff_set', 'brebo_building_takeoff_position', 'brebo_building_takeoff_component'] as $table) {
    if (!$schema->tableExists($table)) {
      $schema->createTable($table, $definitions[$table]);
    }
  }
  return 'Versioneerbare gebouw-uittrekstaat toegevoegd voor hergebruik door calculatie, inkoop, werkvoorbereiding en uitvoering.';
}
