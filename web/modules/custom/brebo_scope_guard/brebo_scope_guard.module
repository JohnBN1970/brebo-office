<?php

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * Implements hook_node_presave().
 */
function brebo_scope_guard_node_presave(NodeInterface $node): void {
  if ($node->bundle() === 'brebo_project_scope') {
    $violations = brebo_scope_guard_validate_scope($node);
    if ($violations) {
      throw new InvalidArgumentException('Ongeldige Projectscope: ' . implode(' ', $violations));
    }
    return;
  }

  if (in_array($node->bundle(), ['brebo_building_zone', 'brebo_cluster', 'brebo_dwelling', 'brebo_product_position'], TRUE)) {
    $violations = brebo_scope_guard_validate_permanent_object($node);
    if ($violations) {
      throw new InvalidArgumentException('Ongeldig permanent gebouwobject: ' . implode(' ', $violations));
    }
    return;
  }

  if (in_array($node->bundle(), ['brebo_communication', 'brebo_work_package', 'brebo_verification', 'brebo_deviation'], TRUE)) {
    $violations = brebo_scope_guard_validate_context_object($node);
    if ($violations) {
      throw new InvalidArgumentException('Ongeldige canonieke context: ' . implode(' ', $violations));
    }
  }
}

/**
 * Validates that every selected scope object belongs to the selected building.
 *
 * @return string[]
 *   Human-readable violations. Empty means valid.
 */
function brebo_scope_guard_validate_scope(NodeInterface $scope): array {
  if ($scope->bundle() !== 'brebo_project_scope') {
    return [];
  }

  $violations = [];
  $building = $scope->hasField('field_brebo_building_ref') && !$scope->get('field_brebo_building_ref')->isEmpty()
    ? $scope->get('field_brebo_building_ref')->entity
    : NULL;
  $project = $scope->hasField('field_brebo_project_ref') && !$scope->get('field_brebo_project_ref')->isEmpty()
    ? $scope->get('field_brebo_project_ref')->entity
    : NULL;

  if (!$building instanceof NodeInterface || $building->bundle() !== 'brebo_building') {
    $violations[] = 'Er moet één geldig permanent gebouw zijn gekozen.';
    return $violations;
  }
  if (!$project instanceof NodeInterface || $project->bundle() !== 'brebo_project') {
    $violations[] = 'Er moet één geldig project zijn gekozen.';
  }
  elseif (!in_array((int) $building->id(), brebo_scope_guard_project_building_ids($project), TRUE)) {
    $violations[] = 'Het gekozen gebouw moet onderdeel zijn van de canonieke gebouwenlijst van het project.';
  }

  $expected_building_id = (int) $building->id();
  $checks = [
    'field_brebo_scope_zones' => ['brebo_building_zone', 'technische zone'],
    'field_brebo_scope_clusters' => ['brebo_cluster', 'cluster'],
    'field_brebo_scope_dwellings' => ['brebo_dwelling', 'woning'],
    'field_brebo_scope_positions' => ['brebo_product_position', 'productpositie'],
  ];

  foreach ($checks as $field_name => [$expected_bundle, $label]) {
    if (!$scope->hasField($field_name) || $scope->get($field_name)->isEmpty()) {
      continue;
    }

    foreach ($scope->get($field_name)->referencedEntities() as $entity) {
      if (!$entity instanceof NodeInterface || $entity->bundle() !== $expected_bundle) {
        $violations[] = sprintf('Een geselecteerde %s heeft een ongeldig objecttype.', $label);
        continue;
      }

      $object_building_id = brebo_scope_guard_resolve_building_id($entity);
      if ($object_building_id === NULL) {
        $violations[] = sprintf('%s #%d heeft geen eenduidige permanente gebouwrelatie.', ucfirst($label), $entity->id());
        continue;
      }
      if ($object_building_id !== $expected_building_id) {
        $violations[] = sprintf('%s #%d behoort tot een ander gebouw en mag niet in deze Projectscope staan.', ucfirst($label), $entity->id());
      }
    }
  }

  return array_values(array_unique($violations));
}

/**
 * Validates the permanent building hierarchy itself.
 *
 * @return string[]
 *   Human-readable violations. Empty means valid.
 */
function brebo_scope_guard_validate_permanent_object(NodeInterface $entity): array {
  $violations = [];

  if ($entity->bundle() === 'brebo_cluster') {
    if (brebo_scope_guard_resolve_direct_building_id($entity) === NULL) {
      $violations[] = 'Een cluster moet aan precies één geldig permanent gebouw gekoppeld zijn.';
    }
  }

  if ($entity->bundle() === 'brebo_dwelling') {
    $cluster = $entity->hasField('field_brebo_cluster_ref') && !$entity->get('field_brebo_cluster_ref')->isEmpty()
      ? $entity->get('field_brebo_cluster_ref')->entity
      : NULL;
    if (!$cluster instanceof NodeInterface || $cluster->bundle() !== 'brebo_cluster' || brebo_scope_guard_resolve_building_id($cluster) === NULL) {
      $violations[] = 'Een woning moet via één geldig cluster tot een permanent gebouw herleidbaar zijn.';
    }
  }

  if ($entity->bundle() === 'brebo_product_position') {
    $dwelling = $entity->hasField('field_brebo_dwelling_ref') && !$entity->get('field_brebo_dwelling_ref')->isEmpty()
      ? $entity->get('field_brebo_dwelling_ref')->entity
      : NULL;
    if (!$dwelling instanceof NodeInterface || $dwelling->bundle() !== 'brebo_dwelling' || brebo_scope_guard_resolve_building_id($dwelling) === NULL) {
      $violations[] = 'Een productpositie moet via één geldige woning en cluster tot een permanent gebouw herleidbaar zijn.';
    }
  }

  if ($entity->bundle() === 'brebo_building_zone') {
    $building_id = brebo_scope_guard_resolve_direct_building_id($entity);
    if ($building_id === NULL) {
      $violations[] = 'Een technische zone moet aan precies één geldig permanent gebouw gekoppeld zijn.';
      return $violations;
    }

    if ($entity->hasField('field_brebo_parent_zone_ref') && !$entity->get('field_brebo_parent_zone_ref')->isEmpty()) {
      $parent = $entity->get('field_brebo_parent_zone_ref')->entity;
      if (!$parent instanceof NodeInterface || $parent->bundle() !== 'brebo_building_zone') {
        $violations[] = 'De bovenliggende zone moet een geldige technische gebouwzone zijn.';
      }
      elseif (brebo_scope_guard_resolve_building_id($parent) !== $building_id) {
        $violations[] = 'De bovenliggende zone moet tot hetzelfde permanente gebouw behoren.';
      }
      elseif (!$entity->isNew() && (int) $parent->id() === (int) $entity->id()) {
        $violations[] = 'Een technische zone kan niet zichzelf als bovenliggende zone hebben.';
      }
    }

    foreach (['field_brebo_affected_dwellings' => 'woning', 'field_brebo_affected_positions' => 'productpositie'] as $field_name => $label) {
      if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
        continue;
      }
      foreach ($entity->get($field_name)->referencedEntities() as $affected) {
        if (!$affected instanceof NodeInterface || brebo_scope_guard_resolve_building_id($affected) !== $building_id) {
          $violations[] = sprintf('Elke geraakte %s van een technische zone moet tot hetzelfde permanente gebouw behoren.', $label);
        }
      }
    }
  }

  return array_values(array_unique($violations));
}

/**
 * Validates project/building/object context outside Projectscope.
 *
 * Communication may remain organization-wide without project/building context.
 * Once context references are present, they must agree with the canonical model.
 *
 * @return string[]
 *   Human-readable violations. Empty means valid.
 */
function brebo_scope_guard_validate_context_object(NodeInterface $entity): array {
  $violations = [];
  $bundle = $entity->bundle();

  if ($bundle === 'brebo_communication') {
    $project = brebo_scope_guard_reference_entity($entity, 'field_brebo_project_ref');
    $building = brebo_scope_guard_reference_entity($entity, 'field_brebo_building_ref');
    $target = brebo_scope_guard_reference_entity($entity, 'field_brebo_comm_scope_target');

    if ($project !== NULL && $project->bundle() !== 'brebo_project') {
      $violations[] = 'De communicatieprojectrelatie moet naar een geldig project wijzen.';
      $project = NULL;
    }
    if ($building !== NULL && $building->bundle() !== 'brebo_building') {
      $violations[] = 'De communicatiegebouwrelatie moet naar een geldig permanent gebouw wijzen.';
      $building = NULL;
    }
    if ($project instanceof NodeInterface && $building instanceof NodeInterface
      && !in_array((int) $building->id(), brebo_scope_guard_project_building_ids($project), TRUE)) {
      $violations[] = 'Het communicatiegebouw moet onderdeel zijn van het gekozen project.';
    }

    if ($target instanceof NodeInterface) {
      [$target_project_id, $target_building_id] = brebo_scope_guard_resolve_context_ids($target);
      if ($target_building_id === NULL) {
        $violations[] = 'Het communicatiescopeobject moet tot een eenduidig permanent gebouw herleidbaar zijn.';
      }
      if ($building instanceof NodeInterface && $target_building_id !== NULL && $target_building_id !== (int) $building->id()) {
        $violations[] = 'Het communicatiescopeobject moet tot hetzelfde gebouw behoren als de communicatie.';
      }
      if ($project instanceof NodeInterface) {
        if ($target_project_id !== NULL && $target_project_id !== (int) $project->id()) {
          $violations[] = 'De gekoppelde Projectscope moet tot hetzelfde project behoren als de communicatie.';
        }
        elseif ($target_project_id === NULL && $target_building_id !== NULL
          && !in_array($target_building_id, brebo_scope_guard_project_building_ids($project), TRUE)) {
          $violations[] = 'Het communicatiescopeobject moet binnen een gebouw van het gekozen project vallen.';
        }
      }
    }
  }

  if ($bundle === 'brebo_work_package') {
    $project = brebo_scope_guard_reference_entity($entity, 'field_brebo_project_ref');
    $cluster = brebo_scope_guard_reference_entity($entity, 'field_brebo_cluster_ref');
    if (!$project instanceof NodeInterface || $project->bundle() !== 'brebo_project') {
      $violations[] = 'Een werkpakket moet aan één geldig project gekoppeld zijn.';
    }
    if ($cluster !== NULL) {
      if ($cluster->bundle() !== 'brebo_cluster') {
        $violations[] = 'De werkpakketclusterrelatie moet naar een geldig permanent cluster wijzen.';
      }
      elseif ($project instanceof NodeInterface && $project->bundle() === 'brebo_project') {
        $building_id = brebo_scope_guard_resolve_building_id($cluster);
        if ($building_id === NULL || !in_array($building_id, brebo_scope_guard_project_building_ids($project), TRUE)) {
          $violations[] = 'De werkpakketcluster moet binnen een canoniek gebouw van het project vallen.';
        }
      }
    }
  }

  if ($bundle === 'brebo_verification') {
    $position = brebo_scope_guard_reference_entity($entity, 'field_brebo_position_ref');
    if (!$position instanceof NodeInterface || $position->bundle() !== 'brebo_product_position' || brebo_scope_guard_resolve_building_id($position) === NULL) {
      $violations[] = 'Een controle moet naar één geldige canonieke productpositie wijzen.';
    }
  }

  if ($bundle === 'brebo_deviation') {
    $control = brebo_scope_guard_reference_entity($entity, 'field_brebo_control_ref');
    $recheck = brebo_scope_guard_reference_entity($entity, 'field_brebo_recheck_ref');
    if (!$control instanceof NodeInterface || $control->bundle() !== 'brebo_verification') {
      $violations[] = 'Een afwijking moet naar één geldige oorspronkelijke controle wijzen.';
    }
    if ($recheck !== NULL && $recheck->bundle() !== 'brebo_verification') {
      $violations[] = 'Een hercontrole moet naar een geldig controleobject wijzen.';
    }
    if ($control instanceof NodeInterface && $control->bundle() === 'brebo_verification' && $recheck instanceof NodeInterface && $recheck->bundle() === 'brebo_verification') {
      $control_building = brebo_scope_guard_verification_building_id($control);
      $recheck_building = brebo_scope_guard_verification_building_id($recheck);
      if ($control_building === NULL || $recheck_building === NULL || $control_building !== $recheck_building) {
        $violations[] = 'Oorspronkelijke controle en hercontrole moeten binnen hetzelfde permanente gebouw vallen.';
      }
    }
  }

  return array_values(array_unique($violations));
}

/**
 * Returns a referenced node or NULL when a field is absent or empty.
 */
function brebo_scope_guard_reference_entity(NodeInterface $entity, string $field_name): ?NodeInterface {
  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return NULL;
  }
  $referenced = $entity->get($field_name)->entity;
  return $referenced instanceof NodeInterface ? $referenced : NULL;
}

/**
 * Returns canonical building IDs attached to a project.
 *
 * @return int[]
 */
function brebo_scope_guard_project_building_ids(NodeInterface $project): array {
  if ($project->bundle() !== 'brebo_project' || !$project->hasField('field_brebo_building_refs') || $project->get('field_brebo_building_refs')->isEmpty()) {
    return [];
  }
  $ids = [];
  foreach ($project->get('field_brebo_building_refs')->referencedEntities() as $building) {
    if ($building instanceof NodeInterface && $building->bundle() === 'brebo_building') {
      $ids[(int) $building->id()] = (int) $building->id();
    }
  }
  return array_values($ids);
}

/**
 * Resolves project/building IDs for a communication scope target.
 *
 * @return array{0:?int,1:?int}
 */
function brebo_scope_guard_resolve_context_ids(NodeInterface $target): array {
  if ($target->bundle() === 'brebo_project_scope') {
    $project = brebo_scope_guard_reference_entity($target, 'field_brebo_project_ref');
    $building = brebo_scope_guard_reference_entity($target, 'field_brebo_building_ref');
    return [
      $project instanceof NodeInterface && $project->bundle() === 'brebo_project' ? (int) $project->id() : NULL,
      $building instanceof NodeInterface && $building->bundle() === 'brebo_building' ? (int) $building->id() : NULL,
    ];
  }
  return [NULL, brebo_scope_guard_resolve_building_id($target)];
}

/**
 * Resolves the permanent building of a verification through its position.
 */
function brebo_scope_guard_verification_building_id(NodeInterface $verification): ?int {
  if ($verification->bundle() !== 'brebo_verification') {
    return NULL;
  }
  $position = brebo_scope_guard_reference_entity($verification, 'field_brebo_position_ref');
  return $position instanceof NodeInterface && $position->bundle() === 'brebo_product_position'
    ? brebo_scope_guard_resolve_building_id($position)
    : NULL;
}

/**
 * Resolves a direct building reference for zone or cluster.
 */
function brebo_scope_guard_resolve_direct_building_id(NodeInterface $entity): ?int {
  if (!$entity->hasField('field_brebo_building_ref') || $entity->get('field_brebo_building_ref')->isEmpty()) {
    return NULL;
  }
  $building = $entity->get('field_brebo_building_ref')->entity;
  return $building instanceof NodeInterface && $building->bundle() === 'brebo_building'
    ? (int) $building->id()
    : NULL;
}

/**
 * Resolves the permanent building for a supported canonical object.
 */
function brebo_scope_guard_resolve_building_id(NodeInterface $entity): ?int {
  if (in_array($entity->bundle(), ['brebo_building_zone', 'brebo_cluster'], TRUE)) {
    return brebo_scope_guard_resolve_direct_building_id($entity);
  }

  if ($entity->bundle() === 'brebo_dwelling') {
    if (!$entity->hasField('field_brebo_cluster_ref') || $entity->get('field_brebo_cluster_ref')->isEmpty()) {
      return NULL;
    }
    $cluster = $entity->get('field_brebo_cluster_ref')->entity;
    return $cluster instanceof NodeInterface && $cluster->bundle() === 'brebo_cluster'
      ? brebo_scope_guard_resolve_building_id($cluster)
      : NULL;
  }

  if ($entity->bundle() === 'brebo_product_position') {
    if (!$entity->hasField('field_brebo_dwelling_ref') || $entity->get('field_brebo_dwelling_ref')->isEmpty()) {
      return NULL;
    }
    $dwelling = $entity->get('field_brebo_dwelling_ref')->entity;
    return $dwelling instanceof NodeInterface && $dwelling->bundle() === 'brebo_dwelling'
      ? brebo_scope_guard_resolve_building_id($dwelling)
      : NULL;
  }

  return NULL;
}
