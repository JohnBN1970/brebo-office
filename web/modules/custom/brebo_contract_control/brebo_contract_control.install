function brebo_contract_control_update_10006(): void { $schema = \Drupal::database()->schema(); if (!$schema->tableExists('brebo_compliance_evidence')) { $d = brebo_contract_control_schema(); $schema->createTable('brebo_compliance_evidence', $d['brebo_compliance_evidence']); } }
/** Add frozen audit package register. */
function brebo_contract_control_update_10007(): void { $schema = \Drupal::database()->schema(); if (!$schema->tableExists('brebo_audit_package')) { $d = brebo_contract_control_schema(); $schema->createTable('brebo_audit_package', $d['brebo_audit_package']); } }
