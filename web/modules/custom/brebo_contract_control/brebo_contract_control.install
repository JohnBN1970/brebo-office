function brebo_contract_control_update_10001(): void { $schema = \Drupal::database()->schema(); if (!$schema->tableExists('brebo_controller_case')) { $d = brebo_contract_control_schema(); $schema->createTable('brebo_controller_case', $d['brebo_controller_case']); } }
