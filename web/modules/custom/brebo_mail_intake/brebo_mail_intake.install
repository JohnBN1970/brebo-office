<?php

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\user\RoleInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_install().
 */
function brebo_mail_intake_install(): void {
  $bundle = 'brebo_communication';
  if (!NodeType::load($bundle)) {
    throw new RuntimeException('BREBO communicatieobject ontbreekt; Mail Intake kan niet veilig worden geïnstalleerd.');
  }

  $fields = [
    'field_brebo_intake_status' => [
      'label' => 'Intakestatus',
      'type' => 'string',
      'required' => TRUE,
      'storage' => ['max_length' => 32],
      'description' => 'Nieuw, controle vereist, gekoppeld, verwerkt, duplicaat of genegeerd.',
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'weight' => 50,
      'default_value' => [['value' => 'Nieuw']],
    ],
    'field_brebo_mail_classification' => [
      'label' => 'Mailclassificatie',
      'type' => 'string',
      'required' => FALSE,
      'storage' => ['max_length' => 64],
      'description' => 'Bijvoorbeeld offerte, planning, klacht, bewonersmelding, meerwerk, inkoop, oplevering of garantie.',
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'weight' => 51,
    ],
    'field_brebo_mail_from' => [
      'label' => 'E-mailafzender',
      'type' => 'string',
      'required' => FALSE,
      'storage' => ['max_length' => 255],
      'description' => 'Ongewijzigde afzenderweergave uit de bronmail.',
      'widget' => 'string_textfield',
      'formatter' => 'string',
      'weight' => 52,
    ],
    'field_brebo_mail_to' => [
      'label' => 'E-mailontvangers',
      'type' => 'text_long',
      'required' => FALSE,
      'storage' => [],
      'description' => 'Ongewijzigde ontvangerweergave uit To/Cc voor herleidbaarheid.',
      'widget' => 'text_textarea',
      'formatter' => 'text_default',
      'weight' => 53,
    ],
    'field_brebo_match_confidence' => [
      'label' => 'Koppelvertrouwen (%)',
      'type' => 'decimal',
      'required' => FALSE,
      'storage' => ['precision' => 5, 'scale' => 2],
      'description' => 'Technische waarschijnlijkheid van de voorgestelde gebouw-/projectkoppeling; nooit zelfstandig bewijs.',
      'widget' => 'number',
      'formatter' => 'number_decimal',
      'weight' => 54,
    ],
    'field_brebo_match_basis' => [
      'label' => 'Onderbouwing voorgestelde koppeling',
      'type' => 'text_long',
      'required' => FALSE,
      'storage' => [],
      'description' => 'Herleidbare kenmerken waarop een voorgestelde koppeling is gebaseerd en eventuele onzekerheden.',
      'widget' => 'text_textarea',
      'formatter' => 'text_default',
      'weight' => 55,
    ],
    'field_brebo_suggest_building_ref' => [
      'label' => 'Voorgesteld gebouw',
      'type' => 'entity_reference',
      'required' => FALSE,
      'storage' => ['target_type' => 'node'],
      'field_settings' => [
        'handler' => 'default:node',
        'handler_settings' => ['target_bundles' => ['brebo_building' => 'brebo_building']],
      ],
      'description' => 'Niet-vastgestelde gebouwsuggestie. De canonieke Gebouw-koppeling wordt pas na controle gevuld.',
      'widget' => 'entity_reference_autocomplete',
      'formatter' => 'entity_reference_label',
      'weight' => 56,
    ],
    'field_brebo_suggest_project_ref' => [
      'label' => 'Voorgesteld project',
      'type' => 'entity_reference',
      'required' => FALSE,
      'storage' => ['target_type' => 'node'],
      'field_settings' => [
        'handler' => 'default:node',
        'handler_settings' => ['target_bundles' => ['brebo_project' => 'brebo_project']],
      ],
      'description' => 'Niet-vastgestelde projectsuggestie. De canonieke Project-koppeling wordt pas na controle gevuld.',
      'widget' => 'entity_reference_autocomplete',
      'formatter' => 'entity_reference_label',
      'weight' => 57,
    ],
    'field_brebo_duplicate_of' => [
      'label' => 'Duplicaat van',
      'type' => 'entity_reference',
      'required' => FALSE,
      'storage' => ['target_type' => 'node'],
      'field_settings' => [
        'handler' => 'default:node',
        'handler_settings' => ['target_bundles' => ['brebo_communication' => 'brebo_communication']],
      ],
      'description' => 'Bestaand communicatieobject dat dezelfde bronmail vertegenwoordigt.',
      'widget' => 'entity_reference_autocomplete',
      'formatter' => 'entity_reference_label',
      'weight' => 58,
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }

    if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
      $field = FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $definition['label'],
        'description' => $definition['description'],
        'required' => $definition['required'],
        'settings' => $definition['field_settings'] ?? [],
      ]);
      if (isset($definition['default_value'])) {
        $field->setDefaultValue($definition['default_value']);
      }
      $field->save();
    }
  }

  $form_display = EntityFormDisplay::load("node.$bundle.default");
  if ($form_display) {
    foreach ($fields as $field_name => $definition) {
      $form_display->setComponent($field_name, [
        'type' => $definition['widget'],
        'weight' => $definition['weight'],
      ]);
    }
    $form_display->save();
  }

  $view_display = EntityViewDisplay::load("node.$bundle.default");
  if ($view_display) {
    foreach ($fields as $field_name => $definition) {
      $view_display->setComponent($field_name, [
        'type' => $definition['formatter'],
        'label' => 'above',
        'weight' => $definition['weight'],
      ]);
    }
    $view_display->save();
  }
}

/**
 * Adds owner-only personal mailboxes and seeds functional mailbox routing.
 */
function brebo_mail_intake_update_11001(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('brebo_mailbox')) {
    return 'BREBO mailbox foundation ontbreekt; owner/routing update niet uitgevoerd.';
  }

  if (!$schema->fieldExists('brebo_mailbox', 'owner_uid')) {
    $schema->addField('brebo_mailbox', 'owner_uid', [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Drupal user owner for personal mailboxes; zero for non-personal mailboxes.',
    ]);
  }

  $now = time();
  $functional = [
    'info' => ['label' => 'BREBO INFO', 'address' => 'info@brebobv.nl'],
    'facturen' => ['label' => 'BREBO Facturen', 'address' => 'facturen@brebobv.nl'],
    'offerte' => ['label' => 'BREBO Offerte', 'address' => 'offerte@brebobv.nl'],
    'admin' => ['label' => 'BREBO Admin', 'address' => 'admin@brebobv.nl'],
  ];

  $mailboxIds = [];
  foreach ($functional as $machineName => $definition) {
    $existing = $database->select('brebo_mailbox', 'm')
      ->fields('m', ['id'])
      ->condition('machine_name', $machineName)
      ->range(0, 1)
      ->execute()
      ->fetchField();

    if ($existing) {
      $database->update('brebo_mailbox')
        ->fields([
          'label' => $definition['label'],
          'address' => $definition['address'],
          'privacy_type' => 'functional',
          'owner_uid' => 0,
          'active' => 1,
          'changed' => $now,
        ])
        ->condition('id', (int) $existing)
        ->execute();
      $mailboxIds[] = (int) $existing;
      continue;
    }

    $mailboxIds[] = (int) $database->insert('brebo_mailbox')
      ->fields([
        'machine_name' => $machineName,
        'label' => $definition['label'],
        'address' => $definition['address'],
        'privacy_type' => 'functional',
        'owner_uid' => 0,
        'active' => 1,
        'created' => $now,
        'changed' => $now,
      ])
      ->execute();
  }

  $directieRoleId = NULL;
  foreach (\Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple() as $role) {
    if ($role instanceof RoleInterface && mb_strtolower(trim((string) $role->label())) === 'directie') {
      $directieRoleId = $role->id();
      break;
    }
  }

  if ($directieRoleId !== NULL && $schema->tableExists('brebo_mailbox_role')) {
    foreach ($mailboxIds as $mailboxId) {
      foreach (['view', 'handle', 'send_as', 'send_on_behalf', 'archive', 'delete', 'administer'] as $capability) {
        $database->merge('brebo_mailbox_role')
          ->keys([
            'mailbox_id' => $mailboxId,
            'role_id' => $directieRoleId,
            'capability' => $capability,
          ])
          ->fields([])
          ->execute();
      }
    }
  }

  $functionalAddresses = array_map(static fn(array $definition): string => $definition['address'], $functional);
  $personalCount = 0;
  foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple() as $user) {
    if (!$user instanceof UserInterface || !$user->isActive() || (int) $user->id() === 0) {
      continue;
    }
    $address = mb_strtolower(trim((string) $user->getEmail()));
    if ($address === '' || !str_ends_with($address, '@brebobv.nl') || in_array($address, $functionalAddresses, TRUE)) {
      continue;
    }

    $existing = $database->select('brebo_mailbox', 'm')
      ->fields('m', ['id'])
      ->condition('address', $address)
      ->range(0, 1)
      ->execute()
      ->fetchField();

    $local = strstr($address, '@', TRUE) ?: ('user-' . $user->id());
    $machineName = 'personal_' . preg_replace('/[^a-z0-9_]+/', '_', str_replace('.', '_', $local));
    $label = 'Mijn mail - ' . $address;

    if ($existing) {
      $database->update('brebo_mailbox')
        ->fields([
          'privacy_type' => 'personal',
          'owner_uid' => (int) $user->id(),
          'active' => 1,
          'changed' => $now,
        ])
        ->condition('id', (int) $existing)
        ->execute();
    }
    else {
      $database->insert('brebo_mailbox')
        ->fields([
          'machine_name' => $machineName,
          'label' => $label,
          'address' => $address,
          'privacy_type' => 'personal',
          'owner_uid' => (int) $user->id(),
          'active' => 1,
          'created' => $now,
          'changed' => $now,
        ])
        ->execute();
    }
    $personalCount++;
  }

  return sprintf(
    'Mailbox owner/routing actief: %d functionele mailboxen geregistreerd, Directie-rol %s, %d persoonlijke BREBO-mailbox(en) owner-only gekoppeld.',
    count($functional),
    $directieRoleId !== NULL ? 'gekoppeld' : 'niet gevonden',
    $personalCount,
  );
}


/**
 * Adds provider-independent mail-domain registry.
 */
function brebo_mail_intake_update_11002(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('brebo_mail_domain')) {
    return 'BREBO mail-domain registry bestond al.';
  }

  $schema->createTable('brebo_mail_domain', [
    'description' => 'Provider-independent mail domains managed by BREBO Office.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'domain' => ['type' => 'varchar', 'length' => 253, 'not null' => TRUE],
      'verification_token' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'pending'],
      'mx_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'unknown'],
      'spf_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'unknown'],
      'dkim_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'unknown'],
      'dmarc_status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'unknown'],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['brebo_mail_domain_domain' => ['domain']],
    'indexes' => ['brebo_mail_domain_status' => ['status']],
  ]);

  return 'Provider-independent BREBO mail-domain registry aangemaakt.';
}


/**
 * Adds provider-independent mailbox aliases for the BREBO Mail core adapter.
 */
function brebo_mail_intake_update_11003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('brebo_mailbox_alias')) {
    return 'BREBO mailbox-aliasregister bestond al.';
  }

  $schema->createTable('brebo_mailbox_alias', [
    'description' => 'Provider-independent aliases for logical BREBO mailboxes.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'mailbox_id' => ['type' => 'int', 'not null' => TRUE],
      'address' => ['type' => 'varchar', 'length' => 320, 'not null' => TRUE],
      'active' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['brebo_mailbox_alias_address' => ['address']],
    'indexes' => ['brebo_mailbox_alias_mailbox' => ['mailbox_id', 'active']],
  ]);

  return 'Provider-independent BREBO mailbox-aliasregister aangemaakt.';
}


/**
 * Adds provider-independent provisioning job persistence.
 */
function brebo_mail_intake_update_11004(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if ($schema->tableExists('brebo_mail_provisioning_job')) {
    return 'BREBO mail provisioning jobregister bestond al.';
  }

  $schema->createTable('brebo_mail_provisioning_job', [
    'description' => 'Provider-independent BREBO Mail provisioning jobs.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'resource_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'resource_id' => ['type' => 'int', 'not null' => TRUE],
      'operation' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'pending'],
      'provider_reference' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'error_message' => ['type' => 'varchar', 'length' => 1000, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'brebo_mail_provisioning_resource' => ['resource_type', 'resource_id'],
      'brebo_mail_provisioning_status' => ['status', 'changed'],
    ],
  ]);

  return 'BREBO Mail provisioning jobregister aangemaakt.';
}
