<?php

declare(strict_types=1);

/**
 * Plain callable fallback for the Mail Intake review route.
 *
 * Avoids class/service controller resolution in the HTTP runtime while keeping
 * the existing review controller service as the single implementation.
 *
 * @return array<string, mixed>
 *   Render array.
 */
function brebo_mail_intake_review_queue(): array {
  return \Drupal::service('brebo_mail_intake.review_controller')->queue();
}

/**
 * Implements hook_page_attachments().
 */
function brebo_mail_intake_page_attachments(array &$attachments): void {
  $routeName = (string) \Drupal::routeMatch()->getRouteName();
  if (in_array($routeName, ['brebo_mail_intake.mailbox', 'brebo_mail_intake.mailbox_message'], TRUE)) {
    $attachments['#attached']['library'][] = 'brebo_mail_intake/mail_pager';
  }
}

/**
 * Implements hook_cron().
 */
function brebo_mail_intake_cron(): void {
  $source = mb_strtolower(trim((string) (getenv('BREBO_MAIL_SOURCE') ?: 'imap')));
  $serviceId = match ($source) {
    'gmail' => 'brebo_mail_intake.gmail_source',
    'imap' => 'brebo_mail_intake.imap_source',
    default => '',
  };

  if ($serviceId === '') {
    \Drupal::logger('brebo_mail_intake')->warning('Onbekende BREBO_MAIL_SOURCE: @source', ['@source' => $source]);
  }
  else {
    _brebo_mail_intake_enqueue_source($serviceId, strtoupper($source));
  }

  // Zoho historical migration is intentionally state-gated. A stale runtime
  // environment variable must never re-enable backfill after a failed audit.
  $zohoMigrationEnabled = (bool) \Drupal::state()->get('brebo_mail_intake.zoho_migration_enabled', FALSE);
  if ($zohoMigrationEnabled) {
    _brebo_mail_intake_enqueue_source('brebo_mail_intake.zoho_migration_source', 'ZOHO-MIGRATIE');
  }

  if ($source === 'gmail' && filter_var(getenv('BREBO_GMAIL_BACKFILL_ENABLED') ?: '0', FILTER_VALIDATE_BOOL)) {
    try {
      $count = \Drupal::service('brebo_mail_intake.queue_manager')->enqueueGmailBackfill(
        \Drupal::service('brebo_mail_intake.gmail_source'),
      );
      if ($count > 0) {
        \Drupal::logger('brebo_mail_intake')->notice('Gmail historische backfill: @count berichten toegevoegd aan de queue.', ['@count' => $count]);
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('brebo_mail_intake')->error('Gmail historische backfill kon niet worden ingepland: @message', ['@message' => $e->getMessage()]);
    }
  }
}

/**
 * Adds one configured source to the durable queue without blocking cron.
 */
function _brebo_mail_intake_enqueue_source(string $serviceId, string $label): void {
  $adapter = \Drupal::service($serviceId);
  if (!$adapter->isConfigured()) {
    return;
  }

  try {
    $count = \Drupal::service('brebo_mail_intake.queue_manager')->enqueueSource($adapter);
    if ($count > 0) {
      \Drupal::logger('brebo_mail_intake')->notice('@source Mail Intake: @count berichten toegevoegd aan de queue.', [
        '@source' => $label,
        '@count' => $count,
      ]);
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('brebo_mail_intake')->error('@source Mail Intake kon niet worden ingepland: @message', [
      '@source' => $label,
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Implements hook_mail().
 */
function brebo_mail_intake_mail(string $key, array &$message, array $params): void {
  if ($key !== 'outbound') {
    return;
  }

  $subject = trim((string) ($params['subject'] ?? ''));
  $body = trim((string) ($params['body'] ?? ''));
  $bodyHtml = trim((string) ($params['body_html'] ?? ''));
  $signature = is_array($params['signature'] ?? NULL) ? $params['signature'] : [];
  $message['subject'] = $subject;
  $message['body'][] = \Drupal::service('brebo_mail_intake.html_renderer')->render($subject, $body, $bodyHtml, $signature);
  foreach (['Cc' => 'cc', 'Bcc' => 'bcc'] as $header => $parameter) {
    $value = trim((string) ($params[$parameter] ?? ''));
    if ($value !== '') {
      $message['headers'][$header] = $value;
    }
  }
  $message['params']['attachments'] = is_array($params['attachments'] ?? NULL) ? $params['attachments'] : [];
  $message['headers']['X-BREBO-Communication-ID'] = (string) ((int) ($params['communication_id'] ?? 0));
  $message['headers']['X-BREBO-Mail-Format'] = 'controlled-html-v1';
}
