<?php

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function brebo_marketing_publication_schema(): array {
  $schema['brebo_marketing_publication'] = [
    'description' => 'Controlled marketing publication dossier linked one-to-one to a BREBO project.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uuid' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE],
      'project_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'working_title' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'public_title' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'story_summary' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'situation' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'approach' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'execution' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'result' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'disciplines_json' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'target_audience' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'marketing_angle' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'public_location' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
      'marketing_decision' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'undecided'],
      'marketing_status' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'draft'],
      'review_notes' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'reviewed_by_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'reviewed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'approved_by_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'approved_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created_by_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
      'project' => ['project_nid'],
    ],
    'indexes' => [
      'marketing_status' => ['marketing_status'],
      'marketing_decision' => ['marketing_decision'],
      'changed' => ['changed'],
    ],
  ];

  $schema['brebo_marketing_publication_audit'] = [
    'description' => 'Append-only audit trail for marketing publication dossier transitions.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'publication_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'event_type' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'from_status' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'to_status' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE],
      'actor_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'details_json' => ['type' => 'text', 'size' => 'normal', 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'publication_id' => ['publication_id'],
      'event_type' => ['event_type'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}
