<?php

declare(strict_types=1);

use Symfony\Component\Routing\RouteCollection;

/**
 * @file
 * Runtime hooks for BREBO Finance.
 */

/**
 * Implements hook_modules_installed().
 */
function brebo_finance_modules_installed(array $modules, bool $is_syncing): void {
  if (!in_array('brebo_finance', $modules, TRUE)) {
    return;
  }

  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('brebo_finance_project_closure')) {
    return;
  }

  // Fresh installations do not execute historical post-update hooks. Keep the
  // closure storage definition in parity with
  // brebo_finance_post_update_project_financial_closure().
  $money = ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => TRUE, 'default' => 0];
  $schema->createTable('brebo_finance_project_closure', [
    'description' => 'Immutable evidence-backed final financial result for one BREBO project.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'project_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'forecast_snapshot_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'final_revenue_ex_vat' => $money,
      'final_cost_ex_vat' => $money,
      'final_result_ex_vat' => ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => TRUE],
      'final_margin_pct' => ['type' => 'numeric', 'precision' => 10, 'scale' => 4, 'not null' => FALSE],
      'forecast_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'closure_note' => ['type' => 'text', 'not null' => TRUE],
      'content_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'closed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'closed_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'unique keys' => ['project' => ['project_nid'], 'content_hash' => ['content_hash']],
    'indexes' => ['forecast_snapshot' => ['forecast_snapshot_id'], 'closed' => ['closed']],
  ]);
}

/**
 * Implements hook_route_alter().
 */
function brebo_finance_route_alter(RouteCollection $collection): void {
  $route = $collection->get('brebo_finance.project_financial_closure_close');
  if ($route !== NULL) {
    $route->setRequirement('_csrf_request_header_token', 'TRUE');
  }
}

/**
 * Implements hook_page_attachments().
 */
function brebo_finance_page_attachments(array &$attachments): void {
  $request = \Drupal::request();
  $path = $request->getPathInfo();
  $account = \Drupal::currentUser();

  // Make pending financial decisions visible throughout BREBO Office without
  // leaking the finance UI into Drupal administration or public pages.
  if ($account->isAnonymous()
    || !$account->hasPermission('approve brebo finance')
    || !str_starts_with($path, '/brebo-office')
    || str_starts_with($path, '/brebo-office/api/')) {
    return;
  }

  $attachments['#attached']['library'][] = 'brebo_finance/notification_bell';
  $attachments['#attached']['drupalSettings']['breboFinanceNotifications'] = [
    'inboxUrl' => '/brebo-office/finance/decision-inbox',
    'notificationsUrl' => '/brebo-office/api/finance/notifications',
  ];
}

/**
 * Implements hook_cron().
 */
function brebo_finance_cron(): void {
  $database = \Drupal::database();
  $today = date('Y-m-d');

  // Pull the current Moneybird purchase-invoice mirror. Moneybird remains
  // authoritative for accounting data; existing BREBO project/order matching
  // is preserved by the importer. A provider outage must never break Drupal cron.
  try {
    $sync = \Drupal::service('brebo_finance.purchase_invoice_importer')->sync();
    \Drupal::logger('brebo_finance')->info('Moneybird purchase invoice sync: @received received, @inserted inserted, @updated updated, @unchanged unchanged.', [
      '@received' => $sync['received'],
      '@inserted' => $sync['inserted'],
      '@updated' => $sync['updated'],
      '@unchanged' => $sync['unchanged'],
    ]);
  }
  catch (\Throwable $e) {
    \Drupal::logger('brebo_finance')->error('Moneybird purchase invoice sync failed: @message', ['@message' => $e->getMessage()]);
  }

  // Reconcile the Moneybird sales-invoice/receivables mirror as a normal
  // recurring Drupal entry point as well. The reconciler owns monitoring and
  // provenance; a provider outage must never break the remainder of cron.
  try {
    $receivables = \Drupal::service('brebo_finance.sales_invoice_receivables_reconciler')->sync();
    \Drupal::logger('brebo_finance')->info('Moneybird receivables sync: @received received, @updated updated, @unchanged unchanged, @unmatched unmatched.', [
      '@received' => $receivables['received'],
      '@updated' => $receivables['updated'],
      '@unchanged' => $receivables['unchanged'],
      '@unmatched' => $receivables['unmatched'],
    ]);
  }
  catch (\Throwable $e) {
    \Drupal::logger('brebo_finance')->error('Moneybird receivables sync failed: @message', ['@message' => $e->getMessage()]);
  }

  $query = $database->select('brebo_finance_project_contract', 'c');
  $query->leftJoin(
    'brebo_finance_controller_run',
    'r',
    'r.project_nid = c.project_nid AND r.run_date = :run_date AND r.run_type = :run_type',
    [':run_date' => $today, ':run_type' => 'scheduled'],
  );
  $query->addField('c', 'project_nid');
  $query->isNull('r.id');
  $query->condition('c.status', 'approved');
  $projectIds = $query->distinct()->execute()->fetchCol();

  $queue = \Drupal::queue('brebo_finance_digital_controller');
  foreach ($projectIds as $projectNid) {
    $now = time();
    $database->merge('brebo_finance_controller_run')
      ->keys([
        'project_nid' => (int) $projectNid,
        'run_date' => $today,
        'run_type' => 'scheduled',
      ])
      ->fields([
        'status' => 'queued',
        'control_counts' => '{}',
        'evidence_payload' => '{}',
        'evidence_hash' => hash('sha256', '{}'),
        'started' => $now,
        'created' => $now,
        'changed' => $now,
      ])
      ->execute();

    $queue->createItem([
      'project_nid' => (int) $projectNid,
      'scheduled_date' => $today,
    ]);
  }

  // Evaluate pending human financial decisions on every cron run. The engine
  // only updates reminder/escalation state and audit records; it never makes a
  // financial decision automatically.
  \Drupal::service('brebo_finance.financial_decision_escalation_engine')->evaluate();
}
