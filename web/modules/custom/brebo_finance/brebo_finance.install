<?php

declare(strict_types=1);

/**
 * @file
 * Install and schema hooks for BREBO Finance.
 */

/**
 * Implements hook_schema().
 */
function brebo_finance_schema(): array {
  $money = [
    'type' => 'numeric',
    'precision' => 18,
    'scale' => 4,
    'not null' => TRUE,
    'default' => 0,
  ];
