      'approved' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'approved_by' => $user,
      'created' => $timestamp,
      'created_by' => $user,
      'changed' => $timestamp,
      'changed_by' => $user,
