<?php

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function brebo_inzet_install(): void {
  _brebo_inzet_ensure_personnel_assignment_schema();
  _brebo_inzet_ensure_onsite_user_fields();
  _brebo_inzet_ensure_employee_profile_fields();
  _brebo_inzet_ensure_employee_hourly_cost_field();
  _brebo_inzet_ensure_project_team_field();
}

/**
 * Adds the minimal planned personnel-assignment model for existing installs.
 */
function brebo_inzet_update_11001(): string {
  _brebo_inzet_ensure_personnel_assignment_schema();
  return 'Personeelsplanning toegevoegd: persoon, project, datum, geplande tijden/uren en status.';
}

/**
 * Repairs field-name collisions introduced by the first planning foundation.
 */
function brebo_inzet_update_11002(): string {
  _brebo_inzet_ensure_personnel_assignment_schema();

  $bundle = 'brebo_personnel_assignment';
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', $bundle)->execute();
  $entities = $storage->loadMultiple($ids);

  $mapping = [
    'field_brebo_plan_start' => 'field_brebo_assignment_start',
    'field_brebo_plan_end' => 'field_brebo_assignment_end',
    'field_brebo_plan_status' => 'field_brebo_assignment_status',
  ];

  foreach ($entities as $entity) {
    foreach ($mapping as $old => $new) {
      if (!$entity->hasField($old) || !$entity->hasField($new) || $entity->get($old)->isEmpty() || !$entity->get($new)->isEmpty()) {
        continue;
      }
      $value = (string) $entity->get($old)->value;
      if ($new === 'field_brebo_assignment_status') {
        $normalized = strtolower(trim($value));
        $allowed = ['planned', 'confirmed', 'cancelled'];
        $value = in_array($normalized, $allowed, TRUE) ? $normalized : 'planned';
      }
      elseif (in_array($new, ['field_brebo_assignment_start', 'field_brebo_assignment_end'], TRUE)) {
        if (preg_match('/^\d{2}:\d{2}$/', $value) !== 1) {
          continue;
        }
      }
      $entity->set($new, $value);
    }
    $entity->save();
  }

  foreach (array_keys($mapping) as $old_field) {
    if ($config = FieldConfig::loadByName('node', $bundle, $old_field)) {
      $config->delete();
    }
  }

  return 'Personeelsplanning hersteld met unieke inzetvelden en behoud van compatibele bestaande waarden.';
}

/**
 * Ensures the canonical planned personnel-assignment bundle exists.
 */
function brebo_inzet_update_11010(): string {
  _brebo_inzet_ensure_personnel_assignment_schema();
  return 'Personeelsinzet gekoppeld aan de vergrendelde Finance-arbeidsbegrotingsregel.';
}

function _brebo_inzet_ensure_personnel_assignment_schema(): void {
  $bundle = 'brebo_personnel_assignment';

  if (!NodeType::load($bundle)) {
    NodeType::create([
      'type' => $bundle,
      'name' => 'Personeelsinzet',
      'description' => 'Geplande inzet van één persoon op één project en datum. Werkelijke aanwezigheid blijft afkomstig uit BREBO Inzet-klokregistraties.',
      'new_revision' => TRUE,
      'preview_mode' => 0,
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'field_brebo_project_ref' => [
      'label' => 'Project', 'type' => 'entity_reference', 'required' => TRUE,
      'storage' => ['target_type' => 'node'],
      'field_settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_project' => 'brebo_project']]],
      'widget' => 'entity_reference_autocomplete', 'weight' => 1,
    ],
    'field_brebo_plan_user' => [
      'label' => 'Persoon', 'type' => 'entity_reference', 'required' => TRUE,
      'storage' => ['target_type' => 'user'], 'field_settings' => ['handler' => 'default:user'],
      'widget' => 'entity_reference_autocomplete', 'weight' => 2,
    ],
    'field_brebo_plan_date' => [
      'label' => 'Datum', 'type' => 'datetime', 'required' => TRUE,
      'storage' => ['datetime_type' => 'date'], 'field_settings' => [],
      'widget' => 'datetime_default', 'weight' => 3,
    ],
    'field_brebo_assignment_start' => [
      'label' => 'Gepland vanaf', 'type' => 'string', 'required' => FALSE,
      'storage' => ['max_length' => 5], 'field_settings' => [],
      'widget' => 'string_textfield', 'weight' => 4,
    ],
    'field_brebo_assignment_end' => [
      'label' => 'Gepland tot', 'type' => 'string', 'required' => FALSE,
      'storage' => ['max_length' => 5], 'field_settings' => [],
      'widget' => 'string_textfield', 'weight' => 5,
    ],
    'field_brebo_planned_hours' => [
      'label' => 'Geplande uren', 'type' => 'decimal', 'required' => FALSE,
      'storage' => ['precision' => 6, 'scale' => 2], 'field_settings' => [],
      'widget' => 'number', 'weight' => 6,
    ],
    'field_brebo_budget_line_id' => [
      'label' => 'Arbeidsbegrotingsregel', 'type' => 'integer', 'required' => FALSE,
      'storage' => ['unsigned' => TRUE, 'size' => 'big'], 'field_settings' => [],
      'widget' => 'number', 'weight' => 7,
    ],
    'field_brebo_assignment_status' => [
      'label' => 'Status', 'type' => 'list_string', 'required' => TRUE,
      'storage' => ['allowed_values' => ['planned' => 'Gepland', 'confirmed' => 'Bevestigd', 'cancelled' => 'Geannuleerd']],
      'field_settings' => [], 'widget' => 'options_select', 'weight' => 8,
      'default_value' => [['value' => 'planned']],
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }

    if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
      $field = FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $definition['label'],
        'required' => $definition['required'],
        'settings' => $definition['field_settings'],
      ]);
      if (!empty($definition['default_value'])) {
        $field->setDefaultValue($definition['default_value']);
      }
      $field->save();
    }
  }

  $display = EntityFormDisplay::load("node.$bundle.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'node', 'bundle' => $bundle, 'mode' => 'default', 'status' => TRUE,
  ]);
  foreach ($fields as $field_name => $definition) {
    $display->setComponent($field_name, ['type' => $definition['widget'], 'weight' => $definition['weight']]);
  }
  foreach (['field_brebo_plan_start', 'field_brebo_plan_end', 'field_brebo_plan_status'] as $obsolete) {
    $display->removeComponent($obsolete);
  }
  $display->save();

  foreach (['brebo_projectleider', 'brebo_werkvoorbereider', 'brebo_uitvoerder'] as $role_id) {
    if ($role = Role::load($role_id)) {
      foreach ([
        'create brebo_personnel_assignment content',
        'edit own brebo_personnel_assignment content',
        'edit any brebo_personnel_assignment content',
        'delete own brebo_personnel_assignment content',
        'delete any brebo_personnel_assignment content',
        'view brebo_personnel_assignment revisions',
      ] as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
    }
  }
}


/**
 * Adds the Office-owned OnSite identity fields to users.
 */
function brebo_inzet_update_11003(): string {
  _brebo_inzet_ensure_onsite_user_fields();
  return 'OnSite gebruikerskoppeling toegevoegd: mobiel nummer en taalcode.';
}

/**
 * Ensures Office owns the employee mobile number and OnSite language.
 */
function _brebo_inzet_ensure_onsite_user_fields(): void {
  $fields = [
    'field_brebo_mobile' => [
      'label' => 'Mobiel nummer',
      'type' => 'string',
      'storage' => ['max_length' => 32],
      'description' => 'Mobiel nummer voor eenmalige BREBO OnSite-verificatie.',
    ],
    'field_brebo_onsite_language' => [
      'label' => 'OnSite taal',
      'type' => 'string',
      'storage' => ['max_length' => 35],
      'description' => 'BCP-47 taalcode die BREBO OnSite na koppeling gebruikt, bijvoorbeeld nl, en, ro, pl of uk.',
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('user', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }

    if (!FieldConfig::loadByName('user', 'user', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $definition['label'],
        'description' => $definition['description'],
        'required' => FALSE,
      ])->save();
    }
  }
}


/**
 * Adds durable OnSite presence evidence storage.
 */
function brebo_inzet_update_11004(): string {
  _brebo_inzet_ensure_onsite_presence_schema();
  return 'OnSite aanwezigheidsevidence toegevoegd.';
}

/**
 * Ensures the app-specific presence event bundle exists.
 */
function _brebo_inzet_ensure_onsite_presence_schema(): void {
  $bundle = 'brebo_onsite_presence_event';

  if (!NodeType::load($bundle)) {
    NodeType::create([
      'type' => $bundle,
      'name' => 'OnSite aanwezigheidsevent',
      'description' => 'Ruwe IN/UIT-waarneming vanuit BREBO OnSite. Dit is bewijs van aanwezigheid en geen geboekte werktijd.',
      'new_revision' => FALSE,
      'preview_mode' => 0,
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'field_brebo_clock_user' => [
      'label' => 'Medewerker',
      'type' => 'entity_reference',
      'storage' => ['target_type' => 'user'],
      'settings' => ['handler' => 'default:user'],
    ],
    'field_brebo_project_ref' => [
      'label' => 'Project',
      'type' => 'entity_reference',
      'storage' => ['target_type' => 'node'],
      'settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_project' => 'brebo_project']]],
    ],
    'field_brebo_clock_zone_ref' => [
      'label' => 'Projectzone',
      'type' => 'entity_reference',
      'storage' => ['target_type' => 'node'],
      'settings' => ['handler' => 'default:node', 'handler_settings' => ['target_bundles' => ['brebo_clock_zone' => 'brebo_clock_zone']]],
    ],
    'field_brebo_onsite_event_kind' => [
      'label' => 'Waarneming',
      'type' => 'list_string',
      'storage' => ['allowed_values' => ['in' => 'IN', 'out' => 'UIT']],
      'settings' => [],
    ],
    'field_brebo_onsite_occurred_at' => [
      'label' => 'Waargenomen op',
      'type' => 'datetime',
      'storage' => ['datetime_type' => 'datetime'],
      'settings' => [],
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }

    if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $definition['label'],
        'required' => TRUE,
        'settings' => $definition['settings'],
      ])->save();
    }
  }
}


/**
 * Adds the canonical Office employee profile used by BREBO apps.
 */
function brebo_inzet_update_11005(): string {
  _brebo_inzet_ensure_employee_profile_fields();
  return 'BREBO gebruikersprofiel uitgebreid met personeelsnummer, NAW, functie, vaardigheden en inzetstatus.';
}

/**
 * Ensures Office is the canonical source for app-facing employee data.
 */
function _brebo_inzet_ensure_employee_profile_fields(): void {
  $fields = [
    'field_brebo_employee_number' => [
      'label' => 'Personeelsnummer',
      'type' => 'string',
      'storage' => ['max_length' => 32],
      'cardinality' => 1,
      'description' => 'Uniek intern BREBO-personeelsnummer voor koppelingen met apps en planning.',
    ],
    'field_brebo_first_name' => [
      'label' => 'Voornaam',
      'type' => 'string',
      'storage' => ['max_length' => 100],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_last_name' => [
      'label' => 'Achternaam',
      'type' => 'string',
      'storage' => ['max_length' => 150],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_street' => [
      'label' => 'Straat en huisnummer',
      'type' => 'string',
      'storage' => ['max_length' => 255],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_postal_code' => [
      'label' => 'Postcode',
      'type' => 'string',
      'storage' => ['max_length' => 20],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_city' => [
      'label' => 'Plaats',
      'type' => 'string',
      'storage' => ['max_length' => 150],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_country' => [
      'label' => 'Land',
      'type' => 'string',
      'storage' => ['max_length' => 2],
      'cardinality' => 1,
      'description' => 'ISO-landcode, bijvoorbeeld NL of BE.',
    ],
    'field_brebo_job_title' => [
      'label' => 'Functie',
      'type' => 'string',
      'storage' => ['max_length' => 150],
      'cardinality' => 1,
      'description' => '',
    ],
    'field_brebo_skills' => [
      'label' => 'Vaardigheden',
      'type' => 'string',
      'storage' => ['max_length' => 150],
      'cardinality' => -1,
      'description' => 'Vaardigheden en inzetbare competenties van de medewerker.',
    ],
    'field_brebo_workforce_status' => [
      'label' => 'Inzetstatus',
      'type' => 'list_string',
      'storage' => ['allowed_values' => ['active' => 'Actief', 'inactive' => 'Inactief']],
      'cardinality' => 1,
      'description' => 'Operationele inzetstatus voor planning en apps.',
      'default_value' => [['value' => 'active']],
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    if (!FieldStorageConfig::loadByName('user', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => $definition['cardinality'],
      ])->save();
    }

    if (!FieldConfig::loadByName('user', 'user', $field_name)) {
      $field = FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $definition['label'],
        'description' => $definition['description'],
        'required' => FALSE,
      ]);
      if (!empty($definition['default_value'])) {
        $field->setDefaultValue($definition['default_value']);
      }
      $field->save();
    }
  }

  $display = EntityFormDisplay::load('user.user.default') ?: EntityFormDisplay::create([
    'targetEntityType' => 'user',
    'bundle' => 'user',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $weight = 10;
  foreach (array_keys($fields) as $field_name) {
    $display->setComponent($field_name, [
      'type' => $field_name === 'field_brebo_workforce_status' ? 'options_select' : 'string_textfield',
      'weight' => $weight++,
    ]);
  }
  foreach (['field_brebo_mobile', 'field_brebo_onsite_language'] as $field_name) {
    if (FieldConfig::loadByName('user', 'user', $field_name)) {
      $display->setComponent($field_name, ['type' => 'string_textfield', 'weight' => $weight++]);
    }
  }
  $display->save();
}


/**
 * Adds the durable project-team relation used by Inzet and OnSite.
 */
function brebo_inzet_update_11006(): string {
  _brebo_inzet_ensure_project_team_field();
  return 'Projectteam toegevoegd: medewerkers kunnen duurzaam aan projecten worden gekoppeld en zijn direct beschikbaar voor BREBO Inzet en OnSite.';
}

/**
 * Ensures projects own their canonical workforce membership.
 */
function _brebo_inzet_ensure_project_team_field(): void {
  $field_name = 'field_brebo_project_team';

  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => ['target_type' => 'user'],
      'cardinality' => -1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'brebo_project', $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => 'brebo_project',
      'label' => 'Projectteam',
      'description' => 'Medewerkers die bij dit project horen. BREBO Inzet en OnSite gebruiken deze relatie als duurzame projecttoewijzing.',
      'required' => FALSE,
      'settings' => [
        'handler' => 'default:user',
        'handler_settings' => [],
      ],
    ])->save();
  }
}


/**
 * Adds employee availability periods used by project planning.
 */
function brebo_inzet_update_11009(): string {
  _brebo_inzet_ensure_workforce_availability_schema();
  return 'Inzet beschikbaarheid toegevoegd: verlof en niet-beschikbare perioden.';
}

/**
 * Ensures workforce availability truth exists.
 */
function _brebo_inzet_ensure_workforce_availability_schema(): void {
  $bundle = 'brebo_workforce_availability';
  if (!NodeType::load($bundle)) {
    NodeType::create([
      'type' => $bundle,
      'name' => 'Personeelsbeschikbaarheid',
      'description' => 'Verlof en overige niet-beschikbare perioden voor BREBO Inzet.',
      'new_revision' => TRUE,
      'preview_mode' => 0,
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'field_brebo_plan_user' => [
      'label' => 'Medewerker', 'type' => 'entity_reference', 'required' => TRUE,
      'storage' => ['target_type' => 'user'], 'field_settings' => ['handler' => 'default:user'],
      'widget' => 'entity_reference_autocomplete', 'weight' => 1,
    ],
    'field_brebo_unavailable_type' => [
      'label' => 'Reden', 'type' => 'list_string', 'required' => TRUE,
      'storage' => ['allowed_values' => ['leave' => 'Verlof', 'unavailable' => 'Niet beschikbaar']],
      'field_settings' => [], 'widget' => 'options_select', 'weight' => 2,
    ],
    'field_brebo_unavailable_start' => [
      'label' => 'Van', 'type' => 'datetime', 'required' => TRUE,
      'storage' => ['datetime_type' => 'date'], 'field_settings' => [], 'widget' => 'datetime_default', 'weight' => 3,
    ],
    'field_brebo_unavailable_end' => [
      'label' => 'Tot en met', 'type' => 'datetime', 'required' => TRUE,
      'storage' => ['datetime_type' => 'date'], 'field_settings' => [], 'widget' => 'datetime_default', 'weight' => 4,
    ],
    'field_brebo_unavailable_note' => [
      'label' => 'Notitie', 'type' => 'string', 'required' => FALSE,
      'storage' => ['max_length' => 255], 'field_settings' => [], 'widget' => 'string_textfield', 'weight' => 5,
    ],
  ];

  foreach ($fields as $fieldName => $definition) {
    if (!FieldStorageConfig::loadByName('node', $fieldName)) {
      FieldStorageConfig::create([
        'field_name' => $fieldName,
        'entity_type' => 'node',
        'type' => $definition['type'],
        'settings' => $definition['storage'],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', $bundle, $fieldName)) {
      FieldConfig::create([
        'field_name' => $fieldName,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $definition['label'],
        'required' => $definition['required'],
        'settings' => $definition['field_settings'],
      ])->save();
    }
  }

  $display = EntityFormDisplay::load("node.$bundle.default") ?: EntityFormDisplay::create([
    'targetEntityType' => 'node', 'bundle' => $bundle, 'mode' => 'default', 'status' => TRUE,
  ]);
  foreach ($fields as $fieldName => $definition) {
    $display->setComponent($fieldName, ['type' => $definition['widget'], 'weight' => $definition['weight']]);
  }
  $display->save();
}


/**
 * Adds the canonical internal hourly labour cost to employee profiles.
 */
function brebo_inzet_update_11011(): string {
  _brebo_inzet_ensure_employee_hourly_cost_field();
  return 'BREBO medewerkersprofiel uitgebreid met interne kostprijs per uur voor automatische arbeidskoppeling.';
}

/**
 * Ensures every Office employee can carry an internal hourly labour cost.
 */
function _brebo_inzet_ensure_employee_hourly_cost_field(): void {
  $field_name = 'field_brebo_hourly_cost';

  if (!FieldStorageConfig::loadByName('user', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'user',
      'type' => 'decimal',
      'settings' => ['precision' => 10, 'scale' => 2],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('user', 'user', $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'user',
      'bundle' => 'user',
      'label' => 'Interne kostprijs per uur',
      'description' => 'Interne arbeidskostprijs waarmee BREBO Inzet automatisch de juiste arbeidsregel uit de werkbegroting kiest.',
      'required' => FALSE,
    ])->save();
  }

  $display = EntityFormDisplay::load('user.user.default') ?: EntityFormDisplay::create([
    'targetEntityType' => 'user',
    'bundle' => 'user',
    'mode' => 'default',
    'status' => TRUE,
  ]);
  $display->setComponent($field_name, [
    'type' => 'number',
    'weight' => 30,
    'settings' => ['placeholder' => '0,00'],
  ]);
  $display->save();
}
