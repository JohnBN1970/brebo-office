<?php

declare(strict_types=1);

/**
 * @file
 * BREBO Inzet integration hooks.
 */

/**
 * Implements hook_page_attachments().
 */
function brebo_inzet_page_attachments(array &$attachments): void {
  $routeName = \Drupal::routeMatch()->getRouteName();
  if (!in_array($routeName, ['brebo_inzet.app', 'brebo_inzet.app_clock', 'brebo_inzet.mobile_clock'], TRUE)) {
    return;
  }

  $attachments['#attached']['library'][] = 'brebo_inzet/pwa-shell';
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'manifest',
      'href' => '/brebo-inzet.webmanifest',
    ],
    TRUE,
  ];
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'icon',
      'href' => '/modules/custom/brebo_inzet/images/brebo-inzet-icon.svg',
      'type' => 'image/svg+xml',
    ],
    TRUE,
  ];

  $meta = [
    'brebo_inzet_theme_color' => ['name' => 'theme-color', 'content' => '#0f766e'],
    'brebo_inzet_mobile_capable' => ['name' => 'apple-mobile-web-app-capable', 'content' => 'yes'],
    'brebo_inzet_mobile_status' => ['name' => 'apple-mobile-web-app-status-bar-style', 'content' => 'default'],
    'brebo_inzet_mobile_title' => ['name' => 'apple-mobile-web-app-title', 'content' => 'BREBO Inzet'],
  ];
  foreach ($meta as $key => $attributes) {
    $attachments['#attached']['html_head'][] = [
      ['#tag' => 'meta', '#attributes' => $attributes],
      $key,
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for Office user profiles.
 */
function brebo_inzet_form_user_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $user = $form_state->getFormObject()->getEntity();
  if (!$user instanceof \Drupal\user\UserInterface || $user->isNew()) {
    return;
  }
  if (!\Drupal::currentUser()->hasPermission('administer users')) {
    return;
  }

  $form['brebo_onsite'] = [
    '#type' => 'details',
    '#title' => t('BREBO OnSite'),
    '#open' => TRUE,
    '#weight' => 90,
  ];
  $form['brebo_onsite']['invite'] = [
    '#type' => 'link',
    '#title' => t('OnSite koppelen via WhatsApp'),
    '#url' => \Drupal\Core\Url::fromRoute('brebo_inzet.onsite_invite_user', ['user' => $user->id()]),
    '#attributes' => ['class' => ['button', 'button--primary']],
  ];
  $form['brebo_onsite']['help'] = [
    '#markup' => '<p>' . t('Maakt een persoonlijke, eenmalige activatielink voor deze medewerker. Geen sms-code nodig.') . '</p>',
  ];
}
