<?php

declare(strict_types=1);

use Drupal\brebo_office_core\Project\ProjectLifecycle;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * @file
 * Project Cockpit integration hooks.
 *
 * Project subpages must remain independently renderable. The heavy project
 * cockpit belongs to the cockpit route itself and must never be able to take
 * Planning, Documents, Budget, Orders, Finance or other project sections
 * down during page preprocessing.
 *
 * Legacy route ids brebo_project_cockpit.procurement and
 * brebo_project_cockpit.quality intentionally remain in routing.yml as
 * compatibility aliases for old /inkoop and /kwaliteit bookmarks.
 */

/**
 * Implements hook_preprocess_page().
 *
 * Keep only the lightweight project navigation on project subpages. The
 * cockpit overview renders its own steering data from its controller.
 */
function brebo_project_cockpit_preprocess_page(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $route_name = (string) $route_match->getRouteName();

  if ($route_name === 'brebo_project_cockpit.overview') {
    return;
  }

  $project = _brebo_project_cockpit_route_project();
  if (!$project instanceof NodeInterface) {
    return;
  }

  $variables['brebo_project_context_tabs'] = _brebo_project_cockpit_tabs(
    (int) $project->id(),
    $route_name,
  );

  // Project pages have one canonical dossier navigation: the persistent BREBO
  // context tabs above the content. Drupal's generic local-tasks block would
  // otherwise render the same project and Inzet tasks a second time inside
  // the content region (as unstyled primary/secondary lists).
  if (isset($variables['page']['content']['brebo_office_local_tasks'])) {
    unset($variables['page']['content']['brebo_office_local_tasks']);
  }
  if (!empty($variables['page']['content']) && is_array($variables['page']['content'])) {
    foreach ($variables['page']['content'] as $key => $element) {
      if (is_array($element) && ($element['#plugin_id'] ?? NULL) === 'local_tasks_block') {
        unset($variables['page']['content'][$key]);
      }
    }
  }
}

/**
 * Keep the editable project status on the canonical lifecycle machine values.
 *
 * brebo_office_core exposes a generic human-label status selector for several
 * bundles. Project Cockpit runs after that module and deliberately replaces the
 * project variant with the canonical project lifecycle only.
 */
function brebo_project_cockpit_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'brebo_project') {
    return;
  }

  if (!isset($form['field_brebo_status']['widget'][0]['value'])) {
    return;
  }

  $raw = (string) ($form['field_brebo_status']['widget'][0]['value']['#default_value'] ?? ProjectLifecycle::CONCEPT);
  $current = ProjectLifecycle::normalize($raw);
  if (!ProjectLifecycle::isKnown($current)) {
    $current = ProjectLifecycle::CONCEPT;
  }

  $form['field_brebo_status']['widget'][0]['value'] = [
    '#type' => 'select',
    '#title' => $form['field_brebo_status']['widget']['#title'] ?? 'Projectstatus',
    '#default_value' => $current,
    '#options' => ProjectLifecycle::options(),
    '#required' => TRUE,
  ];
}


/**
 * Adds central instalment-template governance to Office settings.
 */
function brebo_project_cockpit_form_brebo_office_core_settings_form_alter(array &$form, FormStateInterface $form_state): void {
  if (!\Drupal::currentUser()->hasPermission('manage brebo instalment templates')) {
    return;
  }

  $form['sales']['instalment_templates'] = [
    '#type' => 'link',
    '#title' => t('Termijnschemasjablonen beheren'),
    '#url' => Url::fromRoute('brebo_project_cockpit.instalment_templates'),
    '#attributes' => ['class' => ['button']],
    '#description' => t('Beheer herbruikbare termijnverdelingen voor projecten, offertes en contracten.'),
  ];
}

/**
 * Implements hook_entity_presave().
 *
 * This is the final write-boundary guard. Known legacy labels are normalized
 * to canonical machine values, while unknown project statuses are rejected so
 * no writer can silently reintroduce a second project-lifecycle truth.
 */
function brebo_project_cockpit_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'brebo_project' || !$entity->hasField('field_brebo_status')) {
    return;
  }

  $raw = trim((string) $entity->get('field_brebo_status')->value);
  $canonical = ProjectLifecycle::normalize($raw);
  if (!ProjectLifecycle::isKnown($canonical)) {
    throw new \UnexpectedValueException(sprintf(
      'Onbekende projectstatus "%s". Gebruik een canonieke projectstatus.',
      $raw,
    ));
  }

  if ($raw !== $canonical) {
    $entity->set('field_brebo_status', $canonical);
  }
}

/**
 * Inject administration-aware numbering before the legacy release submit.
 */
function brebo_project_cockpit_form_brebo_project_cockpit_sales_invoice_release_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#validate'][] = 'brebo_project_cockpit_sales_invoice_administration_number_validate';
}

/**
 * Pre-issue the final invoice number from the project's administration.
 *
 * The existing release form remains responsible for PDF generation, email,
 * Moneybird registration and retry behaviour. By writing the immutable final
 * number into the canonical draft context before submit, its legacy number
 * manager is bypassed without changing the transaction chain.
 */
function brebo_project_cockpit_sales_invoice_administration_number_validate(array &$form, FormStateInterface $form_state): void {
  $draft_id = (int) $form_state->get('draft_id');
  $project_id = (int) $form_state->get('project_id');
  if ($draft_id <= 0 || $project_id <= 0) {
    return;
  }

  $project = \Drupal::entityTypeManager()->getStorage('node')->load($project_id);
  if (!$project instanceof NodeInterface || $project->bundle() !== 'brebo_project') {
    throw new \RuntimeException('Projectcontext voor factuurnummering ontbreekt.');
  }

  $context_store = \Drupal::keyValue('brebo_finance.sales_invoice_draft_context');
  $context = $context_store->get((string) $draft_id, []);
  if (!is_array($context) || (int) ($context['project_nid'] ?? 0) !== $project_id) {
    throw new \RuntimeException('Canonieke projectfactuurcontext ontbreekt.');
  }

  if (empty($context['administration_identity_snapshot'])) {
    $context['administration_identity_snapshot'] = \Drupal::service('brebo_office_core.project_document_identity_resolver')->snapshotForNode($project);
  }

  if (trim((string) ($context['final_invoice_number'] ?? '')) === '') {
    $draft = \Drupal::database()->select('brebo_finance_sales_invoice_draft', 'd')
      ->fields('d', ['invoice_date'])
      ->condition('id', $draft_id)
      ->condition('project_nid', $project_id)
      ->execute()
      ->fetchAssoc();
    if ($draft === FALSE) {
      throw new \RuntimeException('Factuurconcept voor nummeruitgifte ontbreekt.');
    }

    $invoice_year = (int) substr((string) ($draft['invoice_date'] ?? ''), 0, 4);
    $receipt = \Drupal::service('brebo_office_core.project_document_number_issuer')->issueSalesInvoice(
      $project,
      $draft_id,
      $invoice_year > 0 ? $invoice_year : NULL,
    );
    $context['final_invoice_number'] = (string) $receipt['number'];
    $context['final_number_receipt'] = $receipt;
    $context['final_number_reserved_at'] = time();
  }

  $context_store->set((string) $draft_id, $context);
}

/**
 * Resolve a BREBO project from the current route.
 */
function _brebo_project_cockpit_route_project(): ?NodeInterface {
  $route_match = \Drupal::routeMatch();

  foreach (['node', 'project', 'project_nid'] as $parameter_name) {
    $parameter = $route_match->getParameter($parameter_name);

    if ($parameter instanceof NodeInterface && $parameter->bundle() === 'brebo_project') {
      return $parameter;
    }

    if (!is_numeric($parameter)) {
      continue;
    }

    $node = \Drupal::entityTypeManager()->getStorage('node')->load((int) $parameter);
    if ($node instanceof NodeInterface && $node->bundle() === 'brebo_project') {
      return $node;
    }
  }

  return NULL;
}

/**
 * Build deterministic project navigation using real server-side routes.
 *
 * Optional project modules are allowed to be absent. Check the route provider
 * before constructing a Url: Url::fromRoute() is lazy and may not resolve the
 * route until render time, which would otherwise turn one unavailable tab into
 * a 500 for every Project subpage.
 */
function _brebo_project_cockpit_tabs(int $project_id, string $active_route): array {
  $definitions = [
    ['Overzicht', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Planning', 'brebo_office_core.project_planning', ['node' => $project_id]],
    ['Documenten', 'brebo_document_data.project_dossier', ['node' => $project_id]],
    ['Begroting', 'brebo_project_cockpit.budget', ['node' => $project_id]],
    ['Orders', 'brebo_project_cockpit.orders', ['node' => $project_id]],
    ['Contracten', 'brebo_project_cockpit.contracts', ['node' => $project_id]],
    ['Facturen', 'brebo_project_cockpit.invoices', ['node' => $project_id]],
    ['Inzet', 'brebo_inzet.project_dashboard', ['node' => $project_id]],
    ['Tekortkomingen', 'brebo_project_cockpit.shortcomings', ['node' => $project_id]],
    ['Oplevering', 'brebo_project_cockpit.completion', ['node' => $project_id]],
    ['Klantportaal', 'brebo_client_portal.project_control', ['node' => $project_id]],
  ];

  $route_provider = \Drupal::service('router.route_provider');
  $items = [];
  foreach ($definitions as [$label, $route, $parameters]) {
    try {
      $route_provider->getRouteByName($route);
    }
    catch (\Throwable $exception) {
      \Drupal::logger('brebo_project_cockpit')->warning(
        'Project tab @label skipped because route @route is unavailable: @message',
        [
          '@label' => $label,
          '@route' => $route,
          '@message' => $exception->getMessage(),
        ],
      );
      continue;
    }

    $url = Url::fromRoute($route, $parameters);
    $active = $route === $active_route;
    $attributes = ['class' => $active ? ['is-active'] : []];
    if ($active) {
      $attributes['aria-current'] = 'page';
    }

    $items[] = [
      '#type' => 'link',
      '#title' => $label,
      '#url' => $url,
      '#attributes' => $attributes,
    ];
  }

  return [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['brebo-context-tabs', 'brebo-context-tabs--persistent'],
      'aria-label' => 'Projectonderdelen',
    ],
    'items' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['brebo-context-tabs__items']],
    ] + $items,
    '#cache' => [
      'contexts' => ['route', 'user.permissions'],
      'tags' => ['node:' . $project_id],
      'max-age' => 3600,
    ],
  ];
}
