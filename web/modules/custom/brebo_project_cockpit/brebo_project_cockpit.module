<?php

declare(strict_types=1);

use Drupal\node\NodeInterface;
use Drupal\Core\Url;

/**
 * @file
 * Project Cockpit integration hooks.
 */

/**
 * Implements hook_preprocess_page().
 *
 * Keeps the project cockpit and project tabs together on every project page.
 * The overview already renders this shell from its controller; subpages receive
 * the same project context before their own page content.
 */
function brebo_project_cockpit_preprocess_page(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  if ($route_name === 'brebo_project_cockpit.overview') {
    return;
  }

  $project = _brebo_project_cockpit_route_project();
  if (!$project instanceof NodeInterface) {
    return;
  }

  $project_id = (int) $project->id();
  $variables['brebo_project_context_cockpit'] = _brebo_project_cockpit_context_shell($project);
  $variables['brebo_project_context_tabs'] = _brebo_project_cockpit_tabs($project_id, $route_name);
}

/**
 * Resolve a BREBO project from the route without changing existing routes.
 */
function _brebo_project_cockpit_route_project(): ?NodeInterface {
  $route_match = \Drupal::routeMatch();
  foreach (['node', 'project', 'project_nid'] as $parameter_name) {
    $parameter = $route_match->getParameter($parameter_name);
    if ($parameter instanceof NodeInterface && $parameter->bundle() === 'brebo_project') {
      return $parameter;
    }
    if (is_numeric($parameter)) {
      $node = \Drupal::entityTypeManager()->getStorage('node')->load((int) $parameter);
      if ($node instanceof NodeInterface && $node->bundle() === 'brebo_project') {
        return $node;
      }
    }
  }
  return NULL;
}

/**
 * Build the persistent project cockpit for project subpages.
 */
function _brebo_project_cockpit_context_shell(NodeInterface $project): array {
  $project_id = (int) $project->id();
  $finance = \Drupal::service('brebo_finance.financial_cockpit_builder')->build($project_id);
  $operational = \Drupal::service('brebo_project_cockpit.project_status_aggregator')->build($project_id);
  $progress = \Drupal::service('brebo_project_cockpit.project_progress_builder')->build($project_id);

  $forecast = is_array($finance['forecast'] ?? NULL) ? $finance['forecast'] : [];
  $billing = is_array($finance['billing_position'] ?? NULL) ? $finance['billing_position'] : [];
  $cash = is_array($finance['cash_forecast']['committed'] ?? NULL) ? $finance['cash_forecast']['committed'] : [];
  $domains = is_array($operational['domains'] ?? NULL) ? $operational['domains'] : [];

  $planning_status = (string) ($progress['status'] ?? ($domains['planning']['status'] ?? 'grijs'));
  $finance_status = _brebo_project_cockpit_finance_status($finance, $forecast);
  $cash_status = $cash === [] ? 'grijs' : ((!empty($cash['first_regular_shortfall_date']) || !empty($cash['first_g_account_shortfall_date'])) ? 'rood' : 'groen');
  $project_status = _brebo_project_cockpit_worst_status([
    (string) ($operational['status'] ?? 'grijs'),
    $planning_status,
    $finance_status,
    $cash_status,
  ]);

  $hero = [
    '#type' => 'container',
    '#attributes' => ['class' => ['brebo-project-cockpit__hero']],
    'project' => ['#markup' => _brebo_project_cockpit_status_markup('Project', $project_status)],
    'planning' => ['#markup' => _brebo_project_cockpit_status_markup('Planning', $planning_status)],
    'finance' => ['#markup' => _brebo_project_cockpit_status_markup('Geld', $finance_status)],
    'cash' => ['#markup' => _brebo_project_cockpit_status_markup('Cash', $cash_status)],
    'inzet' => ['#markup' => _brebo_project_cockpit_status_markup('Inzet', (string) ($domains['inzet']['status'] ?? 'grijs'))],
    'quality' => ['#markup' => _brebo_project_cockpit_status_markup('Kwaliteit', (string) ($domains['quality']['status'] ?? 'grijs'))],
    'risks' => ['#markup' => _brebo_project_cockpit_status_markup('Risico', (string) ($domains['risks']['status'] ?? 'grijs'))],
  ];

  return [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['brebo-office-cockpit', 'brebo-office-cockpit--persistent-project'],
      'data-brebo-cockpit' => 'project',
    ],
    '#attached' => ['library' => ['brebo_project_cockpit/cockpit']],
    'toggle' => [
      '#type' => 'html_tag',
      '#tag' => 'button',
      '#value' => '⌃',
      '#attributes' => [
        'type' => 'button',
        'class' => ['brebo-office-cockpit__toggle'],
        'data-brebo-cockpit-toggle' => '',
        'aria-expanded' => 'true',
        'aria-label' => 'Projectcockpit inklappen',
      ],
    ],
    'summary' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['brebo-office-cockpit__summary']],
      'title' => ['#markup' => '<strong>' . htmlspecialchars((string) $project->label(), ENT_QUOTES, 'UTF-8') . '</strong>'],
      'status' => ['#markup' => _brebo_project_cockpit_status_label($project_status)],
    ],
    'body' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['brebo-office-cockpit__body']],
      'hero' => $hero,
    ],
    '#cache' => [
      'contexts' => ['route', 'user.permissions'],
      'tags' => ['node:' . $project_id, 'node_list'],
      'max-age' => 0,
    ],
  ];
}

/**
 * Build the persistent project tabs with the current route highlighted.
 */
function _brebo_project_cockpit_tabs(int $project_id, string $active_route): array {
  $definitions = [
    ['Overzicht', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Planning', 'brebo_office_core.project_planning', ['node' => $project_id]],
    ['Documenten', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Calculatie', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Inkoop', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Contracten', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Facturen', 'brebo_finance.project_finance_page', ['project_nid' => $project_id]],
    ['Inzet', 'brebo_inzet.live_workforce', ['node' => $project_id]],
    ['Kwaliteit', 'brebo_office_core.deviations', []],
    ['Oplevering', 'brebo_project_cockpit.overview', ['node' => $project_id]],
    ['Klantportaal', 'brebo_client_portal.project_control', ['node' => $project_id]],
  ];

  $items = [];
  foreach ($definitions as [$label, $route, $parameters]) {
    $active = $route === $active_route;
    $attributes = ['class' => $active ? ['is-active'] : []];
    if ($active) {
      $attributes['aria-current'] = 'page';
    }
    $items[] = [
      '#type' => 'link',
      '#title' => $label,
      '#url' => Url::fromRoute($route, $parameters),
      '#attributes' => $attributes,
    ];
  }

  return [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['brebo-context-tabs', 'brebo-context-tabs--persistent'],
      'aria-label' => 'Projectonderdelen',
    ],
    'items' => [
      '#type' => 'container',
      '#attributes' => ['class' => ['brebo-context-tabs__items']],
    ] + $items,
    '#cache' => [
      'contexts' => ['route'],
      'tags' => ['node:' . $project_id],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function brebo_project_cockpit_page_attachments(array &$attachments): void {
  $project = _brebo_project_cockpit_route_project();
  if (!$project instanceof NodeInterface) {
    return;
  }

  $projectId = (int) $project->id();
  $finance = \Drupal::service('brebo_finance.financial_cockpit_builder')->build($projectId);
  $operational = \Drupal::service('brebo_project_cockpit.project_status_aggregator')->build($projectId);
  $progress = \Drupal::service('brebo_project_cockpit.project_progress_builder')->build($projectId);
  $milestones = \Drupal::service('brebo_project_cockpit.project_milestone_builder')->build($projectId);

  $forecast = is_array($finance['forecast'] ?? NULL) ? $finance['forecast'] : [];
  $procurement = is_array($finance['procurement_pipeline'] ?? NULL) ? $finance['procurement_pipeline'] : [];
  $billing = is_array($finance['billing_position'] ?? NULL) ? $finance['billing_position'] : [];
  $cash = is_array($finance['cash_forecast']['committed'] ?? NULL) ? $finance['cash_forecast']['committed'] : [];
  $domains = is_array($operational['domains'] ?? NULL) ? $operational['domains'] : [];
  $next = is_array($milestones['next_milestone'] ?? NULL) ? $milestones['next_milestone'] : [];

  $client = _brebo_project_cockpit_entity_or_value($project, 'field_brebo_client_org_ref');
  if ($client === '—') {
    $client = _brebo_project_cockpit_value($project, 'field_brebo_client');
  }

  $buildings = [];
  if ($project->hasField('field_brebo_building_refs')) {
    foreach ($project->get('field_brebo_building_refs')->referencedEntities() as $building) {
      $buildings[] = (string) $building->label();
    }
  }

  $projectLeader = '—';
  foreach (['field_brebo_project_manager', 'field_brebo_project_leader', 'field_brebo_projectleider'] as $field) {
    $candidate = _brebo_project_cockpit_entity_or_value($project, $field);
    if ($candidate !== '—') {
      $projectLeader = $candidate;
      break;
    }
  }

  $actual = _brebo_project_cockpit_percent($progress['actual_progress_pct'] ?? NULL);
  $elapsed = _brebo_project_cockpit_percent($progress['time_elapsed_pct'] ?? NULL);
  $delta = _brebo_project_cockpit_signed_pp($progress['progress_vs_time_pct'] ?? NULL);

  $attachments['#attached']['drupalSettings']['breboProjectCockpit']['richCards'] = [
    'Project' => [
      'headline' => _brebo_project_cockpit_value($project, 'field_brebo_project_code'),
      'lines' => [
        'Opdrachtgever: ' . $client,
        'Locatie: ' . ($buildings !== [] ? implode(' · ', $buildings) : '—'),
        'Projectleider: ' . $projectLeader,
        'Fase: ' . ((string) ($milestones['current_phase'] ?? '') !== '' ? (string) $milestones['current_phase'] : _brebo_project_cockpit_value($project, 'field_brebo_status')),
        'Volgende mijlpaal: ' . ($next !== [] ? ((string) ($next['label'] ?? '—') . (!empty($next['due']) ? ' · ' . (string) $next['due'] : '')) : '—'),
      ],
    ],
    'Planning' => [
      'headline' => $actual . ' gereed',
      'lines' => [
        $elapsed . ' tijd verstreken',
        $delta . ' t.o.v. tijdpad',
        (int) ($progress['late_count'] ?? 0) . ' te laat · ' . (int) ($progress['blocked_count'] ?? 0) . ' geblokkeerd',
        'Volgende mijlpaal: ' . ($next !== [] ? (string) ($next['label'] ?? '—') : '—'),
      ],
    ],
    'Geld' => [
      'headline' => _brebo_project_cockpit_money($forecast['forecast_result_ex_vat'] ?? NULL) . ' resultaat',
      'lines' => [
        'Werkbegroting: ' . _brebo_project_cockpit_money($forecast['current_budget_ex_vat'] ?? NULL),
        'Verplicht: ' . _brebo_project_cockpit_money($procurement['committed_ex_vat'] ?? NULL),
        'Prognose eindkosten: ' . _brebo_project_cockpit_money($forecast['forecast_end_cost_ex_vat'] ?? NULL),
        'Marge: ' . _brebo_project_cockpit_percent($forecast['forecast_margin_pct'] ?? NULL),
      ],
    ],
    'Cash' => [
      'headline' => _brebo_project_cockpit_money($billing['paid_inc_vat'] ?? NULL) . ' ontvangen',
      'lines' => [
        'Betaald inkoop: ' . _brebo_project_cockpit_money($procurement['paid_inc_vat'] ?? NULL),
        'Gefactureerd verkoop: ' . _brebo_project_cockpit_money($billing['invoiced_inc_vat'] ?? NULL),
        'Openstaand/vervallen: ' . (int) ($billing['overdue_count'] ?? 0) . ' factuur/facturen',
        'Eerste cashtekort: ' . ((string) ($cash['first_regular_shortfall_date'] ?? '') !== '' ? (string) $cash['first_regular_shortfall_date'] : 'geen voorzien'),
      ],
    ],
    'Inzet' => _brebo_project_cockpit_domain_card($domains['inzet'] ?? [], 'personen/signalen'),
    'Kwaliteit' => _brebo_project_cockpit_domain_card($domains['quality'] ?? [], 'controles/afwijkingen'),
    'Risico' => _brebo_project_cockpit_domain_card($domains['risks'] ?? [], 'actieve risico\'s'),
  ];
}

/** @return array{headline:string,lines:string[]} */
function _brebo_project_cockpit_domain_card(mixed $domain, string $unit): array {
  $domain = is_array($domain) ? $domain : [];
  $total = (int) ($domain['total'] ?? 0);
  $message = trim((string) ($domain['message'] ?? ''));
  return [
    'headline' => $total . ' ' . $unit,
    'lines' => [$message !== '' ? $message : 'Nog geen aangesloten stuurinformatie.'],
  ];
}

function _brebo_project_cockpit_finance_status(array $finance, array $forecast): string {
  if (is_numeric($forecast['forecast_result_ex_vat'] ?? NULL) && (float) $forecast['forecast_result_ex_vat'] < 0) {
    return 'rood';
  }
  $billing = is_array($finance['billing_position'] ?? NULL) ? $finance['billing_position'] : [];
  $workflow = is_array($finance['workflow'] ?? NULL) ? $finance['workflow'] : [];
  if (!empty($finance['forecast_is_stale']) || (int) ($billing['overdue_count'] ?? 0) > 0 || array_sum(array_map('intval', $workflow)) > 0) {
    return 'oranje';
  }
  return $forecast === [] ? 'grijs' : 'groen';
}

function _brebo_project_cockpit_worst_status(array $statuses): string {
  $rank = ['grijs' => 0, 'groen' => 1, 'oranje' => 2, 'rood' => 3];
  $worst = 'grijs';
  foreach ($statuses as $status) {
    if (($rank[$status] ?? 0) > ($rank[$worst] ?? 0)) {
      $worst = $status;
    }
  }
  return $worst;
}

function _brebo_project_cockpit_status_markup(string $label, string $status): string {
  return '<div class="brebo-project-cockpit__status brebo-project-cockpit__status--' . $status . '"><span>' . htmlspecialchars($label, ENT_QUOTES, 'UTF-8') . '</span><strong>' . mb_strtoupper($status) . '</strong></div>';
}

function _brebo_project_cockpit_status_label(string $status): string {
  return match ($status) {
    'rood' => '🔴 Rood',
    'oranje' => '🟠 Oranje',
    'groen' => '🟢 Groen',
    default => '⚪ Grijs',
  };
}

function _brebo_project_cockpit_value(NodeInterface $node, string $field): string {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) return '—';
  $value = trim((string) ($node->get($field)->value ?? ''));
  return $value !== '' ? $value : '—';
}

function _brebo_project_cockpit_entity_or_value(NodeInterface $node, string $field): string {
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) return '—';
  $entity = $node->get($field)->entity;
  return $entity ? (string) $entity->label() : _brebo_project_cockpit_value($node, $field);
}

function _brebo_project_cockpit_money(mixed $value): string {
  return !is_numeric($value) ? '—' : '€ ' . number_format((float) $value, 0, ',', '.');
}

function _brebo_project_cockpit_percent(mixed $value): string {
  return !is_numeric($value) ? '—' : number_format((float) $value, 1, ',', '.') . '%';
}

function _brebo_project_cockpit_signed_pp(mixed $value): string {
  if (!is_numeric($value)) return '—';
  $number = (float) $value;
  return ($number > 0 ? '+' : '') . number_format($number, 1, ',', '.') . ' pp';
}