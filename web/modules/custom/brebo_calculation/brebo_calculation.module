<?php

declare(strict_types=1);

/**
 * @file
 * Runtime hooks for the BREBO Calculation module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function brebo_calculation_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }

  $calculation = $formObject->getEntity();
  if (!$calculation instanceof NodeInterface || $calculation->bundle() !== 'brebo_calculation') {
    return;
  }

  $isNew = $calculation->isNew();
  $form['#attached']['library'][] = 'brebo_calculation/workbench';
  $form['brebo_calculation_onboarding'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => ['class' => ['brebo-calc-onboarding']],
    'eyebrow' => ['#markup' => '<div class="brebo-calc-onboarding__eyebrow">' . ($isNew ? 'Stap 1 van 2' : 'Basisgegevens') . '</div>'],
    'title' => ['#markup' => '<h2 class="brebo-calc-onboarding__title">' . ($isNew ? 'Nieuwe calculatie starten' : 'Calculatiegegevens beheren') . '</h2>'],
    'text' => ['#markup' => '<p class="brebo-calc-onboarding__text">' . ($isNew
      ? 'Leg hier alleen de basis vast. Na opslaan maakt BREBO Office automatisch de eerste conceptversie aan en opent direct de spreadsheetwerkbank voor hoofdgroepen, paragrafen, calculatieregels en deelcalculaties.'
      : 'Deze pagina bevat alleen de basisgegevens van de calculatie. De technische en financiële uitwerking vindt plaats in de Calculatiewerkbank.') . '</p>'],
  ];

  if (!$isNew && $calculation->id() !== NULL) {
    $form['brebo_calculation_onboarding']['action'] = [
      '#type' => 'link',
      '#title' => 'Calculatiewerkbank openen',
      '#url' => \Drupal\Core\Url::fromRoute('brebo_calculation.workbench', ['node' => (int) $calculation->id()]),
      '#attributes' => ['class' => ['button', 'button--primary']],
    ];
  }

  if (isset($form['field_brebo_sales_price'])) {
    $form['field_brebo_sales_price']['#access'] = FALSE;
  }

  if (!$isNew) {
    return;
  }

  // A calculation starts independently. The real Drupal field is package_ref;
  // retain the legacy alias defensively, but neither belongs in this start flow.
  foreach (['field_brebo_package_ref', 'field_brebo_work_package'] as $fieldName) {
    if (isset($form[$fieldName])) {
      $form[$fieldName]['#access'] = FALSE;
    }
  }

  $automaticCode = brebo_calculation_next_code();
  if ($calculation->hasField('field_brebo_calc_code')) {
    $calculation->set('field_brebo_calc_code', $automaticCode);
  }
  if (isset($form['field_brebo_calc_code']['widget'][0]['value'])) {
    $form['field_brebo_calc_code']['widget'][0]['value']['#default_value'] = $automaticCode;
    $form['field_brebo_calc_code']['widget'][0]['value']['#value'] = $automaticCode;
    $form['field_brebo_calc_code']['#access'] = FALSE;
  }

  $today = date('Y-m-d', \Drupal::time()->getCurrentTime());
  if ($calculation->hasField('field_brebo_price_date') && $calculation->get('field_brebo_price_date')->isEmpty()) {
    $calculation->set('field_brebo_price_date', $today);
  }
  if (isset($form['field_brebo_price_date']['widget'][0]['value'])) {
    $priceDateElement = &$form['field_brebo_price_date']['widget'][0]['value'];
    if (($priceDateElement['#default_value'] ?? '') === '') {
      $priceDateElement['#default_value'] = $today;
    }
    $priceDateElement['#description'] = 'Datum waarop de gebruikte prijzen zijn opgehaald of ontvangen. Standaard vandaag; pas aan wanneer je met een andere prijsbasis werkt.';
  }

  foreach (['uid', 'created', 'status', 'revision_information', 'author'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  $form['brebo_commercial_start'] = [
    '#type' => 'details',
    '#title' => 'Commerciële startinstellingen',
    '#description' => 'Optioneel. Deze waarden worden als startparameters in de eerste conceptversie overgenomen.',
    '#open' => FALSE,
    '#weight' => 20,
    '#attributes' => ['class' => ['brebo-calc-create-commercial']],
  ];
  foreach (['field_brebo_general_cost_pct', 'field_brebo_risk_pct', 'field_brebo_profit_pct', 'field_brebo_com_adjustment'] as $fieldName) {
    if (isset($form[$fieldName])) {
      $form['brebo_commercial_start'][$fieldName] = $form[$fieldName];
      unset($form[$fieldName]);
    }
  }

  if (isset($form['field_brebo_calc_version']['widget'][0]['value'])) {
    $form['field_brebo_calc_version']['widget'][0]['value']['#description'] = 'Eerste conceptversie. BREBO Office beheert latere versies vanuit de calculatiewerkbank.';
  }

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = 'Opslaan en calculatiewerkbank openen';
    $handlers = $form['actions']['submit']['#submit'] ?? NULL;
    if (is_array($handlers)) {
      if (!in_array('brebo_calculation_open_workbench_after_create', $handlers, TRUE)) {
        $form['actions']['submit']['#submit'][] = 'brebo_calculation_open_workbench_after_create';
      }
    }
    else {
      $form['#submit'][] = 'brebo_calculation_open_workbench_after_create';
    }
  }
}

function brebo_calculation_next_code(): string {
  $year = (int) date('Y', \Drupal::time()->getCurrentTime());
  $prefix = 'CALC-' . $year . '-';
  $max = 0;
  if (\Drupal::database()->schema()->tableExists('node__field_brebo_calc_code')) {
    $values = \Drupal::database()->select('node__field_brebo_calc_code', 'c')
      ->fields('c', ['field_brebo_calc_code_value'])
      ->condition('field_brebo_calc_code_value', $prefix . '%', 'LIKE')
      ->execute()->fetchCol();
    foreach ($values as $value) {
      if (preg_match('/^' . preg_quote($prefix, '/') . '(\d+)$/', (string) $value, $matches)) {
        $max = max($max, (int) $matches[1]);
      }
    }
  }
  return $prefix . str_pad((string) ($max + 1), 3, '0', STR_PAD_LEFT);
}

function brebo_calculation_node_presave(NodeInterface $node): void {
  if ($node->bundle() !== 'brebo_calculation' || !$node->isNew() || !$node->hasField('field_brebo_calc_code')) {
    return;
  }
  if ($node->get('field_brebo_calc_code')->isEmpty()) {
    $node->set('field_brebo_calc_code', brebo_calculation_next_code());
  }
  if ($node->hasField('field_brebo_price_date') && $node->get('field_brebo_price_date')->isEmpty()) {
    $node->set('field_brebo_price_date', date('Y-m-d', \Drupal::time()->getCurrentTime()));
  }
}

function brebo_calculation_node_insert(NodeInterface $node): void {
  if ($node->bundle() !== 'brebo_calculation') {
    return;
  }
  \Drupal::service('brebo_calculation.draft_initializer')->ensure($node);
}

function brebo_calculation_open_workbench_after_create(array &$form, FormStateInterface $form_state): void {
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }
  $calculation = $formObject->getEntity();
  if (!$calculation instanceof NodeInterface || $calculation->bundle() !== 'brebo_calculation' || $calculation->isNew() || $calculation->id() === NULL) {
    return;
  }
  \Drupal::service('brebo_calculation.draft_initializer')->ensure($calculation);
  $form_state->setRedirect('brebo_calculation.workbench', ['node' => (int) $calculation->id()]);
}

function brebo_calculation_form_brebo_calculation_workbench_form_alter(array &$form, FormStateInterface $form_state): void {
  $calculationId = (int) ($form['calculation_id']['#value'] ?? 0);
  $version = (string) ($form['version']['#value'] ?? '');
  if ($calculationId <= 0 || $version === '') {
    return;
  }

  $record = \Drupal::database()->select('brebo_calculation_version', 'v')
    ->fields('v', ['commercial_method', 'general_cost_pct', 'risk_pct', 'profit_pct', 'single_margin_pct', 'commercial_adjustment'])
    ->condition('calculation_id', $calculationId)
    ->condition('version', $version)
    ->execute()
    ->fetchAssoc();
  if (!$record) {
    return;
  }

  $commercialMethod = (string) $record['commercial_method'];
  $form['#attached']['drupalSettings']['breboCalculation']['commercial'] = [
    'method' => $commercialMethod,
    'generalCostPct' => (float) $record['general_cost_pct'],
    'riskPct' => (float) $record['risk_pct'],
    'profitPct' => (float) $record['profit_pct'],
    'singleMarginPct' => (float) $record['single_margin_pct'],
    'commercialAdjustment' => (float) $record['commercial_adjustment'],
  ];

  $form['workbench']['scenario_compare'] = [
    '#type' => 'details', '#title' => 'Scenariovergelijking', '#open' => FALSE, '#weight' => -8,
    '#attributes' => ['class' => ['brebo-calc-scenarios']],
  ];
  $form['workbench']['scenario_compare']['intro'] = ['#markup' => '<p class="description">Rekenhulp voor Basis, Scherp en Doel. Wijzigt de kostprijs of opgeslagen calculatie niet.</p>'];
  $form['workbench']['scenario_compare']['cards'] = [
    '#markup' => '<div class="brebo-calc-scenario-grid">'
      . '<section class="brebo-calc-scenario" data-scenario="basis"><h3>Basis</h3><div class="brebo-calc-scenario__inputs"></div><dl><dt>Verkoopprijs</dt><dd data-scenario-output="sales">€ 0,00</dd><dt>Brutomarge</dt><dd data-scenario-output="gross">€ 0,00</dd><dt>Brutomarge %</dt><dd data-scenario-output="gross-pct">0,0%</dd></dl></section>'
      . '<section class="brebo-calc-scenario" data-scenario="scherp"><h3>Scherp</h3><div class="brebo-calc-scenario__inputs"></div><dl><dt>Verkoopprijs</dt><dd data-scenario-output="sales">€ 0,00</dd><dt>Brutomarge</dt><dd data-scenario-output="gross">€ 0,00</dd><dt>Brutomarge %</dt><dd data-scenario-output="gross-pct">0,0%</dd></dl></section>'
      . '<section class="brebo-calc-scenario" data-scenario="doel"><h3>Doel</h3><div class="brebo-calc-scenario__inputs"></div><dl><dt>Verkoopprijs</dt><dd data-scenario-output="sales">€ 0,00</dd><dt>Brutomarge</dt><dd data-scenario-output="gross">€ 0,00</dd><dt>Brutomarge %</dt><dd data-scenario-output="gross-pct">0,0%</dd></dl></section>'
      . '</div>',
  ];

  if (!isset($form['workbench']['grid']['#header']) || !is_array($form['workbench']['grid']['#header'])) {
    return;
  }

  $marginHeader = $commercialMethod === 'single_margin' ? 'Marge' : 'Winst';
  array_splice($form['workbench']['grid']['#header'], -1, 0, ['AK', 'Risico', $marginHeader, 'Verkoopprijs']);
  foreach ($form['workbench']['grid'] as $rowKey => &$row) {
    if (!is_string($rowKey) || str_starts_with($rowKey, '#') || !is_array($row)) {
      continue;
    }
    $classes = (array) ($row['#attributes']['class'] ?? []);
    $isStructure = in_array('brebo-calc-workbench__structure', $classes, TRUE);
    $isLine = in_array('brebo-calc-workbench__line', $classes, TRUE);
    if (!$isStructure && !$isLine) {
      continue;
    }
    if ($isStructure) {
      $row['labour'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="labour">€ 0,00</span>'];
      $row['material'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="material">€ 0,00</span>'];
      $row['equipment'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="equipment">€ 0,00</span>'];
      $row['subcontracting'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="subcontracting">€ 0,00</span>'];
      $row['other'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="other">€ 0,00</span>'];
      $row['unit_total'] = ['#markup' => '<span class="brebo-calc-structure-cost" data-cost-kind="direct">€ 0,00</span>'];
      $row['total'] = ['#markup' => '<strong class="brebo-calc-structure-subtotal">€ 0,00</strong>'];
    }
    $commercialCells = [
      'general_cost' => ['#markup' => '<span class="brebo-calc-commercial" data-commercial-kind="general-cost">€ 0,00</span>'],
      'risk' => ['#markup' => '<span class="brebo-calc-commercial" data-commercial-kind="risk">€ 0,00</span>'],
      'margin' => ['#markup' => '<span class="brebo-calc-commercial" data-commercial-kind="margin">€ 0,00</span>'],
      'sales_price' => ['#markup' => '<strong class="brebo-calc-commercial brebo-calc-sales-price" data-commercial-kind="sales-price">€ 0,00</strong>'],
    ];
    $rebuilt = [];
    foreach ($row as $cellKey => $cell) {
      if ($cellKey === 'operations') {
        foreach ($commercialCells as $commercialKey => $commercialCell) {
          $rebuilt[$commercialKey] = $commercialCell;
        }
      }
      $rebuilt[$cellKey] = $cell;
    }
    $row = $rebuilt;
  }
  unset($row);

  $form['workbench']['total']['#markup'] = '<div class="brebo-calc-workbench__total">'
    . '<span><small>Directe kostprijs</small><strong data-total-kind="direct">€ 0,00</strong></span>'
    . '<span><small>AK</small><strong data-total-kind="general-cost">€ 0,00</strong></span>'
    . '<span><small>Risico</small><strong data-total-kind="risk">€ 0,00</strong></span>'
    . '<span><small>' . ($commercialMethod === 'single_margin' ? 'Marge' : 'Winst') . '</small><strong data-total-kind="margin">€ 0,00</strong></span>'
    . '<span><small>Correctie</small><strong data-total-kind="adjustment">€ 0,00</strong></span>'
    . '<span class="is-sales"><small>Verkoopprijs</small><strong data-total-kind="sales-price">€ 0,00</strong></span>'
    . '</div>';
}
