  $money = ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => FALSE];
  return [
    'brebo_calculation_recipe' => [
      'description' => 'Stable recipe identities in the reusable BREBO calculation library.',
      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'recipe_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE], 'scope' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'brebo'], 'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'active'], 'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'created_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'changed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'changed_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE]],
      'primary key' => ['id'], 'unique keys' => ['recipe_key' => ['recipe_key']], 'indexes' => ['scope_status' => ['scope', 'status']],
    ],
    'brebo_calculation_recipe_version' => [
      'description' => 'Immutable published versions of reusable recipes.',
      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'recipe_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'version' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE], 'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'draft'], 'description' => ['type' => 'text', 'not null' => FALSE], 'base_unit' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'st'], 'content_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE], 'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'created_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'published' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'published_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE]],
      'primary key' => ['id'], 'unique keys' => ['recipe_version' => ['recipe_id', 'version']], 'indexes' => ['recipe_status' => ['recipe_id', 'status']],
    ],
    'brebo_calculation_recipe_parameter' => [
      'description' => 'Typed parameters available to formulas in a recipe version.',
      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'recipe_version_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'parameter_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'label' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE], 'data_type' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'decimal'], 'unit' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE], 'default_value' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE], 'formula' => ['type' => 'text', 'not null' => FALSE], 'sort_order' => ['type' => 'int', 'not null' => TRUE, 'default' => 0], 'required' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0]],
      'primary key' => ['id'], 'unique keys' => ['version_parameter' => ['recipe_version_id', 'parameter_key']], 'indexes' => ['version_sort' => ['recipe_version_id', 'sort_order']],
    ],
    'brebo_calculation_recipe_line' => [
      'description' => 'Component lines and formulas in a reusable recipe version.',
      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'recipe_version_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'line_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'line_type' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'material'], 'description' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE], 'unit' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE], 'quantity_formula' => ['type' => 'text', 'not null' => FALSE], 'waste_pct' => ['type' => 'numeric', 'precision' => 10, 'scale' => 4, 'not null' => TRUE, 'default' => 0], 'material_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE], 'price_source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE], 'unit_cost' => $money, 'sort_order' => ['type' => 'int', 'not null' => TRUE, 'default' => 0], 'metadata' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE]],
      'primary key' => ['id'], 'unique keys' => ['version_line' => ['recipe_version_id', 'line_key']], 'indexes' => ['version_sort' => ['recipe_version_id', 'sort_order'], 'material_ref' => ['material_ref']],
    ],
    'brebo_calculation_recipe_instance' => [
