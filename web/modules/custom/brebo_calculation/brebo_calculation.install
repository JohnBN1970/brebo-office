      'primary key' => ['id'], 'unique keys' => ['instance_parameter' => ['recipe_instance_id', 'parameter_key']],
    ],
    'brebo_calculation_recipe_instance_line' => [
      'description' => 'Editable snapshot lines generated from a recipe inside a calculation.',
      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'recipe_instance_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'source_recipe_line_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'line_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'line_type' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE], 'description' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE], 'unit' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE], 'quantity_formula' => ['type' => 'text', 'not null' => FALSE], 'calculated_quantity' => ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => TRUE, 'default' => 0], 'manual_quantity' => ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => FALSE], 'waste_pct' => ['type' => 'numeric', 'precision' => 10, 'scale' => 4, 'not null' => TRUE, 'default' => 0], 'material_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE], 'price_source_ref' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE], 'unit_cost' => $money, 'sort_order' => ['type' => 'int', 'not null' => TRUE, 'default' => 0], 'is_custom' => ['type' => 'int', 'size' => 'tiny', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0]],
