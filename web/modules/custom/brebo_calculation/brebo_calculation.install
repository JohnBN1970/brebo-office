      'fields' => ['id' => ['type' => 'serial', 'not null' => TRUE], 'calculation_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'calculation_version' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE], 'paragraph_key' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'recipe_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'recipe_version_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE], 'name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE], 'quantity' => ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => TRUE, 'default' => 1], 'unit' => ['type' => 'varchar', 'length' => 32, 'not null' => FALSE], 'sort_order' => ['type' => 'int', 'not null' => TRUE, 'default' => 0], 'snapshot_payload' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE], 'snapshot_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE], 'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE], 'created_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE]],
      'primary key' => ['id'], 'indexes' => ['calculation_paragraph' => ['calculation_id', 'calculation_version', 'paragraph_key', 'sort_order'], 'recipe_version' => ['recipe_version_id']],
