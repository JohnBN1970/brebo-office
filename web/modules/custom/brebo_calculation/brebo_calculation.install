  ];
}


/** Auditable calibration observations for the canonical kozijn price engine. */
function brebo_calculation_kozijn_price_observation_schema(): array {
  return [
    'description' => 'Approved supplier price observations used to calibrate the kozijn engine.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'system' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'brand' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'width_mm' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'height_mm' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'fields_count' => ['type' => 'int', 'size' => 'small', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 1],
      'configuration_type' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'glass_spec' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
      'colour' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'joint_type' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'rebate_type' => ['type' => 'varchar', 'length' => 64, 'not null' => FALSE],
      'supplier_gross' => ['type' => 'numeric', 'precision' => 18, 'scale' => 4, 'not null' => TRUE],
      'currency' => ['type' => 'varchar', 'length' => 3, 'not null' => TRUE, 'default' => 'EUR'],
      'source_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'controlled_quote'],
      'source_ref' => ['type' => 'varchar', 'length' => 512, 'not null' => FALSE],
      'observed_at' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'status' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'review'],
      'metadata' => ['type' => 'text', 'size' => 'big', 'not null' => FALSE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'created_by' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'calibration_scope' => ['system', 'configuration_type', 'fields_count', 'status'],
      'dimensions' => ['width_mm', 'height_mm'],
      'observed_at' => ['observed_at'],
    ],
  ];
}

