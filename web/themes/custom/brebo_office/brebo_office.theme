<?php

declare(strict_types=1);

/**
 * @file
 * Theme preprocess adjustments for the BREBO Office shell.
 */

/**
 * Implements hook_preprocess_page().
 */
function brebo_office_preprocess_page(array &$variables): void {
  $account = \Drupal::currentUser();
  if ($account->isAuthenticated()) {
    $stored_mode = \Drupal::service('user.data')->get('brebo_office_core', (int) $account->id(), 'appearance_mode');
    $mode = in_array($stored_mode, ['day', 'night', 'system'], TRUE) ? $stored_mode : 'system';

    $variables['page']['#attached']['drupalSettings']['breboOfficeAppearance'] = [
      'userId' => (int) $account->id(),
      'defaultMode' => $mode,
      'persistUrl' => \Drupal\Core\Url::fromRoute('brebo_office_core.appearance_preference')->toString(),
    ];
  }

  if ($account->isAuthenticated() && \Drupal::routeMatch()->getRouteName() === 'brebo_office_core.dashboard') {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $bundles = [
      'projects' => 'brebo_project',
      'buildings' => 'brebo_building',
      'dwellings' => 'brebo_dwelling',
      'positions' => 'brebo_product_position',
      'organizations' => 'brebo_organization',
      'contacts' => 'brebo_contact',
      'calculations' => 'brebo_calculation',
      'work_budgets' => 'brebo_work_budget',
      'rfqs' => 'brebo_rfq',
      'supplier_quotes' => 'brebo_supplier_quote',
      'verifications' => 'brebo_verification',
      'deviations' => 'brebo_deviation',
    ];

    $metrics = [];
    foreach ($bundles as $key => $bundle) {
      $metrics[$key] = (int) $storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', $bundle)
        ->count()
        ->execute();
    }

    $recent_project_ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'brebo_project')
      ->sort('changed', 'DESC')
      ->range(0, 5)
      ->execute();

    $recent_projects = [];
    foreach ($storage->loadMultiple($recent_project_ids) as $project) {
      if (!$project instanceof \Drupal\node\NodeInterface) {
        continue;
      }
      $recent_projects[] = [
        'id' => (int) $project->id(),
        'title' => (string) $project->label(),
        'changed' => \Drupal::service('date.formatter')->format($project->getChangedTime(), 'short'),
      ];
    }

    $signal_sources = [
      'projects' => ['bundle' => 'brebo_project', 'field' => 'field_brebo_status'],
      'work_budgets' => ['bundle' => 'brebo_work_budget', 'field' => 'field_brebo_budget_status'],
      'rfqs' => ['bundle' => 'brebo_rfq', 'field' => 'field_brebo_rfq_status'],
      'supplier_quotes' => ['bundle' => 'brebo_supplier_quote', 'field' => 'field_brebo_quote_status'],
      'deviations' => ['bundle' => 'brebo_deviation', 'field' => 'field_brebo_deviation_status'],
    ];

    $signal_distributions = [];
    foreach ($signal_sources as $key => $source) {
      $ids = $storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', $source['bundle'])
        ->exists($source['field'])
        ->execute();

      $distribution = [];
      foreach ($storage->loadMultiple($ids) as $entity) {
        if (!$entity instanceof \Drupal\node\NodeInterface || !$entity->hasField($source['field'])) {
          continue;
        }
        $value = trim((string) $entity->get($source['field'])->value);
        if ($value === '') {
          continue;
        }
        $distribution[$value] = ($distribution[$value] ?? 0) + 1;
      }

      if ($distribution) {
        ksort($distribution, SORT_NATURAL | SORT_FLAG_CASE);
        $signal_distributions[$key] = [];
        foreach ($distribution as $value => $count) {
          $signal_distributions[$key][] = [
            'value' => (string) $value,
            'label' => (string) $value,
            'count' => (int) $count,
          ];
        }
      }
    }

    $inzet = [
      'available' => FALSE,
      'active' => 0,
      'registrations' => 0,
      'severity' => [],
      'url' => NULL,
      'management' => [
        'visible' => FALSE,
        'url' => NULL,
        'today_planned_hours' => 0.0,
        'today_clocked_hours' => 0.0,
        'today_deviations' => 0,
        'today_pending' => 0,
        'unclocked_7d' => 0,
      ],
    ];

    if (\Drupal::moduleHandler()->moduleExists('brebo_inzet')) {
      $definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'brebo_clock_registration');
      if (isset($definitions['field_brebo_clock_in'], $definitions['field_brebo_clock_out'])) {
        $clock_ids = $storage->getQuery()
          ->accessCheck(TRUE)
          ->condition('type', 'brebo_clock_registration')
          ->exists('field_brebo_clock_in')
          ->sort('field_brebo_clock_in', 'DESC')
          ->execute();

        $severity = [];
        foreach ($storage->loadMultiple($clock_ids) as $registration) {
          if (!$registration instanceof \Drupal\node\NodeInterface) {
            continue;
          }
          $inzet['registrations']++;
          $clock_out = $registration->hasField('field_brebo_clock_out')
            ? trim((string) $registration->get('field_brebo_clock_out')->value)
            : '';
          if ($clock_out === '') {
            $inzet['active']++;
          }
          if ($registration->hasField('field_brebo_clock_severity')) {
            $value = trim((string) $registration->get('field_brebo_clock_severity')->value);
            if ($value !== '') {
              $severity[$value] = ($severity[$value] ?? 0) + 1;
            }
          }
        }

        if ($severity) {
          ksort($severity, SORT_NATURAL | SORT_FLAG_CASE);
          foreach ($severity as $value => $count) {
            $inzet['severity'][] = [
              'label' => (string) $value,
              'count' => (int) $count,
            ];
          }
        }

        $inzet['available'] = TRUE;
        $inzet['url'] = \Drupal\Core\Url::fromRoute('brebo_inzet.app')->toString();
      }

      if ($account->hasPermission('edit any brebo_personnel_assignment content')
        && \Drupal::hasService('brebo_inzet.personnel_assignment_comparison')) {
        $timezone_name = (string) (\Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get());
        $timezone = new \DateTimeZone($timezone_name ?: 'Europe/Brussels');
        $now = new \DateTimeImmutable('now', $timezone);
        $today = $now->format('Y-m-d');
        $seven_days_ago = $now->modify('-7 days')->format('Y-m-d');
        $comparison = \Drupal::service('brebo_inzet.personnel_assignment_comparison');

        $today_ids = $storage->getQuery()
          ->accessCheck(TRUE)
          ->condition('type', 'brebo_personnel_assignment')
          ->condition('field_brebo_plan_date', $today)
          ->condition('field_brebo_assignment_status', 'cancelled', '<>')
          ->execute();

        foreach ($storage->loadMultiple($today_ids) as $assignment) {
          if (!$assignment instanceof \Drupal\node\NodeInterface || !$assignment->access('view')) {
            continue;
          }
          $result = $comparison->compare($assignment);
          $inzet['management']['today_planned_hours'] += (float) $result['planned_hours'];
          $inzet['management']['today_clocked_hours'] += (float) $result['clocked_hours'];
          if (in_array($result['state'], ['under', 'over'], TRUE)) {
            $inzet['management']['today_deviations']++;
          }
          if ($result['state'] === 'today_pending') {
            $inzet['management']['today_pending']++;
          }
        }

        $recent_ids = $storage->getQuery()
          ->accessCheck(TRUE)
          ->condition('type', 'brebo_personnel_assignment')
          ->condition('field_brebo_plan_date', $seven_days_ago, '>=')
          ->condition('field_brebo_plan_date', $today, '<')
          ->condition('field_brebo_assignment_status', 'cancelled', '<>')
          ->execute();

        foreach ($storage->loadMultiple($recent_ids) as $assignment) {
          if (!$assignment instanceof \Drupal\node\NodeInterface || !$assignment->access('view')) {
            continue;
          }
          $result = $comparison->compare($assignment);
          if ($result['state'] === 'unclocked') {
            $inzet['management']['unclocked_7d']++;
          }
        }

        $inzet['management']['today_planned_hours'] = round($inzet['management']['today_planned_hours'], 2);
        $inzet['management']['today_clocked_hours'] = round($inzet['management']['today_clocked_hours'], 2);
        $inzet['management']['visible'] = TRUE;
        $inzet['management']['url'] = \Drupal\Core\Url::fromRoute('brebo_inzet.personnel_planning')->toString();
      }
    }

    $finance = [
      'visible' => FALSE,
      'url' => NULL,
      'project_count' => 0,
      'billable_not_invoiced_ex_vat' => 0.0,
      'invoiced_ex_vat' => 0.0,
      'committed_ex_vat' => 0.0,
      'overdue_invoice_count' => 0,
      'pending_payment_releases' => 0,
      'forecast_stale_count' => 0,
      'decision_count' => 0,
      'decision_now' => 0,
      'decision_today' => 0,
    ];
    if (\Drupal::moduleHandler()->moduleExists('brebo_finance')
      && $account->hasPermission('access brebo finance')
      && \Drupal::hasService('brebo_finance.financial_command_center')) {
      $financial_command_center = \Drupal::service('brebo_finance.financial_command_center')->build($account);
      $portfolio = $financial_command_center['portfolio'] ?? [];
      $decisions = $financial_command_center['decisions'] ?? [];
      $finance = [
        'visible' => TRUE,
        'url' => \Drupal\Core\Url::fromRoute('brebo_finance.command_center_page')->toString(),
        'project_count' => (int) ($portfolio['project_count'] ?? 0),
        'billable_not_invoiced_ex_vat' => (float) ($portfolio['billable_not_invoiced_ex_vat'] ?? 0),
        'invoiced_ex_vat' => (float) ($portfolio['invoiced_ex_vat'] ?? 0),
        'committed_ex_vat' => (float) ($portfolio['committed_ex_vat'] ?? 0),
        'overdue_invoice_count' => (int) ($portfolio['overdue_invoice_count'] ?? 0),
        'pending_payment_releases' => (int) ($portfolio['pending_payment_releases'] ?? 0),
        'forecast_stale_count' => (int) ($portfolio['forecast_stale_count'] ?? 0),
        'decision_count' => (int) ($decisions['count'] ?? 0),
        'decision_now' => (int) ($decisions['now'] ?? 0),
        'decision_today' => (int) ($decisions['today'] ?? 0),
      ];
    }

    $regie = [
      'url' => \Drupal\Core\Url::fromRoute('brebo_office_core.regie_actions')->toString(),
      'open' => 0,
      'mine' => 0,
      'overdue' => 0,
      'blocked' => 0,
      'unassigned' => 0,
    ];
    $route_ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'brebo_route_item')
      ->condition('field_brebo_route_applicable', 1)
      ->condition('field_brebo_route_status', ['Gereed', 'N.V.T.', 'Vervallen'], 'NOT IN')
      ->sort('field_brebo_route_due', 'ASC')
      ->sort('field_brebo_route_sequence', 'ASC')
      ->execute();
    $regie['open'] = count($route_ids);
    $today = date('Y-m-d');
    foreach ($storage->loadMultiple($route_ids) as $item) {
      if (!$item instanceof \Drupal\node\NodeInterface || !$item->access('view')) {
        continue;
      }
      $owner = $item->get('field_brebo_route_owner')->entity;
      $due = trim((string) ($item->get('field_brebo_route_due')->value ?? ''));
      $status = trim((string) ($item->get('field_brebo_route_status')->value ?? ''));
      if ($owner && (int) $owner->id() === (int) $account->id()) {
        $regie['mine']++;
      }
      if ($due !== '' && $due < $today) {
        $regie['overdue']++;
      }
      if ($status === 'Geblokkeerd') {
        $regie['blocked']++;
      }
      if (!$owner) {
        $regie['unassigned']++;
      }
    }

    $variables['brebo_dashboard'] = [
      'metrics' => $metrics,
      'recent_projects' => $recent_projects,
      'signals' => $signal_distributions,
      'inzet' => $inzet,
      'finance' => $finance,
      'regie' => $regie,
    ];

    // Dashboard aggregates and recent-project labels depend on the viewer and
    // formatted timestamps depend on the active timezone. Attach these cache
    // contexts to the page render array so Dynamic Page Cache varies safely.
    $variables['page']['#cache']['contexts'] = array_values(array_unique(array_merge(
      $variables['page']['#cache']['contexts'] ?? [],
      ['user', 'timezone']
    )));
    $variables['page']['#cache']['tags'] = array_values(array_unique(array_merge(
      $variables['page']['#cache']['tags'] ?? [],
      [
        'node_list:brebo_personnel_assignment',
        'node_list:brebo_clock_registration',
        'node_list:brebo_route_item',
        'node_list:brebo_project',
      ]
    )));
    $variables['page']['#cache']['max-age'] = $finance['visible'] ? 0 : 60;
  }

  if (\Drupal::routeMatch()->getRouteName() !== 'brebo_office_core.project_dashboard') {
    return;
  }

  unset($variables['brebo_project_context_cockpit'], $variables['brebo_project_context_tabs']);
}
