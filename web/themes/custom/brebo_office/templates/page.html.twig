{% set route = app.request.attributes.get('_route')|default('') %}
<div class="brebo-shell{{ logged_in ? ' brebo-shell--authenticated' : ' brebo-shell--guest' }}">
  {% include '@brebo_office/includes/brebo-header.html.twig' %}

  {% if page.highlighted %}
    <div class="brebo-highlighted"><div class="brebo-highlighted__inner">{{ page.highlighted }}</div></div>
  {% endif %}

  {% if logged_in %}
    <div class="brebo-app-layout">
      {% include '@brebo_office/includes/brebo-office-sidebar.html.twig' %}
      <div class="brebo-app-layout__content">
        <main class="brebo-main{{ page.sidebar ? '' : ' brebo-main--full' }}">
          {% if page.sidebar %}
            <aside class="brebo-sidebar">{{ page.sidebar }}</aside>
          {% endif %}
          <section class="brebo-content">
            {% if brebo_project_context_cockpit %}
              <h1 class="brebo-project-context__title">{{ brebo_project_context_cockpit.summary.title['#markup']|striptags }}</h1>
              {{ brebo_project_context_cockpit }}
            {% endif %}
            {% if brebo_project_context_tabs %}
              {{ brebo_project_context_tabs }}
            {% endif %}

            {% if not (route starts with 'brebo_help.') %}
              {% set help_query = '' %}
              {% if route == 'brebo_office_core.dashboard' %}
                {% set help_query = 'office' %}
              {% elseif route starts with 'brebo_project_cockpit.' or route starts with 'brebo_office_core.project' %}
                {% set help_query = 'project' %}
              {% elseif route starts with 'brebo_calculation.' or route == 'brebo_office_core.calculations' %}
                {% set help_query = 'calculatie' %}
              {% elseif route == 'brebo_office_core.crm' %}
                {% set help_query = 'relatie' %}
              {% elseif route starts with 'brebo_mail_intake.' %}
                {% set help_query = 'mail' %}
              {% elseif route starts with 'brebo_finance.' %}
                {% set help_query = 'financieel' %}
              {% elseif route == 'brebo_office_core.quality_dashboard' %}
                {% set help_query = 'kwaliteit' %}
              {% elseif route starts with 'brebo_inzet.' %}
                {% set help_query = 'planning' %}
              {% elseif route starts with 'brebo_glass.' %}
                {% set help_query = 'glas' %}
              {% elseif route starts with 'brebo_office_core.building' or route == 'brebo_office_core.dwellings' or route == 'brebo_office_core.positions' %}
                {% set help_query = 'gebouw' %}
              {% endif %}

              {% if help_query %}
                <div class="brebo-screen-help">
                  <a href="{{ path('brebo_help.search', {}, {'query': {'q': help_query}}) }}">Hulp bij dit scherm</a>
                </div>
              {% endif %}
            {% endif %}

            {{ page.content }}
          </section>
        </main>
      </div>
    </div>
  {% else %}
    <main class="brebo-main brebo-main--full">
      <section class="brebo-content">{{ page.content }}</section>
    </main>
  {% endif %}

  {% if page.footer %}
    <footer class="brebo-footer">{{ page.footer }}</footer>
  {% endif %}
</div>
