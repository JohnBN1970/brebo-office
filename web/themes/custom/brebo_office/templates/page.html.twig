<div class="brebo-shell{{ logged_in ? ' brebo-shell--authenticated' : ' brebo-shell--guest' }}">
  {% include '@brebo_office/includes/brebo-header.html.twig' %}

  {% if page.highlighted %}
    <div class="brebo-highlighted"><div class="brebo-highlighted__inner">{{ page.highlighted }}</div></div>
  {% endif %}

  <main class="brebo-main{{ page.sidebar ? '' : ' brebo-main--full' }}">
    {% if page.sidebar %}
      <aside class="brebo-sidebar">{{ page.sidebar }}</aside>
    {% endif %}
    <section class="brebo-content">
      {{ page.content }}
    </section>
  </main>

  {% if page.footer %}
    <footer class="brebo-footer">{{ page.footer }}</footer>
  {% endif %}
</div>
