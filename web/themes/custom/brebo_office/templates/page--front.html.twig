<div class="brebo-shell{{ logged_in ? ' brebo-shell--authenticated' : ' brebo-shell--guest' }}">
  {% include '@brebo_office/includes/brebo-header.html.twig' %}

  {% if page.highlighted %}
    <div class="brebo-highlighted"><div class="brebo-highlighted__inner">{{ page.highlighted }}</div></div>
  {% endif %}

  {% if logged_in %}
    <div class="brebo-app-layout">
      {% include '@brebo_office/includes/brebo-office-sidebar.html.twig' %}
      <div class="brebo-app-layout__content">
        <main class="brebo-dashboard brebo-page-shell">
          <header class="brebo-page-header">
            <div class="brebo-page-header__main">
              <p class="brebo-page-header__eyebrow">BREBO OFFICE</p>
              <h1 class="brebo-page-header__title">Overzicht</h1>
              <p class="brebo-page-header__description">Actuele systeemingang voor gebouwen, projecten, woningen en technische productposities.</p>
            </div>
            <div class="brebo-page-header__actions">
              <a class="button brebo-button--primary" href="{{ path('node.add', {'node_type': 'brebo_project'}) }}">Nieuw project</a>
            </div>
          </header>

          <section class="brebo-dashboard-kpis brebo-content-grid" aria-label="Objectoverzicht">
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.buildings') }}">
              <span class="brebo-dashboard-kpi__label">Gebouwen</span>
              <strong>{{ brebo_counts.buildings|default(0) }}</strong>
              <small>Permanent gebouw- en onderhoudsdossier</small>
              <span class="brebo-dashboard-kpi__link">Open gebouwen</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.projects') }}">
              <span class="brebo-dashboard-kpi__label">Projecten</span>
              <strong>{{ brebo_counts.projects|default(0) }}</strong>
              <small>Tijdelijke opdrachten, scopes en projectregie</small>
              <span class="brebo-dashboard-kpi__link">Open projecten</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.dwellings') }}">
              <span class="brebo-dashboard-kpi__label">Woningen</span>
              <strong>{{ brebo_counts.dwellings|default(0) }}</strong>
              <small>Zelfstandige objecten binnen het gebouwmodel</small>
              <span class="brebo-dashboard-kpi__link">Open woningen</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.positions') }}">
              <span class="brebo-dashboard-kpi__label">Productposities</span>
              <strong>{{ brebo_counts.positions|default(0) }}</strong>
              <small>Technische onderdelen met controle en bewijs</small>
              <span class="brebo-dashboard-kpi__link">Open posities</span>
            </a>
          </section>

          <section class="brebo-content-grid" aria-label="Systeemoverzicht">
            <article class="brebo-dashboard-panel brebo-span-8">
              <div class="brebo-section-heading">
                <div>
                  <p class="brebo-page-header__eyebrow">BESTURINGSKETEN</p>
                  <h2>Van opdracht naar aantoonbaar resultaat</h2>
                </div>
                <span class="brebo-status brebo-status--ready">Operationeel</span>
              </div>
              <ol class="brebo-flow">
                <li><span>1</span><div><strong>Projectkader</strong><small>Soort, rol, geld en inkoop</small></div></li>
                <li><span>2</span><div><strong>Projectroute</strong><small>Automatische stappen en producten</small></div></li>
                <li><span>3</span><div><strong>Regie-acties</strong><small>Eigenaar, termijn en blokkering</small></div></li>
                <li><span>4</span><div><strong>Bewijs</strong><small>Controle, besluit en vrijgave</small></div></li>
              </ol>
            </article>

            <aside class="brebo-dashboard-panel brebo-span-4">
              <div class="brebo-section-heading">
                <div>
                  <p class="brebo-page-header__eyebrow">SYSTEEMSTATUS</p>
                  <h2>Digitale regie</h2>
                </div>
              </div>
              <ul class="brebo-checklist">
                <li class="is-done"><span aria-hidden="true">✓</span><div><strong>Projectbesturing</strong><small>Vier onafhankelijke assen</small></div></li>
                <li class="is-done"><span aria-hidden="true">✓</span><div><strong>Automatische routes</strong><small>Passend bij de projectsoort</small></div></li>
                <li class="is-done"><span aria-hidden="true">✓</span><div><strong>Centrale actielijst</strong><small>Termijnen, blokkeringen en eigenaarschap</small></div></li>
                <li class="is-done"><span aria-hidden="true">✓</span><div><strong>Audit en bewijs</strong><small>N.V.T., afwijkingen en besluitvorming</small></div></li>
              </ul>
            </aside>
          </section>
        </main>
      </div>
    </div>
  {% else %}
    <main class="brebo-main brebo-main--full">
      <section class="brebo-content">
        <div class="brebo-login__intro">
          <p class="brebo-eyebrow">VEILIGE WERKOMGEVING</p>
          <h1>Welkom bij BREBO Office</h1>
          <p>Log in om projecten, acties en kwaliteitscontroles te beheren.</p>
        </div>
        <section class="brebo-card brebo-login__form" aria-label="Inloggen">{{ page.content }}</section>
      </section>
    </main>
  {% endif %}

  {% if page.footer %}<footer class="brebo-footer">{{ page.footer }}</footer>{% endif %}
</div>
