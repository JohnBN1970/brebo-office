<div class="brebo-shell{{ logged_in ? ' brebo-shell--authenticated' : ' brebo-shell--guest' }}">
  {% include '@brebo_office/includes/brebo-header.html.twig' %}

  {% if page.highlighted %}
    <div class="brebo-highlighted"><div class="brebo-highlighted__inner">{{ page.highlighted }}</div></div>
  {% endif %}

  {% if logged_in %}
    {% set m = brebo_dashboard.metrics|default({}) %}
    {% set s = brebo_dashboard.signals|default({}) %}
    {% set i = brebo_dashboard.inzet|default({}) %}
    {% set f = brebo_dashboard.finance|default({}) %}
    {% set r = brebo_dashboard.regie|default({}) %}
    <div class="brebo-app-layout">
      {% include '@brebo_office/includes/brebo-office-sidebar.html.twig' %}
      <div class="brebo-app-layout__content">
        <main class="brebo-dashboard brebo-page-shell">
          <header class="brebo-page-header">
            <div class="brebo-page-header__main">
              <p class="brebo-page-header__eyebrow">BREBO OFFICE</p>
              <h1 class="brebo-page-header__title">Overzicht</h1>
              <p class="brebo-page-header__description">Bedrijfsbrede cockpit voor projecten, commercie, werkvoorraad, kwaliteit, inzet en het gebouwmodel.</p>
            </div>
            <div class="brebo-page-header__actions">
              <a class="button" href="{{ path('brebo_office_core.funnel') }}">Funnel</a>
              <a class="button brebo-button--primary" href="{{ path('node.add', {'node_type': 'brebo_project'}) }}">Nieuw project</a>
            </div>
          </header>

          <section class="brebo-dashboard-kpis brebo-content-grid" aria-label="Kerncijfers">
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.projects') }}">
              <span class="brebo-dashboard-kpi__label">Projecten</span>
              <strong>{{ m.projects|default(brebo_counts.projects|default(0)) }}</strong>
              <small>Alle geregistreerde projecten</small>
              <span class="brebo-dashboard-kpi__link">Projectportefeuille</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.calculations') }}">
              <span class="brebo-dashboard-kpi__label">Calculaties</span>
              <strong>{{ m.calculations|default(0) }}</strong>
              <small>Commerciële en projectcalculaties</small>
              <span class="brebo-dashboard-kpi__link">Calculaties openen</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.work_budgets') }}">
              <span class="brebo-dashboard-kpi__label">Werkbegrotingen</span>
              <strong>{{ m.work_budgets|default(0) }}</strong>
              <small>Financiële projectmeetlatten</small>
              <span class="brebo-dashboard-kpi__link">Werkbegrotingen</span>
            </a>
            <a class="brebo-dashboard-kpi brebo-span-3" href="{{ path('brebo_office_core.deviations') }}">
              <span class="brebo-dashboard-kpi__label">Afwijkingen</span>
              <strong>{{ m.deviations|default(0) }}</strong>
              <small>Geregistreerde kwaliteitsafwijkingen</small>
              <span class="brebo-dashboard-kpi__link">Kwaliteit bewaken</span>
            </a>
          </section>

          <section class="brebo-dashboard-panel" aria-label="Regie en aandacht">
            <div class="brebo-section-heading">
              <div><p class="brebo-page-header__eyebrow">REGIE & AANDACHT</p><h2>Wat vraagt opvolging?</h2></div>
              <a href="{{ r.url }}">Open regie-acties</a>
            </div>
            <div class="brebo-dashboard-signal-grid">
              <div class="brebo-dashboard-signal-group"><strong>Werkvoorraad</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Open regie-acties</span><b>{{ r.open|default(0) }}</b></span><span class="brebo-dashboard-signal-pill"><span>Mijn acties</span><b>{{ r.mine|default(0) }}</b></span></div></div>
              <div class="brebo-dashboard-signal-group"><strong>Termijn</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Te laat</span><b>{{ r.overdue|default(0) }}</b></span></div></div>
              <div class="brebo-dashboard-signal-group"><strong>Blokkering</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Geblokkeerd</span><b>{{ r.blocked|default(0) }}</b></span></div></div>
              <div class="brebo-dashboard-signal-group"><strong>Eigenaarschap</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Niet toegewezen</span><b>{{ r.unassigned|default(0) }}</b></span></div></div>
            </div>
          </section>

          {% if f.visible|default(false) %}
            <section class="brebo-dashboard-panel" aria-label="Financieel management">
              <div class="brebo-section-heading">
                <div><p class="brebo-page-header__eyebrow">FINANCIEEL MANAGEMENT</p><h2>Portfolio & beslissingen</h2></div>
                <a href="{{ f.url }}">Open Finance</a>
              </div>
              <div class="brebo-dashboard-signal-grid">
                <div class="brebo-dashboard-signal-group"><strong>Facturatie</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Factureerbaar, niet gefactureerd</span><b>€ {{ f.billable_not_invoiced_ex_vat|number_format(2, ',', '.') }}</b></span><span class="brebo-dashboard-signal-pill"><span>Gefactureerd excl. btw</span><b>€ {{ f.invoiced_ex_vat|number_format(2, ',', '.') }}</b></span></div></div>
                <div class="brebo-dashboard-signal-group"><strong>Inkoop & betaling</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Gecommitteerd excl. btw</span><b>€ {{ f.committed_ex_vat|number_format(2, ',', '.') }}</b></span><span class="brebo-dashboard-signal-pill"><span>Betaalvrijgaven open</span><b>{{ f.pending_payment_releases }}</b></span></div></div>
                <div class="brebo-dashboard-signal-group"><strong>Bewaking</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Achterstallige facturen</span><b>{{ f.overdue_invoice_count }}</b></span><span class="brebo-dashboard-signal-pill"><span>Verouderde prognoses</span><b>{{ f.forecast_stale_count }}</b></span></div></div>
                <div class="brebo-dashboard-signal-group"><strong>Besluiten</strong><div class="brebo-dashboard-signal-pills"><span class="brebo-dashboard-signal-pill"><span>Open</span><b>{{ f.decision_count }}</b></span><span class="brebo-dashboard-signal-pill"><span>Nu</span><b>{{ f.decision_now }}</b></span><span class="brebo-dashboard-signal-pill"><span>Vandaag</span><b>{{ f.decision_today }}</b></span></div></div>
              </div>
            </section>
          {% endif %}

          {% if s %}
            <section class="brebo-dashboard-panel" aria-label="Managementsignalen">
              <div class="brebo-section-heading">
                <div><p class="brebo-page-header__eyebrow">MANAGEMENTSIGNALEN</p><h2>Actuele statusverdeling</h2></div>
                <span class="brebo-dashboard-signal-note">Live uit Office-data</span>
              </div>
              <div class="brebo-dashboard-signal-grid">
                {% set signal_labels = {
                  'projects': 'Projecten',
                  'work_budgets': 'Werkbegrotingen',
                  'rfqs': 'Prijsaanvragen',
                  'supplier_quotes': 'Leveranciersoffertes',
                  'deviations': 'Afwijkingen'
                } %}
                {% for key, distribution in s %}
                  <div class="brebo-dashboard-signal-group">
                    <strong>{{ signal_labels[key]|default(key) }}</strong>
                    <div class="brebo-dashboard-signal-pills">
                      {% for item in distribution %}
                        <span class="brebo-dashboard-signal-pill"><span>{{ item.label }}</span><b>{{ item.count }}</b></span>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </section>
          {% endif %}

          <section class="brebo-content-grid" aria-label="Bedrijfsinformatie">
            <article class="brebo-dashboard-panel brebo-span-8">
              <div class="brebo-section-heading">
                <div><p class="brebo-page-header__eyebrow">RECENT</p><h2>Laatste projecten</h2></div>
                <a href="{{ path('brebo_office_core.projects') }}">Alle projecten</a>
              </div>
              {% if brebo_dashboard.recent_projects|default([]) %}
                <div class="brebo-dashboard-list">
                  {% for project in brebo_dashboard.recent_projects %}
                    <a class="brebo-dashboard-list__row" href="{{ path('brebo_office_core.project_dashboard', {'node': project.id}) }}">
                      <span><strong>{{ project.title }}</strong><small>Laatst gewijzigd {{ project.changed }}</small></span>
                      <span aria-hidden="true">→</span>
                    </a>
                  {% endfor %}
                </div>
              {% else %}
                <p class="brebo-dashboard-empty">Nog geen projecten beschikbaar.</p>
              {% endif %}
            </article>

            <aside class="brebo-dashboard-panel brebo-span-4">
              <div class="brebo-section-heading"><div><p class="brebo-page-header__eyebrow">COMMERCIËLE BASIS</p><h2>Relaties</h2></div></div>
              <div class="brebo-dashboard-mini-grid">
                <a href="{{ path('brebo_office_core.organizations') }}"><span>Organisaties</span><strong>{{ m.organizations|default(0) }}</strong></a>
                <a href="{{ path('brebo_office_core.contacts') }}"><span>Contacten</span><strong>{{ m.contacts|default(0) }}</strong></a>
              </div>
              <div class="brebo-dashboard-panel__action"><a href="{{ path('brebo_office_core.funnel') }}">Open commerciële funnel</a></div>
            </aside>

            {% if i.available|default(false) %}
              <article class="brebo-dashboard-panel brebo-span-4">
                <div class="brebo-section-heading"><div><p class="brebo-page-header__eyebrow">INZET & TIJD</p><h2>Personeel & inzet</h2></div></div>
                {% if i.management.visible|default(false) %}
                  <div class="brebo-dashboard-mini-grid">
                    <a href="{{ i.management.url }}"><span>Gepland vandaag</span><strong>{{ i.management.today_planned_hours|number_format(2, ',', '.') }} u</strong></a>
                    <a href="{{ i.management.url }}"><span>Geklokt vandaag</span><strong>{{ i.management.today_clocked_hours|number_format(2, ',', '.') }} u</strong></a>
                    <a href="{{ i.management.url }}"><span>Afwijkingen vandaag</span><strong>{{ i.management.today_deviations|default(0) }}</strong></a>
                    <a href="{{ i.management.url }}"><span>Niet geklokt 7 dagen</span><strong>{{ i.management.unclocked_7d|default(0) }}</strong></a>
                  </div>
                  {% if i.management.today_pending|default(0) > 0 %}
                    <div class="brebo-dashboard-signal-pills" style="margin-top: 16px;">
                      <span class="brebo-dashboard-signal-pill"><span>Vandaag nog niet gestart</span><b>{{ i.management.today_pending }}</b></span>
                    </div>
                  {% endif %}
                {% else %}
                  <div class="brebo-dashboard-mini-grid">
                    <a href="{{ i.url }}"><span>Nu aan het werk</span><strong>{{ i.active|default(0) }}</strong></a>
                    <a href="{{ i.url }}"><span>Klokregistraties</span><strong>{{ i.registrations|default(0) }}</strong></a>
                  </div>
                {% endif %}
                {% if i.severity|default([]) %}
                  <div class="brebo-dashboard-signal-pills" style="margin-top: 16px;">
                    {% for item in i.severity %}
                      <span class="brebo-dashboard-signal-pill"><span>{{ item.label }}</span><b>{{ item.count }}</b></span>
                    {% endfor %}
                  </div>
                {% endif %}
                <div class="brebo-dashboard-panel__action"><a href="{{ i.management.visible|default(false) ? i.management.url : i.url }}">Open BREBO Inzet</a></div>
              </article>
            {% endif %}

            <article class="brebo-dashboard-panel brebo-span-4">
              <div class="brebo-section-heading"><div><p class="brebo-page-header__eyebrow">GEBOUWMODEL</p><h2>Objecten</h2></div></div>
              <div class="brebo-dashboard-metric-list">
                <a href="{{ path('brebo_office_core.buildings') }}"><span>Gebouwen</span><strong>{{ m.buildings|default(0) }}</strong></a>
                <a href="{{ path('brebo_office_core.dwellings') }}"><span>Woningen</span><strong>{{ m.dwellings|default(0) }}</strong></a>
                <a href="{{ path('brebo_office_core.positions') }}"><span>Productposities</span><strong>{{ m.positions|default(0) }}</strong></a>
              </div>
            </article>

            <article class="brebo-dashboard-panel brebo-span-4">
              <div class="brebo-section-heading"><div><p class="brebo-page-header__eyebrow">INKOOP</p><h2>Markt & leveranciers</h2></div></div>
              <div class="brebo-dashboard-metric-list">
                <a href="{{ path('brebo_office_core.rfqs') }}"><span>Prijsaanvragen</span><strong>{{ m.rfqs|default(0) }}</strong></a>
                <a href="{{ path('brebo_office_core.supplier_quotes') }}"><span>Leveranciersoffertes</span><strong>{{ m.supplier_quotes|default(0) }}</strong></a>
              </div>
            </article>

            <article class="brebo-dashboard-panel brebo-span-4">
              <div class="brebo-section-heading"><div><p class="brebo-page-header__eyebrow">KWALITEIT</p><h2>Controle & afwijking</h2></div></div>
              <div class="brebo-dashboard-metric-list">
                <a href="{{ path('brebo_office_core.verifications') }}"><span>Controles</span><strong>{{ m.verifications|default(0) }}</strong></a>
                <a href="{{ path('brebo_office_core.deviations') }}"><span>Afwijkingen</span><strong>{{ m.deviations|default(0) }}</strong></a>
              </div>
              <div class="brebo-dashboard-panel__action"><a href="{{ path('brebo_office_core.quality_dashboard') }}">Open kwaliteitsdashboard</a></div>
            </article>
          </section>
        </main>
      </div>
    </div>
  {% else %}
    <main class="brebo-main brebo-main--full">
      <section class="brebo-content">
        <div class="brebo-login__intro">
          <p class="brebo-eyebrow">VEILIGE WERKOMGEVING</p>
          <h1>Welkom bij BREBO Office</h1>
          <p>Log in om projecten, acties en kwaliteitscontroles te beheren.</p>
        </div>
        <section class="brebo-card brebo-login__form" aria-label="Inloggen">{{ page.content }}</section>
      </section>
    </main>
  {% endif %}

  {% if page.footer %}<footer class="brebo-footer">{{ page.footer }}</footer>{% endif %}
</div>
