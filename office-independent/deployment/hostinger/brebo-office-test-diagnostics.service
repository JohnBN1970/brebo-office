[Unit]
Description=BREBO Office-test mail worker diagnostics

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /srv/brebo/office-test/current/deployment/hostinger/collect-mail-worker-diagnostics.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=brebo-office-test/diagnostics
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/brebo-office-test/diagnostics
CapabilityBoundingSet=
TimeoutStartSec=30
