{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brebo-integration-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPLAY_GUARD",
        "class_name": "ReplayGuard"
      },
      {
        "name": "USAGE_GUARD",
        "class_name": "UsageGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReplayGuard"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UsageGuard"]
    }
  ],
  "vars": {
    "API_VERSION": "1.0.0-draft",
    "WORKER_VERSION": "0.1.0",
    "OPENAI_MODEL": "gpt-5-mini",
    "MAX_INPUT_CHARS": "12000",
    "MAX_BODY_BYTES": "32768",
    "MAX_CLOCK_SKEW_SECONDS": "300",
    "REPLAY_TTL_SECONDS": "600",
    "OPENAI_TIMEOUT_MS": "30000",
    "OPENAI_MAX_OUTPUT_TOKENS": "2000",
    "RATE_WINDOW_SECONDS": "60",
    "MAX_ANALYSES_PER_WINDOW": "30",
    "MONTHLY_TOKEN_BUDGET": "2000000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
